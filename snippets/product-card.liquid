{% doc %}
Renders a responsive product card with an editorial image reveal.
@param {product} product - Product to display.
@param {boolean} [show_vendor] - Show the product vendor.
{% enddoc %}
<article class="catalog-card" data-reveal>
  <a href="{{ product.url }}" class="catalog-card__link">
    <div class="catalog-card__media">
      {% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: widths: '320,500,750,1000', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: product.featured_image.alt, class: 'catalog-card__image catalog-card__image--primary' }}{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}
      {% if product.images[1] %}{{ product.images[1] | image_url: width: 1000 | image_tag: widths: '320,500,750,1000', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: product.images[1].alt, class: 'catalog-card__image catalog-card__image--secondary' }}{% endif %}
      {% if product.compare_at_price > product.price %}<span class="catalog-card__badge">{{ 'product.sale' | t }}</span>{% elsif product.available == false %}<span class="catalog-card__badge">{{ 'product.sold_out' | t }}</span>{% endif %}
      <span class="catalog-card__action">{{ 'product.view_piece' | t }}</span>
    </div>
    <div class="catalog-card__meta">{% if show_vendor %}<small>{{ product.vendor }}</small>{% endif %}<h3>{{ product.title }}</h3><p>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s> {% endif %}{{ product.price | money }}</p></div>
  </a>
  {% assign quick_option = product.options_with_values | first %}
  {% if product.options.size == 1 and quick_option.name contains 'Size' and product.available %}
    <div class="catalog-card__quick" aria-label="Quick add {{ product.title | escape }}">
      <span>Quick add</span>
      {% for variant in product.variants %}
        <form method="post" action="{{ routes.cart_add_url }}">
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" {% unless variant.available %}disabled{% endunless %} aria-label="Add {{ product.title | escape }}, size {{ variant.title | escape }} to bag">{{ variant.title }}</button>
        </form>
      {% endfor %}
    </div>
  {% endif %}
  <a class="catalog-card__mobile-cta" href="{{ product.url }}">
    {% if product.has_only_default_variant %}View piece{% else %}Choose options{% endif %}
    <span aria-hidden="true">→</span>
  </a>
</article>
{% stylesheet %}
.catalog-card{position:relative;min-width:0}.catalog-card__media{position:relative;aspect-ratio:3/4;overflow:hidden;background:var(--lilac)}.catalog-card__media img,.catalog-card__media svg{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease),opacity .65s var(--ease)}.catalog-card__image--secondary{position:absolute;inset:0;opacity:0;transform:scale(1.025)}.catalog-card__link:hover .catalog-card__image--primary{opacity:0;transform:scale(1.02)}.catalog-card__link:hover .catalog-card__image--secondary{opacity:1;transform:scale(1.01)}.catalog-card__badge{position:absolute;top:.8rem;left:.8rem;padding:.35rem .55rem;background:var(--ivory);font-size:.55rem;text-transform:uppercase;letter-spacing:.12em}.catalog-card__action{position:absolute;left:.8rem;right:.8rem;bottom:.8rem;padding:.75rem;text-align:center;background:color-mix(in srgb,var(--ivory) 88%,transparent);font-size:.56rem;text-transform:uppercase;letter-spacing:.14em;opacity:0;transform:translateY(8px);transition:opacity .35s var(--ease),transform .35s var(--ease);backdrop-filter:blur(12px)}.catalog-card__link:hover .catalog-card__action,.catalog-card__link:focus-visible .catalog-card__action{opacity:1;transform:none}.catalog-card__meta{padding-top:.8rem}.catalog-card__meta small{display:block;margin-bottom:.25rem;text-transform:uppercase;letter-spacing:.12em;font-size:.52rem;color:color-mix(in srgb,var(--ink) 62%,transparent)}.catalog-card__meta h3,.catalog-card__meta p{margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-size:.74rem;font-weight:400}.catalog-card__meta h3{text-transform:uppercase;letter-spacing:.07em}.catalog-card__meta p{margin-top:.25rem;font-variant-numeric:tabular-nums}.catalog-card__meta s{opacity:.55;margin-right:.35rem}.catalog-card__quick{position:absolute;left:.8rem;right:.8rem;bottom:4.4rem;z-index:2;display:flex;align-items:center;justify-content:center;gap:.35rem;padding:.65rem;background:color-mix(in srgb,var(--ivory) 92%,transparent);opacity:0;transform:translateY(8px);transition:opacity .35s var(--ease),transform .35s var(--ease);backdrop-filter:blur(14px)}.catalog-card:hover .catalog-card__quick,.catalog-card:focus-within .catalog-card__quick{opacity:1;transform:none}.catalog-card__quick>span{margin-right:.3rem;text-transform:uppercase;letter-spacing:.12em;font-size:.5rem}.catalog-card__quick form{margin:0}.catalog-card__quick button{min-width:30px;height:30px;border:1px solid var(--line);background:transparent;color:var(--ink);font-size:.58rem;cursor:pointer;transition:background .25s ease,color .25s ease}.catalog-card__quick button:hover,.catalog-card__quick button:focus-visible{background:var(--coffee);color:var(--ivory)}.catalog-card__quick button:disabled{opacity:.3;text-decoration:line-through;cursor:not-allowed}@media(max-width:767px){.catalog-card__action,.catalog-card__quick{display:none}.catalog-card__image--secondary{display:none}}
{% endstylesheet %}
<style>
  .catalog-card__mobile-cta{display:none}
  @media(max-width:767px){
    .catalog-card__mobile-cta{display:flex;align-items:center;justify-content:space-between;min-height:42px;margin-top:.75rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line);text-transform:uppercase;letter-spacing:.11em;font-size:.57rem;font-weight:600}
    .catalog-card__mobile-cta span{font-size:.9rem}
    .catalog-card__meta h3{font-size:.68rem;line-height:1.45}
    .catalog-card__meta p{font-size:.7rem}
  }
</style>
