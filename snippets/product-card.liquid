{% if product != blank %}<article class="catalog-card" data-reveal>
  <a href="{{ product.url }}" class="catalog-card__link">
    <div class="catalog-card__media{% if product.featured_image %} catalog-card__media--has-secondary{% endif %}">
      {% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: widths: '320,500,750,1000', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: product.featured_image.alt, class: 'catalog-card__image catalog-card__image--primary' }}{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}
      {% if product.images[1] %}
        {{ product.images[1] | image_url: width: 1000 | image_tag: widths: '320,500,750,1000', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: product.images[1].alt, class: 'catalog-card__image catalog-card__image--secondary' }}
      {% elsif product.featured_image %}
        {{ product.featured_image | image_url: width: 1200 | image_tag: widths: '500,750,1000,1200', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: product.featured_image.alt, class: 'catalog-card__image catalog-card__image--secondary catalog-card__image--virtual' }}
      {% endif %}
      {% if product.compare_at_price > product.price %}<span class="catalog-card__badge">{{ 'product.sale' | t }}</span>{% elsif product.available == false %}<span class="catalog-card__badge">{{ 'product.sold_out' | t }}</span>{% endif %}
      <span class="catalog-card__action">{{ 'product.view_piece' | t }}</span>
    </div>
    <div class="catalog-card__meta"><h3>{{ product.title }}</h3><p>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s> {% endif %}{{ product.price | money }}</p></div>
  </a>
  <div class="catalog-card__tools">
    {% if product.has_only_default_variant and product.available %}<form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" aria-label="Add {{ product.title | escape }} to bag"><i><svg viewBox="0 0 24 24"><path d="M6 8h12l-1 13H7L6 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg></i></button></form>{% else %}<a href="{{ product.url }}" aria-label="Choose options for {{ product.title | escape }}"><i><svg viewBox="0 0 24 24"><path d="M6 8h12l-1 13H7L6 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg></i></a>{% endif %}
    <button type="button" data-wishlist-toggle data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}" data-product-url="{{ product.url }}" data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 }}{% endif %}" data-product-price="{{ product.price | money | escape }}" aria-label="Save {{ product.title | escape }} to wishlist" aria-pressed="false"><i><svg viewBox="0 0 24 24"><path d="M20.8 4.8a5.4 5.4 0 0 0-7.7 0L12 5.9l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.5a5.4 5.4 0 0 0 0-7.7Z"/></svg></i></button>
    <a href="{{ product.url }}" aria-label="Compare options for {{ product.title | escape }}"><i><svg viewBox="0 0 24 24"><path d="M8 4v13m0 0-3-3m3 3 3-3M16 20V7m0 0-3 3m3-3 3 3"/></svg></i></a>
    <a href="{{ product.url }}" aria-label="View {{ product.title | escape }}"><i><svg viewBox="0 0 24 24"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></i></a>
  </div>
  <button class="catalog-card__wishlist" type="button" data-wishlist-toggle data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}" data-product-url="{{ product.url }}" data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 }}{% endif %}" data-product-price="{{ product.price | money | escape }}" aria-label="Save {{ product.title | escape }} to wishlist" aria-pressed="false"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.8 4.8a5.4 5.4 0 0 0-7.7 0L12 5.9l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.5a5.4 5.4 0 0 0 0-7.7Z"/></svg></button>
  <a class="catalog-card__mobile-cta" href="{{ product.url }}">
    View piece
    <span aria-hidden="true">&rarr;</span>
  </a>
</article>{% endif %}
{% stylesheet %}
.catalog-card{position:relative;min-width:0}.catalog-card__media{position:relative;aspect-ratio:3/4;overflow:hidden;background:var(--lilac)}.catalog-card__media img,.catalog-card__media svg{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease),opacity .65s var(--ease)}.catalog-card__image--secondary{position:absolute;inset:0;opacity:0;transform:scale(1.025)}.catalog-card__link:hover .catalog-card__media--has-secondary .catalog-card__image--primary{opacity:0;transform:scale(1.02)}.catalog-card__link:hover .catalog-card__media--has-secondary .catalog-card__image--secondary{opacity:1;transform:scale(1.01)}.catalog-card__badge{position:absolute;top:.8rem;left:.8rem;padding:.35rem .55rem;background:var(--ivory);font-size:.55rem;text-transform:uppercase;letter-spacing:.12em}.catalog-card__action{position:absolute;left:.8rem;right:.8rem;bottom:.8rem;padding:.75rem;text-align:center;background:color-mix(in srgb,var(--ivory) 88%,transparent);font-size:.56rem;text-transform:uppercase;letter-spacing:.14em;opacity:0;transform:translateY(8px);transition:opacity .35s var(--ease),transform .35s var(--ease);backdrop-filter:blur(12px)}.catalog-card__link:hover .catalog-card__action,.catalog-card__link:focus-visible .catalog-card__action{opacity:1;transform:none}.catalog-card__meta{padding-top:.8rem}.catalog-card__meta small{display:block;margin-bottom:.25rem;text-transform:uppercase;letter-spacing:.12em;font-size:.52rem;color:color-mix(in srgb,var(--ink) 62%,transparent)}.catalog-card__meta h3,.catalog-card__meta p{margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-size:.74rem;font-weight:400}.catalog-card__meta h3{text-transform:uppercase;letter-spacing:.07em}.catalog-card__meta p{margin-top:.25rem;font-variant-numeric:tabular-nums}.catalog-card__meta s{opacity:.55;margin-right:.35rem}.catalog-card__quick{position:absolute;left:.8rem;right:.8rem;bottom:4.4rem;z-index:2;display:flex;align-items:center;justify-content:center;gap:.35rem;padding:.65rem;background:color-mix(in srgb,var(--ivory) 92%,transparent);opacity:0;transform:translateY(8px);transition:opacity .35s var(--ease),transform .35s var(--ease);backdrop-filter:blur(14px)}.catalog-card:hover .catalog-card__quick,.catalog-card:focus-within .catalog-card__quick{opacity:1;transform:none}.catalog-card__quick>span{margin-right:.3rem;text-transform:uppercase;letter-spacing:.12em;font-size:.5rem}.catalog-card__quick form{margin:0}.catalog-card__quick button{min-width:30px;height:30px;border:1px solid var(--line);background:transparent;color:var(--ink);font-size:.58rem;cursor:pointer;transition:background .25s ease,color .25s ease}.catalog-card__quick button:hover,.catalog-card__quick button:focus-visible{background:var(--coffee);color:var(--ivory)}.catalog-card__quick button:disabled{opacity:.3;text-decoration:line-through;cursor:not-allowed}@media(max-width:767px){.catalog-card__action,.catalog-card__quick{display:none}.catalog-card__image--secondary{display:none}}
{% endstylesheet %}
<style>
  .catalog-card__tools{position:absolute;left:50%;bottom:16px;z-index:4;display:flex;gap:8px;transform:translate(-50%,14px);opacity:0;transition:opacity .3s ease,transform .35s var(--ease)}.catalog-card:hover .catalog-card__tools,.catalog-card:focus-within .catalog-card__tools{opacity:1;transform:translate(-50%,0)}.catalog-card__tools i{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:#fff;color:#000;box-shadow:0 5px 18px rgba(0,0,0,.09);font-style:normal;transition:background .2s,color .2s,transform .2s}.catalog-card__tools i:hover{background:#000;color:#fff;transform:translateY(-3px)}.catalog-card__tools svg{width:21px!important;height:21px!important;fill:none;stroke:currentColor;stroke-width:1.6}.catalog-card__action{display:none}.catalog-card__wishlist{opacity:0;pointer-events:none}
  .catalog-card__mobile-cta{display:none}
  .catalog-card__image--virtual{object-position:58% 38%;transform:scale(1.1)}
  .catalog-card__link:hover .catalog-card__media--has-secondary .catalog-card__image--virtual{object-position:53% 42%;transform:scale(1.13)}
  .catalog-card__wishlist{position:absolute;top:.75rem;right:.75rem;z-index:3;display:grid;place-items:center;width:40px;height:40px;padding:0;border:1px solid rgba(255,255,255,.62);border-radius:50%;background:color-mix(in srgb,var(--ivory) 80%,transparent);color:var(--coffee);cursor:pointer;backdrop-filter:blur(12px);transition:transform .25s var(--ease),background .25s var(--ease),color .25s var(--ease)}
  .catalog-card__wishlist:hover{transform:scale(1.06)}.catalog-card__wishlist:active{transform:scale(.96)}.catalog-card__wishlist svg{width:18px;height:18px;fill:transparent;stroke:currentColor;stroke-width:1.4}.catalog-card__wishlist[aria-pressed=true]{background:var(--coffee);color:var(--ivory)}.catalog-card__wishlist[aria-pressed=true] svg{fill:currentColor}.catalog-card__wishlist.is-celebrating{animation:wishlist-pop .52s var(--ease)}.catalog-card__wishlist.is-celebrating svg{animation:wishlist-heart .52s var(--ease)}@keyframes wishlist-pop{40%{transform:scale(1.18)}70%{transform:scale(.94)}}@keyframes wishlist-heart{45%{transform:scale(1.28) rotate(-7deg)}}
  .catalog-card__quick{border:1px solid color-mix(in srgb,var(--coffee) 14%,transparent);border-radius:999px;box-shadow:inset 0 1px rgba(255,255,255,.7),0 12px 32px rgba(75,54,33,.1)}
  @media(max-width:767px){.catalog-card__tools{display:none}.catalog-card__wishlist{display:none}
    .catalog-card__mobile-cta{display:flex;align-items:center;justify-content:space-between;min-height:42px;margin-top:.75rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line);text-transform:uppercase;letter-spacing:.11em;font-size:.57rem;font-weight:600}
    .catalog-card__mobile-cta span{font-size:.9rem}
    .catalog-card__meta h3{font-size:.68rem;line-height:1.45}
    .catalog-card__meta p{font-size:.7rem}
  }
  @media(prefers-reduced-motion:reduce){.catalog-card__wishlist.is-celebrating,.catalog-card__wishlist.is-celebrating svg{animation:none}}
</style>
<style>.catalog-card__tools form{margin:0}.catalog-card__tools button,.catalog-card__tools>a{display:block;padding:0;border:0;background:transparent;color:inherit;cursor:pointer}.catalog-card__tools button:focus-visible,.catalog-card__tools>a:focus-visible{outline:2px solid #000;outline-offset:3px;border-radius:50%}.catalog-card__tools button:disabled{opacity:.45;cursor:not-allowed}</style>
