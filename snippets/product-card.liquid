{% doc %}
Renders a responsive product card.
@param {product} product - Product to display.
@param {boolean} [show_vendor] - Show the product vendor.
{% enddoc %}
<article class="catalog-card" data-reveal>
  <a href="{{ product.url }}" class="catalog-card__link">
    <div class="catalog-card__media">
      {% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: widths: '320,500,750,1000', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: product.featured_image.alt }}{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}
      {% if product.compare_at_price > product.price %}<span class="catalog-card__badge">{{ 'product.sale' | t }}</span>{% elsif product.available == false %}<span class="catalog-card__badge">{{ 'product.sold_out' | t }}</span>{% endif %}
      <span class="catalog-card__action">{{ 'product.view_piece' | t }}</span>
    </div>
    <div class="catalog-card__meta">{% if show_vendor %}<small>{{ product.vendor }}</small>{% endif %}<h3>{{ product.title }}</h3><p>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s> {% endif %}{{ product.price | money }}</p></div>
  </a>
</article>
{% stylesheet %}.catalog-card{min-width:0}.catalog-card__media{position:relative;aspect-ratio:3/4;overflow:hidden;background:var(--lilac)}.catalog-card__media img,.catalog-card__media svg{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease)}.catalog-card__link:hover img{transform:scale(1.025)}.catalog-card__badge{position:absolute;top:.8rem;left:.8rem;padding:.35rem .55rem;background:var(--ivory);font-size:.55rem;text-transform:uppercase;letter-spacing:.12em}.catalog-card__action{position:absolute;left:.8rem;right:.8rem;bottom:.8rem;padding:.75rem;text-align:center;background:color-mix(in srgb,var(--ivory) 88%,transparent);font-size:.56rem;text-transform:uppercase;letter-spacing:.14em;opacity:0;transform:translateY(8px);transition:opacity .35s var(--ease),transform .35s var(--ease);backdrop-filter:blur(12px)}.catalog-card__link:hover .catalog-card__action,.catalog-card__link:focus-visible .catalog-card__action{opacity:1;transform:none}.catalog-card__meta{padding-top:.8rem}.catalog-card__meta small{display:block;margin-bottom:.25rem;text-transform:uppercase;letter-spacing:.12em;font-size:.52rem;color:color-mix(in srgb,var(--ink) 62%,transparent)}.catalog-card__meta h3,.catalog-card__meta p{margin:0;font-size:.74rem;font-weight:400}.catalog-card__meta h3{text-transform:uppercase;letter-spacing:.07em}.catalog-card__meta p{margin-top:.25rem}.catalog-card__meta s{opacity:.55;margin-right:.35rem}@media(max-width:767px){.catalog-card__action{display:none}}{% endstylesheet %}
