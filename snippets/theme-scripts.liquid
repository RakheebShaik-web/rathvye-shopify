{% doc %}Renders the global RATHVYE theme interactions.{% enddoc %}
<script>
(()=>{
  const body=document.body;
  document.addEventListener('click',event=>{const button=event.target.closest('[data-back-to-top]');if(!button)return;event.preventDefault();document.documentElement.scrollTo({top:0,left:0,behavior:'smooth'});document.body.scrollTo({top:0,left:0,behavior:'smooth'});window.scrollTo({top:0,left:0,behavior:'smooth'})});
  const escapeHtml=value=>{const node=document.createElement('div');node.textContent=value||'';return node.innerHTML};
  const money=value=>new Intl.NumberFormat(document.documentElement.lang||'en-IN',{style:'currency',currency:(window.Shopify&&Shopify.currency&&Shopify.currency.active)||'INR'}).format(value/100);
  const toggle=document.querySelector('[data-menu-toggle]');
  const panel=document.querySelector('[data-mobile-menu]');
  if(toggle&&panel)toggle.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));panel.hidden=open;body.classList.toggle('menu-open',!open)});
  const revealObserver='IntersectionObserver' in window?new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.dataset.visible='true';revealObserver.unobserve(entry.target)}}),{threshold:.1,rootMargin:'0px 0px -4%'}):null;
  const initReveals=(root=document)=>root.querySelectorAll('[data-reveal]:not([data-reveal-ready])').forEach((el,index)=>{el.dataset.revealReady='true';el.style.setProperty('--reveal-delay',`${Math.min(index%8,5)*55}ms`);if(revealObserver)revealObserver.observe(el);else el.dataset.visible='true'});
  initReveals();document.addEventListener('shopify:section:load',event=>initReveals(event.target));

  const search=document.querySelector('[data-search-overlay]');
  const searchInput=document.querySelector('[data-predictive-input]');
  const searchResults=document.querySelector('[data-predictive-results]');
  let searchTimer;
  const openSearch=()=>{if(!search)return;search.hidden=false;body.classList.add('menu-open');setTimeout(()=>searchInput?.focus(),40)};
  const closeSearch=()=>{if(!search)return;search.hidden=true;body.classList.remove('menu-open')};
  document.querySelectorAll('[data-search-open]').forEach(button=>button.addEventListener('click',openSearch));
  document.querySelectorAll('[data-search-close]').forEach(button=>button.addEventListener('click',closeSearch));
  const searchSkeleton=()=>`<div class="predictive-skeleton" aria-hidden="true">${Array.from({length:4},()=>'<i><b></b><span></span></i>').join('')}</div>`;
  if(searchInput&&searchResults)searchInput.addEventListener('input',()=>{clearTimeout(searchTimer);const term=searchInput.value.trim();if(term.length<2){searchResults.innerHTML='';return}searchResults.innerHTML=searchSkeleton();searchTimer=setTimeout(async()=>{searchResults.setAttribute('aria-busy','true');try{const response=await fetch(`/search/suggest?q=${encodeURIComponent(term)}&resources[type]=product&resources[limit]=6&section_id=predictive-search`);searchResults.innerHTML=response.ok?await response.text():''}finally{searchResults.removeAttribute('aria-busy')}},180)});

  const drawer=document.querySelector('[data-cart-drawer]');
  const itemsNode=document.querySelector('[data-cart-items]');
  const emptyNode=document.querySelector('[data-cart-empty]');
  const footerNode=document.querySelector('[data-cart-footer]');
  const totalNode=document.querySelector('[data-cart-total]');
  const progressNode=document.querySelector('[data-shipping-progress]');
  const updateCounts=count=>document.querySelectorAll('[data-cart-count]').forEach(node=>{node.textContent=String(count);node.setAttribute('aria-label',`${count} items`)});
  const updateShippingProgress=total=>{if(!progressNode)return;const threshold=Number(progressNode.dataset.threshold)||0;const complete=threshold>0&&total>=threshold;const percent=threshold>0?Math.min(100,Math.max(0,total/threshold*100)):100;progressNode.dataset.complete=String(complete);progressNode.querySelector('[data-shipping-bar]').style.width=`${percent}%`;progressNode.querySelector('[data-shipping-value]').textContent=`${Math.round(percent)}%`;progressNode.querySelector('[data-shipping-message]').textContent=complete?"You've unlocked Complimentary Express Delivery":`${money(Math.max(0,threshold-total))} away from complimentary delivery`};
  const renderCart=cart=>{if(!drawer||!itemsNode)return;updateCounts(cart.item_count);updateShippingProgress(cart.total_price);emptyNode.hidden=cart.item_count>0;footerNode.hidden=cart.item_count===0;totalNode.textContent=money(cart.total_price);itemsNode.innerHTML=cart.items.map((item,index)=>`<article class="cart-line"><a href="${item.url}">${item.image?`<img src="${item.image}" alt="${escapeHtml(item.product_title)}" width="164" height="210">`:''}</a><div><h3><a href="${item.url}">${escapeHtml(item.product_title)}</a></h3>${item.variant_title?`<small>${escapeHtml(item.variant_title)}</small>`:''}<p>${money(item.final_line_price)}</p><div class="cart-line__qty"><button type="button" data-cart-change="${index+1}" data-quantity="${Math.max(0,item.quantity-1)}" aria-label="Decrease quantity">−</button><span>${item.quantity}</span><button type="button" data-cart-change="${index+1}" data-quantity="${item.quantity+1}" aria-label="Increase quantity">+</button></div></div><button class="cart-line__remove" type="button" data-cart-change="${index+1}" data-quantity="0">Remove</button></article>`).join('')};
  const getCart=async()=>{const response=await fetch('/cart.js',{headers:{Accept:'application/json'}});if(!response.ok)throw new Error('Unable to load cart');const cart=await response.json();renderCart(cart);return cart};
  const openCart=async()=>{if(!drawer){window.location.assign('/cart');return}drawer.setAttribute('aria-hidden','false');body.classList.add('menu-open');try{await getCart()}catch(error){window.location.assign('/cart');return}drawer.querySelector('[data-cart-close]')?.focus()};
  const closeCart=()=>{if(!drawer)return;drawer.setAttribute('aria-hidden','true');body.classList.remove('menu-open')};
  document.addEventListener('click',event=>{const trigger=event.target.closest('[data-cart-open]');if(!trigger)return;event.preventDefault();openCart()});
  document.querySelectorAll('[data-cart-close]').forEach(button=>button.addEventListener('click',closeCart));
  drawer?.addEventListener('click',async event=>{const button=event.target.closest('[data-cart-change]');if(!button)return;drawer.classList.add('cart-loading');try{const response=await fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({line:Number(button.dataset.cartChange),quantity:Number(button.dataset.quantity)})});if(!response.ok)throw new Error('Unable to update cart');renderCart(await response.json())}finally{drawer.classList.remove('cart-loading')}});
  document.addEventListener('submit',async event=>{const form=event.target.closest('form[action*="/cart/add"]');if(!form)return;event.preventDefault();const submit=form.querySelector('[type=submit]');if(submit)submit.disabled=true;try{const response=await fetch('/cart/add.js',{method:'POST',headers:{Accept:'application/json'},body:new FormData(form)});if(!response.ok)throw new Error('Cart request failed');await openCart()}catch(error){const errorNode=form.querySelector('[data-product-error]');if(errorNode){errorNode.textContent='We could not add this piece. Please review your selection and try again.';errorNode.hidden=false}}finally{if(submit)submit.disabled=false}});

  const wishlistKey='rathvye:wishlist:v1';
  const recentKey='rathvye:recent:v1';
  const readLocal=(key)=>{try{const value=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(value)?value:[]}catch{return[]}};
  const writeLocal=(key,value)=>{try{localStorage.setItem(key,JSON.stringify(value))}catch{}};
  const productFromNode=node=>({handle:node.dataset.productHandle||'',title:node.dataset.productTitle||'',url:node.dataset.productUrl||'',image:node.dataset.productImage||'',price:node.dataset.productPrice||''});
  const productTile=(item,removeLabel='Remove')=>`<article class="saved-product" data-saved-handle="${escapeHtml(item.handle)}"><a href="${escapeHtml(item.url)}"><div class="saved-product__media">${item.image?`<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" loading="lazy">`:''}</div><div class="saved-product__meta"><h3>${escapeHtml(item.title)}</h3><p>${escapeHtml(item.price)}</p></div></a>${removeLabel?`<button type="button" data-wishlist-remove="${escapeHtml(item.handle)}">${removeLabel}</button>`:''}</article>`;
  const renderWishlist=()=>{const items=readLocal(wishlistKey);document.querySelectorAll('[data-wishlist-grid]').forEach(grid=>{grid.innerHTML=items.map(item=>productTile(item)).join('');grid.hidden=items.length===0});document.querySelectorAll('[data-wishlist-empty]').forEach(empty=>empty.hidden=items.length>0)};
  const renderRecent=()=>{const items=readLocal(recentKey);document.querySelectorAll('[data-recent-grid]').forEach(grid=>{const current=grid.dataset.currentHandle||'';const visible=items.filter(item=>item.handle!==current).slice(0,4);grid.innerHTML=visible.map(item=>productTile(item,'')).join('');grid.closest('[data-recent-section]').hidden=visible.length===0})};
  const syncWishlist=()=>{const items=readLocal(wishlistKey);const handles=new Set(items.map(item=>item.handle));document.querySelectorAll('[data-wishlist-count]').forEach(node=>node.textContent=String(items.length));document.querySelectorAll('[data-wishlist-toggle]').forEach(button=>{const saved=handles.has(button.dataset.productHandle);button.setAttribute('aria-pressed',String(saved));button.setAttribute('aria-label',`${saved?'Remove':'Save'} ${button.dataset.productTitle||'product'} ${saved?'from':'to'} wishlist`);const label=button.querySelector('[data-wishlist-label]');if(label)label.textContent=saved?'Saved to wishlist':'Save to wishlist'});renderWishlist()};
  document.addEventListener('click',event=>{const toggleButton=event.target.closest('[data-wishlist-toggle]');if(toggleButton){event.preventDefault();const product=productFromNode(toggleButton);if(!product.handle)return;let items=readLocal(wishlistKey);const exists=items.some(item=>item.handle===product.handle);items=exists?items.filter(item=>item.handle!==product.handle):[product,...items];writeLocal(wishlistKey,items.slice(0,50));syncWishlist();if(!exists){toggleButton.classList.remove('is-celebrating');requestAnimationFrame(()=>toggleButton.classList.add('is-celebrating'));setTimeout(()=>toggleButton.classList.remove('is-celebrating'),560)}return}const removeButton=event.target.closest('[data-wishlist-remove]');if(removeButton){const items=readLocal(wishlistKey).filter(item=>item.handle!==removeButton.dataset.wishlistRemove);writeLocal(wishlistKey,items);syncWishlist()}});
  const currentProduct=document.querySelector('.product-wishlist[data-product-handle]');
  if(currentProduct){const product=productFromNode(currentProduct);const recent=[product,...readLocal(recentKey).filter(item=>item.handle!==product.handle)].slice(0,8);writeLocal(recentKey,recent)}
  syncWishlist();renderRecent();
  if(matchMedia('(hover:hover) and (pointer:fine)').matches&&!matchMedia('(prefers-reduced-motion:reduce)').matches){document.addEventListener('pointermove',event=>{const button=event.target.closest('.button');if(!button)return;const rect=button.getBoundingClientRect();button.style.setProperty('--magnetic-x',`${(event.clientX-(rect.left+rect.width/2))*.07}px`);button.style.setProperty('--magnetic-y',`${(event.clientY-(rect.top+rect.height/2))*.1}px`)});document.addEventListener('pointerout',event=>{const button=event.target.closest('.button');if(button){button.style.removeProperty('--magnetic-x');button.style.removeProperty('--magnetic-y')}})}
  document.addEventListener('keydown',event=>{if(event.key!=='Escape')return;if(search&&!search.hidden)closeSearch();if(drawer?.getAttribute('aria-hidden')==='false')closeCart()});
})();
</script>
