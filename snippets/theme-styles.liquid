{% doc %}
Renders the global RATHVYE theme styles.
{% enddoc %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap');
  @view-transition{navigation:auto}
  :root{--lilac:{{ settings.color_lilac }};--coffee:{{ settings.color_coffee }};--ink:{{ settings.color_ink }};--ivory:{{ settings.color_ivory }};--line:color-mix(in srgb,var(--coffee) 18%,transparent);--page:1440px;--ease:cubic-bezier(.16,1,.3,1)}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--ivory);color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6}body.menu-open{overflow:hidden}img,svg{display:block;max-width:100%}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}.skip-link{position:fixed;left:1rem;top:1rem;z-index:100;transform:translateY(-200%);background:var(--coffee);color:var(--ivory);padding:.75rem 1rem}.skip-link:focus{transform:none}.page-width{width:min(calc(100% - 48px),var(--page));margin-inline:auto}.eyebrow{margin:0 0 1rem;text-transform:uppercase;letter-spacing:.22em;font-size:.72rem}.display{font-family:Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.045em;line-height:.94}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.8rem 1.4rem;border:1px solid var(--coffee);background:var(--coffee);color:var(--ivory);text-transform:uppercase;letter-spacing:.15em;font-size:.7rem;cursor:pointer;transition:transform .35s var(--ease),background .35s var(--ease),color .35s var(--ease)}.button:hover{background:transparent;color:var(--coffee)}.button:active{transform:translateY(1px)}.button--light{border-color:var(--ivory);background:var(--ivory);color:var(--coffee)}.button--light:hover{background:transparent;color:var(--ivory)}.field{display:grid;gap:.45rem}.field label{text-transform:uppercase;letter-spacing:.16em;font-size:.68rem}.field input,.field textarea,.field select{width:100%;border:0;border-bottom:1px solid var(--coffee);border-radius:0;background:transparent;padding:.8rem 0;color:var(--ink)}.field input:focus,.field textarea:focus,.field select:focus{outline:2px solid var(--lilac);outline-offset:4px}.rte{max-width:70ch}.rte a{text-decoration:underline;text-underline-offset:3px}.empty-state{padding:8rem 1.5rem;text-align:center}.empty-state .display{font-size:clamp(2.4rem,7vw,5.5rem);margin:.5rem 0 1.5rem}.shopify-policy__container{max-width:850px!important;margin-block:6rem!important}.errors{color:#8a2330}.visually-hidden{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;white-space:nowrap!important}
  .hero{position:relative;display:grid;grid-template-columns:minmax(0,46%) 1fr;min-height:min(820px,calc(100dvh - 123px));overflow:hidden;background:var(--hero-bg);color:var(--hero-text)}.hero--image_left{grid-template-columns:1fr minmax(0,46%)}.hero--image_left .hero-media{order:-1}.hero-copy{align-self:center;padding:clamp(3rem,4.5vw,5.5rem);opacity:0;transform:translateY(24px);transition:opacity 1s var(--ease),transform 1s var(--ease)}.hero-copy[data-visible=true]{opacity:1;transform:none}.hero .display{font-size:clamp(3.15rem,5vw,5.9rem);max-width:10ch;margin:.2rem 0 1.5rem;overflow-wrap:normal;word-break:normal;text-wrap:balance}.hero-text{max-width:43ch;margin:0 0 2.3rem}.hero-media{position:relative;min-height:560px;overflow:hidden}.hero-media img,.hero-media svg{width:100%;height:100%;object-fit:cover}.hero::before{content:"";position:absolute;width:34vw;height:34vw;left:-14vw;bottom:-18vw;border-radius:50%;background:color-mix(in srgb,var(--ivory) 28%,transparent);filter:blur(80px);pointer-events:none}.hero-stamp{position:absolute;right:2rem;bottom:2rem;width:108px;height:108px;border:1px solid rgba(255,255,255,.45);border-radius:50%;display:grid;place-content:center;text-align:center;background:color-mix(in srgb,var(--ivory) 68%,transparent);box-shadow:inset 0 1px 0 rgba(255,255,255,.65),0 20px 50px rgba(75,54,33,.14);color:var(--coffee);font-family:Georgia,serif;font-size:2.3rem;line-height:.7;backdrop-filter:blur(16px) saturate(120%)}.hero-stamp small{font-family:Arial,sans-serif;font-size:.38rem;text-transform:uppercase;letter-spacing:.12em;margin-top:.7rem}
  @media(max-width:899px){.hero,.hero--image_left{grid-template-columns:1fr}.hero-copy{padding:3.5rem 1.5rem}.hero .display{font-size:clamp(3rem,13vw,4.7rem);max-width:11ch}.hero-media,.hero--image_left .hero-media{order:-1;min-height:58dvh}.hero-stamp{width:88px;height:88px;right:1rem;bottom:1rem}}
  .featured .product-card{opacity:1;transform:none}.featured .product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(1rem,2.2vw,2.5rem);align-items:start}.featured .product-card:nth-child(n){grid-column:auto;margin-top:0}.featured .product-card-media{aspect-ratio:4/5;background:#d8cec2}.featured .product-card-media img{width:100%;height:100%;object-fit:cover;object-position:center top}
  @media(max-width:899px){.featured .product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:2.5rem .8rem}.featured .product-card:nth-child(n){grid-column:auto;margin-top:0}.featured .product-card-media{aspect-ratio:3/4}.featured .product-card:nth-child(n) img{object-fit:cover;object-position:center top}}
  @media(max-width:767px){.page-width{width:min(calc(100% - 32px),var(--page))}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>
<style>
  a,button{-webkit-tap-highlight-color:transparent}
  button:disabled{cursor:not-allowed}
  input::placeholder,textarea::placeholder{color:color-mix(in srgb,var(--ink) 48%,transparent)}
  .button{font-weight:600;box-shadow:0 8px 24px rgba(75,54,33,.08)}
  .button:hover{box-shadow:none}
  @media(hover:none){.button:hover{background:var(--coffee);color:var(--ivory)}.button--light:hover{background:var(--ivory);color:var(--coffee)}}
  @media(max-width:767px){
    .page-width{width:min(calc(100% - 28px),var(--page))}
    .category-edit{padding-block:4.75rem}
    .category-edit__head{margin-bottom:2.25rem}
    .category-edit__head .display{font-size:clamp(3rem,14vw,4.4rem);line-height:.92}
    .category-edit__grid{gap:1rem}
    .category-tile__media{aspect-ratio:4/5}
    .category-tile__caption{padding:1rem 1.1rem}
    .category-tile__caption h3{font-size:clamp(2rem,10vw,3rem)}
    .featured{padding-bottom:5rem}
    .featured .section-heading{margin-bottom:2rem}
    .featured .section-heading .display{font-size:clamp(2.8rem,13vw,4rem)}
    .story-media{min-height:55svh}
    .story-copy{padding:3.5rem 1.4rem 4.25rem}
    .story-copy .display{font-size:clamp(3rem,14vw,4.5rem)}
    .assurance{padding:1.6rem 1.25rem}
    .assurance span{margin-bottom:.75rem}
    .newsletter{padding-block:5rem 5.75rem}
    .newsletter .display{font-size:clamp(3rem,14vw,4.5rem)}
    .newsletter-form{padding:1rem;border-radius:12px}
    .footer-grid a{min-height:34px;display:flex;align-items:center}
  }
</style>
<style>
  body,button,input,textarea,select{font-family:'Plus Jakarta Sans',sans-serif}
  .display,.wordmark,.hero .display,h1,h2,h3{font-family:'Playfair Display',Georgia,serif}
</style>
<style>
  [hidden]{display:none!important}html,body{overflow-x:clip}main{min-width:0}
  @media(max-width:767px){body{font-size:14px}.eyebrow{font-size:.61rem;letter-spacing:.18em}.button{min-height:46px;padding:.75rem 1rem}.empty-state{padding:5rem 1rem}.shopify-policy__container{margin-block:3.5rem!important;padding-inline:1rem!important}.featured .product-grid{gap:2rem .7rem}.featured .product-meta{padding-top:.65rem}.featured .product-meta h3,.featured .product-meta span{font-size:.65rem}.footer{padding-top:3.8rem}.footer-grid{gap:2.5rem 1.25rem}.footer-mark{font-size:1.6rem}.footer-bottom{margin-top:2.5rem}}
</style>
<style>
  body{text-rendering:optimizeLegibility}body::after{content:"";position:fixed;inset:0;z-index:90;pointer-events:none;opacity:.025;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E")}:focus-visible{outline:2px solid var(--coffee);outline-offset:4px}.display{text-wrap:balance}.rte p{max-width:65ch;text-wrap:pretty}::selection{background:var(--lilac);color:var(--coffee)}[aria-busy=true]{opacity:.55}.shopify-challenge__container{padding-block:5rem}.shopify-challenge__button{border:1px solid var(--coffee)!important;background:var(--coffee)!important;color:var(--ivory)!important;padding:.8rem 1.4rem!important}
</style>
