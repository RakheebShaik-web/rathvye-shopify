{% if predictive_search.performed %}<div class="predictive-results">{% if predictive_search.resources.products.size > 0 %}<p class="predictive-results__label">{{ 'search.products' | t }}</p><div class="predictive-results__grid">{% for product in predictive_search.resources.products limit: 6 %}<a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: product.featured_image.alt }}{% endif %}<span><strong>{{ product.title }}</strong><small>{{ product.price | money }}</small></span></a>{% endfor %}</div>{% else %}<p>{{ 'search.no_results' | t }}</p>{% endif %}</div>{% endif %}
{% stylesheet %}.predictive-results__label{text-transform:uppercase;letter-spacing:.15em;font-size:.6rem}.predictive-results__grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.predictive-results__grid a{display:grid;grid-template-columns:60px 1fr;gap:.8rem;align-items:center;padding:.6rem 0;border-bottom:1px solid var(--line)}.predictive-results__grid img{width:60px;height:76px;object-fit:cover}.predictive-results__grid strong,.predictive-results__grid small{display:block;font-size:.68rem;font-weight:400}.predictive-results__grid strong{text-transform:uppercase;letter-spacing:.08em}.predictive-results__grid small{margin-top:.25rem}@media(max-width:600px){.predictive-results__grid{grid-template-columns:1fr}}{% endstylesheet %}
{% schema %}{"name":"Predictive search","settings":[]}{% endschema %}
