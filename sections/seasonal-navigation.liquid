<section class="seasonal-nav page-width">
  <div class="seasonal-nav__head"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="display">{{ section.settings.heading }}</h2></div>
  <div class="seasonal-nav__grid">{% for block in section.blocks %}<a class="seasonal-card seasonal-card--{{ forloop.index }}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><span>0{{ forloop.index }}</span><div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p><em>Discover</em></div></a>{% endfor %}</div>
</section>
{% stylesheet %}
  .seasonal-nav{padding-bottom:clamp(7rem,12vw,12rem)}.seasonal-nav .eyebrow{color:inherit}.seasonal-nav__head{display:flex;justify-content:space-between;align-items:end;margin-bottom:3rem}.seasonal-nav__head .display{max-width:8ch;margin:0;font-size:clamp(3rem,5vw,5.5rem)}.seasonal-nav__grid{display:grid;grid-template-columns:repeat(3,1fr);min-height:470px}.seasonal-card{position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(1.5rem,3vw,3rem);overflow:hidden;border:1px solid var(--line);transition:color .55s var(--ease),background .55s var(--ease),transform .55s var(--ease)}.seasonal-card+.seasonal-card{border-left:0}.seasonal-card--1{background:var(--lilac)}.seasonal-card--2{background:var(--ivory)}.seasonal-card--3{background:var(--coffee);color:var(--ivory)}.seasonal-card:hover{transform:translateY(-8px)}.seasonal-card span{font-size:.6rem;letter-spacing:.16em}.seasonal-card h3{margin:0 0 .8rem;font-family:Georgia,serif;font-size:clamp(2rem,3.5vw,4rem);font-weight:400;line-height:1}.seasonal-card p{max-width:25ch;margin:0 0 2rem;font-size:.78rem}.seasonal-card em{text-transform:uppercase;letter-spacing:.16em;font-size:.58rem;font-style:normal;border-bottom:1px solid;padding-bottom:.35rem}
  @media(max-width:767px){.seasonal-nav__head{display:block}.seasonal-nav__head .display{margin-top:1rem}.seasonal-nav__grid{grid-template-columns:1fr;min-height:0}.seasonal-card{min-height:300px}.seasonal-card+.seasonal-card{border-left:1px solid var(--line);border-top:0}.seasonal-card:hover{transform:none}}
{% endstylesheet %}
{% schema %}
{"name":"Seasonal navigation","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Explore the house"},{"type":"textarea","id":"heading","label":"Heading","default":"Choose your entrance."}],"blocks":[{"type":"edit","name":"Edit","settings":[{"type":"text","id":"heading","label":"Heading","default":"Occasion"},{"type":"textarea","id":"text","label":"Text","default":"Long lines and decisive colour for evenings that call for more."},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":3,"presets":[{"name":"Seasonal navigation","blocks":[{"type":"edit"},{"type":"edit"},{"type":"edit"}]}]}
{% endschema %}
