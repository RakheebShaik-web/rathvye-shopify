<section class="collection page-width">
  <header class="collection-header"><p class="eyebrow">{{ collection.products_count }} pieces</p><h1 class="display">{{ collection.title }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</header>
  <form class="collection-sort" method="get"><label for="SortBy">{{ 'collection.sort_by' | t }}</label><select id="SortBy" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form>
  {% paginate collection.products by 24 %}<div class="product-grid">{% for product in collection.products %}<article><a href="{{ product.url }}"><div class="product-card-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: widths: '360,600,900', loading: 'lazy', alt: product.featured_image.alt }}{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</div><div class="product-meta"><h2>{{ product.title }}</h2><span>{{ product.price | money }}</span></div></a></article>{% else %}<div class="collection-header"><p>{{ 'collection.empty' | t }}</p></div>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}
</section>
{% stylesheet %}.eyebrow,.rte{color:inherit}.collection{padding-block:clamp(4rem,8vw,8rem)}.collection-header{max-width:850px;margin-bottom:3rem}.collection-header .display{font-size:clamp(3.5rem,9vw,8rem);margin:.3rem 0 1.5rem}.collection-sort{display:flex;justify-content:flex-end;align-items:center;gap:1rem;margin-bottom:1.5rem}.collection-sort label{font-size:.62rem;text-transform:uppercase;letter-spacing:.14em}.collection-sort select{border:0;border-bottom:1px solid var(--line);background:transparent;padding:.65rem 1.8rem .65rem .2rem}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}.product-card-media{aspect-ratio:3/4;background:var(--lilac);overflow:hidden}.product-card-media img,.product-card-media svg{width:100%;height:100%;object-fit:cover}.product-meta{display:flex;justify-content:space-between;gap:1rem;padding-top:1rem}.product-meta h2{font-size:.78rem;font-weight:400;margin:0}.pagination{text-align:center;margin-top:4rem}.pagination span{margin:.4rem}@media(max-width:899px){.product-grid{grid-template-columns:repeat(2,1fr)}}{% endstylesheet %}
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
