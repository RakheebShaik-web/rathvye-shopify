<section class="collection page-width">
  <header class="collection-header"><p>{{ collection.products_count }} {{ 'collection.pieces' | t }}</p><h1 class="display">{{ collection.title }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</header>
  <form class="collection-tools" method="get" data-filter-form><details class="collection-filters"><summary>{{ 'collection.filter' | t }}{% if collection.filters %}<span>({% assign active_count = 0 %}{% for filter in collection.filters %}{% assign active_count = active_count | plus: filter.active_values.size %}{% endfor %}{{ active_count }})</span>{% endif %}</summary><div class="filter-panel">{% for filter in collection.filters %}<fieldset><legend>{{ filter.label }}</legend>{% case filter.type %}{% when 'boolean', 'list' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}><span>{{ value.label }} ({{ value.count }})</span></label>{% endfor %}{% when 'price_range' %}<div class="price-filter"><label>{{ 'collection.from' | t }}<input name="{{ filter.min_value.param_name }}" type="number" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}"></label><label>{{ 'collection.to' | t }}<input name="{{ filter.max_value.param_name }}" type="number" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}"></label></div>{% endcase %}</fieldset>{% endfor %}<div class="filter-actions"><a href="{{ collection.url }}">{{ 'collection.clear' | t }}</a><button type="submit">{{ 'collection.apply' | t }}</button></div></div></details><div class="collection-sort"><label for="SortBy">{{ 'collection.sort_by' | t }}</label><select id="SortBy" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></div></form>
  <div class="active-filters">{% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label }} ×</a>{% endfor %}{% if filter.type == 'price_range' and filter.min_value.value or filter.max_value.value %}<a href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money }}–{{ filter.max_value.value | default: filter.range_max | money }} ×</a>{% endif %}{% endfor %}</div>
  {% paginate collection.products by 24 %}<div class="catalog-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="collection-empty"><h2 class="display">{{ 'collection.no_match' | t }}</h2><p>{{ 'collection.adjust_filters' | t }}</p><a href="{{ collection.url }}">{{ 'collection.clear' | t }}</a></div>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}
</section>
{% stylesheet %}.collection{padding-block:clamp(4rem,8vw,8rem)}.collection-header{max-width:850px;margin-bottom:3rem}.collection-header>p{text-transform:uppercase;letter-spacing:.18em;font-size:.64rem}.collection-header .display{font-size:clamp(3.5rem,9vw,8rem);margin:.3rem 0 1.5rem}.collection-tools{position:relative;display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;border-block:1px solid var(--line);padding:.85rem 0}.collection-filters summary{cursor:pointer;list-style:none;text-transform:uppercase;letter-spacing:.14em;font-size:.62rem}.collection-filters summary::-webkit-details-marker{display:none}.filter-panel{position:absolute;left:0;right:0;top:100%;z-index:10;display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;padding:2rem;background:var(--ivory);border-bottom:1px solid var(--line);box-shadow:0 25px 45px rgba(75,54,33,.1)}.filter-panel fieldset{border:0;padding:0;margin:0}.filter-panel legend{margin-bottom:.8rem;text-transform:uppercase;letter-spacing:.13em;font-size:.6rem}.filter-panel label{display:flex;gap:.5rem;margin:.45rem 0;font-size:.7rem}.price-filter{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.price-filter label{display:grid}.price-filter input{width:100%;border:0;border-bottom:1px solid var(--line);background:transparent}.filter-actions{grid-column:1/-1;display:flex;justify-content:flex-end;align-items:center;gap:1.5rem}.filter-actions>a{text-decoration:underline;font-size:.65rem}.collection-sort{display:flex;align-items:center;gap:1rem}.collection-sort label{font-size:.62rem;text-transform:uppercase;letter-spacing:.14em}.collection-sort select{border:0;background:transparent;padding:.4rem}.active-filters{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem}.active-filters a{padding:.4rem .6rem;border:1px solid var(--line);font-size:.58rem;text-transform:uppercase;letter-spacing:.08em}.catalog-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2.5rem 1.25rem}.collection-empty{grid-column:1/-1;padding:6rem 1rem;text-align:center}.collection-empty .display{font-size:clamp(2.5rem,6vw,5rem);margin:0 0 1rem}.pagination{text-align:center;margin-top:4rem}.pagination span{margin:.4rem}@media(max-width:899px){.catalog-grid{grid-template-columns:repeat(2,1fr)}.filter-panel{grid-template-columns:1fr 1fr}}@media(max-width:600px){.collection-tools{align-items:flex-start}.collection-sort label{display:none}.filter-panel{grid-template-columns:1fr;max-height:68vh;overflow:auto;padding:1.2rem}.filter-actions{position:sticky;bottom:-1.2rem;background:var(--ivory);padding:1rem 0}.catalog-grid{gap:2rem .8rem}}{% endstylesheet %}
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
