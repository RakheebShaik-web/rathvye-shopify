<header class="site-header" data-header>
  {% if section.settings.show_announcement %}<div class="announcement">{{ section.settings.announcement }}</div>{% endif %}
  <div class="header-inner page-width">
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu"><span></span><span></span><span class="visually-hidden">{{ 'general.menu' | t }}</span></button>
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 360 | image_tag: widths: '140,220,360', alt: shop.name }}{% else %}<span>RATHVYE</span><small>Defined by style</small>{% endif %}</a>
    <nav class="desktop-nav" aria-label="Primary">{% if section.settings.menu.links.size > 3 %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">New arrivals</a><a href="{{ routes.all_products_collection_url }}">Dresses</a><a href="{{ routes.all_products_collection_url }}">Separates</a><a href="/pages/contact">Contact</a>{% endif %}</nav>
    <div class="header-actions"><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{{ 'general.account' | t }}</a>{% endif %}<a href="{{ routes.cart_url }}">{{ 'general.cart' | t }} <span aria-hidden="true">({{ cart.item_count }})</span></a></div>
  </div>
  <nav id="MobileMenu" class="mobile-menu" data-mobile-menu hidden aria-label="Mobile">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav>
</header>
{% stylesheet %}
  .site-header{position:relative;z-index:20;background:var(--ivory);border-bottom:1px solid var(--line)}.announcement{padding:.55rem 1rem;text-align:center;background:var(--coffee);color:var(--ivory);text-transform:uppercase;letter-spacing:.16em;font-size:.62rem}.header-inner{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:92px}.wordmark{text-align:center;line-height:1}.wordmark span{display:block;font-family:Georgia,serif;font-size:1.35rem;letter-spacing:.45em;margin-right:-.45em}.wordmark small{display:block;margin-top:.55rem;text-transform:uppercase;letter-spacing:.34em;font-size:.48rem}.wordmark img{max-height:64px;width:auto}.desktop-nav{display:flex;gap:2rem}.desktop-nav a,.header-actions a{text-transform:uppercase;letter-spacing:.14em;font-size:.66rem}.header-actions{display:flex;justify-content:flex-end;gap:1.5rem}.menu-toggle{display:none;border:0;background:transparent;padding:.5rem}.menu-toggle span:not(.visually-hidden){display:block;width:22px;height:1px;background:currentColor;margin:5px}.mobile-menu{position:fixed;inset:0;top:calc(92px + 31px);background:var(--lilac);padding:3rem 1.5rem}.mobile-menu a{display:block;padding:1rem 0;border-bottom:1px solid color-mix(in srgb,var(--coffee) 20%,transparent);font-family:Georgia,serif;font-size:2rem}
  @media(max-width:899px){.header-inner{grid-template-columns:1fr auto 1fr;min-height:74px}.desktop-nav{display:none}.menu-toggle{display:block;justify-self:start}.header-actions a:not(:last-child){display:none}.mobile-menu{top:calc(74px + 31px)}}
  .site-header{position:sticky;top:0;background:color-mix(in srgb,var(--ivory) 78%,transparent);border-bottom-color:color-mix(in srgb,var(--ivory) 55%,transparent);box-shadow:inset 0 1px 0 rgba(255,255,255,.46);backdrop-filter:blur(18px) saturate(115%)}.desktop-nav a,.header-actions a{position:relative}.desktop-nav a::after,.header-actions a::after{content:"";position:absolute;left:0;right:0;bottom:-.4rem;height:1px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform .45s var(--ease)}.desktop-nav a:hover::after,.header-actions a:hover::after{transform:scaleX(1);transform-origin:left}.mobile-menu a{transition:padding-left .35s var(--ease)}.mobile-menu a:hover{padding-left:.5rem}
{% endstylesheet %}
{% schema %}
{"name":"Header","settings":[{"type":"checkbox","id":"show_announcement","label":"Show announcement","default":true},{"type":"text","id":"announcement","label":"Announcement","default":"Free shipping across India on prepaid orders"},{"type":"image_picker","id":"logo","label":"Logo"},{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}
{% endschema %}
