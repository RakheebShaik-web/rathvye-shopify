<header class="site-header" data-header>
  <div class="header-inner page-width">
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu" aria-label="Menu"><span></span><span></span></button>
    <a class="wordmark" href="{{ routes.root_url }}">{{ section.settings.wordmark | default: shop.name }}</a>
    <nav class="desktop-nav" aria-label="Primary">
      {% if section.settings.menu.links.size > 0 %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}{% if link.links.size > 0 %}<span>⌄</span>{% endif %}</a>{% endfor %}{% else %}
      <a href="{{ routes.root_url }}">Home</a><a href="/collections/womens">Women's wear <span>⌄</span></a><a href="/collections/mens">Men's wear <span>⌄</span></a><a href="/collections/seasonal-outfit">Seasonal outfit <span>⌄</span></a><a href="/collections/new-arrivals">New arrivals</a><a href="/pages/contact">Contact</a>{% endif %}
    </nav>
    <div class="header-actions">
      <button type="button" data-search-open aria-label="Search"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.5"/><path d="m16 16 4.2 4.2"/></svg></button>
      {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="3.2"/><path d="M5.5 21c.4-5 2.7-7.4 6.5-7.4s6.1 2.4 6.5 7.4"/></svg></a>{% endif %}
      <a href="/pages/wishlist" aria-label="Wishlist" class="count-icon"><svg viewBox="0 0 24 24"><path d="M20.8 4.8a5.4 5.4 0 0 0-7.7 0L12 5.9l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.5a5.4 5.4 0 0 0 0-7.7Z"/></svg><b data-wishlist-count>0</b></a>
      <button type="button" data-cart-open aria-label="Open bag" class="bag-action"><span>BAG</span><b data-cart-count>{{ cart.item_count }}</b></button>
    </div>
  </div>
  <nav id="MobileMenu" class="mobile-menu" data-mobile-menu hidden>{% if section.settings.menu.links.size > 0 %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="/">Home</a><a href="/collections/womens">Women's wear</a><a href="/collections/mens">Men's wear</a><a href="/collections/seasonal-outfit">Seasonal outfit</a><a href="/collections/new-arrivals">New arrivals</a><a href="/pages/contact">Contact</a>{% endif %}</nav>
  <div class="search-overlay" data-search-overlay hidden><button class="search-overlay__backdrop" data-search-close aria-label="Close"></button><div class="search-overlay__panel"><header><p>What are you looking for?</p><button data-search-close aria-label="Close">×</button></header><form action="{{ routes.search_url }}" method="get"><input type="search" name="q" placeholder="Search products" data-predictive-input><input type="hidden" name="type" value="product"><button>Search</button></form><div data-predictive-results></div></div></div>
</header>
{% stylesheet %}
.site-header{position:sticky;top:0;z-index:30;background:#fff;color:#000}.header-inner{height:76px;display:grid;grid-template-columns:190px 1fr 190px;align-items:center;gap:24px}.wordmark{font-size:20px;font-weight:700;text-transform:uppercase;white-space:nowrap}.desktop-nav{display:flex;justify-content:center;gap:34px}.desktop-nav a{position:relative;padding:28px 0 24px;font-size:13px;font-weight:500;text-transform:uppercase;letter-spacing:.08em;white-space:nowrap}.desktop-nav a span{font-size:14px;margin-left:3px}.desktop-nav a:after{content:"";position:absolute;left:0;right:0;bottom:21px;height:1px;background:#000;transform:scaleX(0);transition:transform .3s}.desktop-nav a:hover:after,.desktop-nav a[aria-current=page]:after{transform:scaleX(1)}.header-actions{display:flex;justify-content:flex-end;align-items:center;gap:20px}.header-actions button,.header-actions a{position:relative;display:grid;place-items:center;width:20px;height:26px;border:0;padding:0;background:none;color:#000;cursor:pointer}.header-actions svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.6}.count-icon b{position:absolute;top:-5px;right:-9px;display:grid;place-items:center;min-width:17px;height:17px;border-radius:50%;background:#000;color:#fff;font-size:10px;font-weight:500}.menu-toggle{display:none;border:0;background:none}.mobile-menu{position:fixed;inset:64px 0 0;z-index:32;padding:20px 24px;background:#fff}.mobile-menu a{display:block;padding:18px 0;border-bottom:1px solid #e6e6e6;font-size:24px;font-weight:300}.search-overlay{position:fixed;inset:0;z-index:70}.search-overlay__backdrop{position:absolute;inset:0;border:0;background:rgba(0,0,0,.35)}.search-overlay__panel{position:relative;width:min(780px,calc(100% - 30px));margin:100px auto;background:#fff;padding:28px}.search-overlay__panel header{display:flex;justify-content:space-between}.search-overlay__panel header p{margin:0;font-size:20px}.search-overlay__panel header button{border:0;background:none;font-size:26px}.search-overlay__panel form{display:grid;grid-template-columns:1fr auto;margin-top:24px;border-bottom:1px solid #000}.search-overlay__panel input,.search-overlay__panel form button{border:0;background:none;padding:14px 0}.search-overlay__panel form button{text-transform:uppercase;letter-spacing:.1em}
.header-actions .bag-action{width:auto;min-width:42px}.bag-action span{font-family:'Playfair Display',Georgia,serif;font-size:16px;font-style:italic;font-weight:600;letter-spacing:.04em}.bag-action b{position:absolute;top:-5px;right:-9px;display:grid;place-items:center;min-width:17px;height:17px;border-radius:50%;background:#000;color:#fff;font-family:'Outfit',sans-serif;font-size:10px;font-style:normal;font-weight:500}
@media(max-width:1050px){.site-header{position:static}.header-inner{grid-template-columns:1fr auto 1fr;height:67px}.desktop-nav{display:none}.menu-toggle{display:block;justify-self:start;width:28px;padding:0}.menu-toggle span{display:block;width:22px;height:1px;background:#000;margin:6px 0}.wordmark{justify-self:center;font-size:19px}.header-actions>a,.header-actions>button:not(.bag-action){display:none}.header-actions{gap:0}.header-actions .bag-action{display:grid}.bag-action span{font-size:17px}.page-width{width:min(calc(100% - 30px),1440px)}}
{% endstylesheet %}
{% schema %}{"name":"Header","settings":[{"type":"text","id":"wordmark","label":"Wordmark","default":"REGAL SANRO"},{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}{% endschema %}
