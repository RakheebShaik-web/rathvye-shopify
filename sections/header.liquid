<header class="site-header" data-header>
  {% if section.settings.show_announcement %}<div class="announcement">{{ section.settings.announcement }}</div>{% endif %}
  <div class="header-inner page-width">
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu"><span></span><span></span><span class="visually-hidden">{{ 'general.menu' | t }}</span></button>
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 360 | image_tag: widths: '140,220,360', alt: shop.name }}{% else %}<span>RATHVYE</span><small>Defined by style</small>{% endif %}</a>
    <nav class="desktop-nav" aria-label="Primary">{% if section.settings.menu.links.size > 3 %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}{% else %}<a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">New arrivals</a><a href="{{ routes.all_products_collection_url }}">Dresses</a><a href="{{ routes.all_products_collection_url }}">Separates</a><a href="/pages/contact">Contact</a>{% endif %}</nav>
    <div class="header-actions"><button class="header-search" type="button" data-search-open aria-label="{{ 'general.search' | t }}"><svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span>{{ 'general.search' | t }}</span></button><a class="header-wishlist" href="/pages/wishlist" aria-label="Wishlist"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.8 4.8a5.4 5.4 0 0 0-7.7 0L12 5.9l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.5a5.4 5.4 0 0 0 0-7.7Z"/></svg><span class="header-wishlist__label">Wishlist</span> <span data-wishlist-count>(0)</span></a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{{ 'general.account' | t }}</a>{% endif %}<button type="button" data-cart-open>{{ 'general.cart' | t }} <span data-cart-count aria-label="{{ cart.item_count }} items">({{ cart.item_count }})</span></button></div>
  </div>
  <nav id="MobileMenu" class="mobile-menu" data-mobile-menu hidden aria-label="Mobile">{% if section.settings.menu.links.size > 0 %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">New arrivals</a><a href="/pages/contact">Contact</a>{% endif %}<a href="/pages/wishlist">Wishlist <span data-wishlist-count>(0)</span></a><button type="button" data-search-open>{{ 'general.search' | t }}</button></nav>
  <div class="search-overlay" data-search-overlay hidden><button class="search-overlay__backdrop" type="button" data-search-close aria-label="{{ 'accessibility.close' | t }}"></button><div class="search-overlay__panel" role="dialog" aria-modal="true" aria-labelledby="SearchTitle"><header><p id="SearchTitle">{{ 'search.title' | t }}</p><button type="button" data-search-close aria-label="{{ 'accessibility.close' | t }}">×</button></header><form action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="PredictiveSearchInput">{{ 'search.placeholder' | t }}</label><input id="PredictiveSearchInput" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off" data-predictive-input><input type="hidden" name="type" value="product"><button type="submit">{{ 'search.submit' | t }}</button></form><div class="search-overlay__results" data-predictive-results aria-live="polite"></div></div></div>
</header>
{% stylesheet %}
  .site-header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--ivory) 78%,transparent);border-bottom:1px solid color-mix(in srgb,var(--ivory) 55%,transparent);box-shadow:inset 0 1px 0 rgba(255,255,255,.46);backdrop-filter:blur(18px) saturate(115%)}.announcement{padding:.55rem 1rem;text-align:center;background:var(--coffee);color:var(--ivory);text-transform:uppercase;letter-spacing:.16em;font-size:.62rem}.header-inner{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:92px}.wordmark{text-align:center;line-height:1}.wordmark span{display:block;font-family:Georgia,serif;font-size:1.35rem;letter-spacing:.45em;margin-right:-.45em}.wordmark small{display:block;margin-top:.55rem;text-transform:uppercase;letter-spacing:.34em;font-size:.48rem}.wordmark img{max-height:64px;width:auto}.desktop-nav{display:flex;gap:2rem}.desktop-nav a,.header-actions a,.header-actions button{text-transform:uppercase;letter-spacing:.14em;font-size:.66rem}.header-actions{display:flex;justify-content:flex-end;gap:1.5rem}.header-actions button{border:0;background:transparent;padding:0;color:inherit;cursor:pointer}.menu-toggle{display:none;border:0;background:transparent;padding:.5rem}.menu-toggle span:not(.visually-hidden){display:block;width:22px;height:1px;background:currentColor;margin:5px}.mobile-menu{position:fixed;inset:0;top:calc(92px + 31px);z-index:25;background:var(--lilac);padding:3rem 1.5rem;overflow:auto}.mobile-menu a,.mobile-menu>button{display:block;width:100%;padding:1rem 0;border:0;border-bottom:1px solid color-mix(in srgb,var(--coffee) 20%,transparent);background:transparent;text-align:left;font-family:Georgia,serif;font-size:2rem}.desktop-nav a,.header-actions a,.header-actions button{position:relative}.desktop-nav a::after,.header-actions a::after,.header-actions button::after{content:"";position:absolute;left:0;right:0;bottom:-.4rem;height:1px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform .45s var(--ease)}.desktop-nav a:hover::after,.desktop-nav a[aria-current=page]::after,.header-actions a:hover::after,.header-actions button:hover::after{transform:scaleX(1);transform-origin:left}.search-overlay{position:fixed;inset:0;z-index:70}.search-overlay__backdrop{position:absolute;inset:0;width:100%;border:0;background:rgba(33,29,25,.28);backdrop-filter:blur(5px)}.search-overlay__panel{position:relative;width:min(780px,calc(100% - 2rem));margin:clamp(5rem,12vh,9rem) auto;background:var(--ivory);padding:1.5rem;box-shadow:0 30px 90px rgba(75,54,33,.18)}.search-overlay__panel>header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem}.search-overlay__panel>header p{margin:0;text-transform:uppercase;letter-spacing:.15em;font-size:.64rem}.search-overlay__panel>header button{border:0;background:transparent;font-size:1.5rem}.search-overlay__panel form{display:grid;grid-template-columns:1fr auto;border-bottom:1px solid var(--coffee)}.search-overlay__panel input{border:0;background:transparent;padding:1rem 0;font-family:Georgia,serif;font-size:clamp(1.5rem,4vw,2.5rem);min-width:0}.search-overlay__panel form button{border:0;background:transparent;text-transform:uppercase;letter-spacing:.14em;font-size:.62rem}.search-overlay__results{margin-top:1.5rem;max-height:52vh;overflow:auto}
  @media(max-width:899px){.announcement{padding:.48rem .75rem;font-size:.53rem;letter-spacing:.13em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.header-inner{grid-template-columns:1fr auto 1fr;min-height:68px}.desktop-nav{display:none}.menu-toggle{display:block;justify-self:start;margin-left:-.5rem}.header-actions{gap:0}.header-actions a{display:none}.header-actions button:first-child{display:none}.header-actions button:last-child{font-size:.61rem}.wordmark span{font-size:1.08rem;letter-spacing:.38em;margin-right:-.38em}.wordmark small{margin-top:.42rem;font-size:.41rem;letter-spacing:.28em}.wordmark img{max-height:48px;max-width:170px}.mobile-menu{top:calc(68px + 29px);padding:2rem 1.25rem 4rem;background:color-mix(in srgb,var(--ivory) 94%,var(--lilac));overscroll-behavior:contain}.mobile-menu a,.mobile-menu>button{padding:1rem 0;font-size:clamp(1.75rem,9vw,2.65rem);line-height:1.05}.search-overlay__panel{width:calc(100% - 1rem);margin:4.5rem auto 0;padding:1.1rem}.search-overlay__panel input{font-size:1.35rem}.search-overlay__results{max-height:60vh}}
  .header-search{display:inline-flex!important;align-items:center;gap:.45rem}.header-search svg{flex:none}
  .header-wishlist{display:inline-flex;align-items:center;gap:.35rem}.header-wishlist svg{width:17px;height:17px;fill:transparent;stroke:currentColor;stroke-width:1.4}
  @media(max-width:899px){.header-actions{gap:.8rem;align-items:center}.header-actions .header-search{display:inline-grid!important;place-items:center}.header-search span{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important}.header-actions .header-search::after{display:none}}
  {% endstylesheet %}
<style>
  .desktop-nav a,.header-actions a,.header-actions button{font-size:.72rem;letter-spacing:.105em;font-weight:500}
  .header-inner{column-gap:2rem}
  @media(max-width:899px){
    .site-header{backdrop-filter:blur(20px) saturate(120%)}
    .header-inner{min-height:64px}
    .mobile-menu{top:calc(64px + 29px);display:flex;flex-direction:column}
    .mobile-menu[hidden]{display:none}
    .mobile-menu a,.mobile-menu>button{min-height:58px;display:flex;align-items:center}
    .header-actions button:last-child{min-height:44px;padding-inline:.35rem}
    .header-actions .header-wishlist{display:inline-grid;place-items:center;min-width:44px;min-height:44px;padding:0}.header-wishlist__label,.header-actions .header-wishlist [data-wishlist-count]{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important}
    .menu-toggle{min-width:44px;min-height:44px}
  }
</style>
{% schema %}{"name":"Header","settings":[{"type":"checkbox","id":"show_announcement","label":"Show announcement","default":true},{"type":"text","id":"announcement","label":"Announcement","default":"Free shipping across India on prepaid orders"},{"type":"image_picker","id":"logo","label":"Logo"},{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}{% endschema %}
