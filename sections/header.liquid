<header class="site-header" data-header><div class="header-inner page-width"><button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu" aria-label="Menu"><span></span><span></span></button><a class="wordmark" href="{{ routes.root_url }}">RATHVYE</a><nav class="desktop-nav" aria-label="Primary"><a href="/collections/new-arrivals">New arrivals</a><div class="nav-dropdown"><a href="/collections/womens">Dresses <span>⌄</span></a><div class="nav-dropdown__menu"><a href="/collections/womens">Tops</a><a href="/collections/womens">Bottoms</a><a href="/collections/womens">Denim</a><a href="/collections/womens">Kurtis</a><a href="/collections/womens">Dresses</a><a href="/collections/womens">Party fits</a><a href="/collections/seasonal-outfit">Festive wear</a></div></div><a href="/collections/womens">Co-ord sets</a><a href="/collections/seasonal-outfit">Occasionwear</a></nav><div class="header-actions"><button type="button" data-search-open aria-label="Search"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.5"/><path d="m16 16 4.2 4.2"/></svg></button>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="3.2"/><path d="M5.5 21c.4-5 2.7-7.4 6.5-7.4s6.1 2.4 6.5 7.4"/></svg></a>{% endif %}<a href="/pages/wishlist" aria-label="Wishlist" class="count-icon"><svg viewBox="0 0 24 24"><path d="M20.8 4.8a5.4 5.4 0 0 0-7.7 0L12 5.9l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.5a5.4 5.4 0 0 0 0-7.7Z"/></svg><b data-wishlist-count>0</b></a><button type="button" data-cart-open aria-label="Open bag" class="bag-action"><span>BAG</span><b data-cart-count>{{ cart.item_count }}</b></button></div></div><nav id="MobileMenu" class="mobile-menu" data-mobile-menu hidden><a href="/collections/new-arrivals">New arrivals</a><details><summary>Dresses</summary><a href="/collections/womens">Tops</a><a href="/collections/womens">Bottoms</a><a href="/collections/womens">Denim</a><a href="/collections/womens">Kurtis</a><a href="/collections/womens">Dresses</a><a href="/collections/womens">Party fits</a><a href="/collections/seasonal-outfit">Festive wear</a></details><a href="/collections/womens">Co-ord sets</a><a href="/collections/seasonal-outfit">Occasionwear</a></nav><div class="search-overlay" data-search-overlay hidden><button class="search-overlay__backdrop" data-search-close aria-label="Close"></button><div class="search-overlay__panel"><header><p>What are you looking for?</p><button data-search-close aria-label="Close">×</button></header><form action="{{ routes.search_url }}" method="get"><input type="search" name="q" placeholder="Search products" data-predictive-input><input type="hidden" name="type" value="product"><button>Search</button></form><div data-predictive-results></div></div></div></header>
{% stylesheet %}.site-header{position:sticky;top:0;z-index:30;background:#fff;color:#000}.header-inner{height:90px;display:grid;grid-template-columns:200px 1fr 200px;align-items:center;gap:24px}.wordmark{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-size:24px;font-weight:700;letter-spacing:-.04em}.desktop-nav{display:flex;justify-content:center;align-items:stretch;gap:42px;height:100%}.desktop-nav>a,.nav-dropdown>a{position:relative;display:flex;align-items:center;font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:.09em;white-space:nowrap}.desktop-nav>a:after,.nav-dropdown>a:after{content:"";position:absolute;left:0;right:0;bottom:24px;height:1px;background:#000;transform:scaleX(0);transition:transform .3s}.desktop-nav>a:hover:after,.nav-dropdown:hover>a:after{transform:scaleX(1)}.nav-dropdown{position:relative;display:flex}.nav-dropdown__menu{position:absolute;left:-28px;top:76px;width:275px;padding:18px 28px;background:#fff;box-shadow:0 14px 30px rgba(0,0,0,.08);opacity:0;visibility:hidden;transform:translateY(8px);transition:.25s}.nav-dropdown:hover .nav-dropdown__menu,.nav-dropdown:focus-within .nav-dropdown__menu{opacity:1;visibility:visible;transform:none}.nav-dropdown__menu a{display:block;padding:10px 0;color:#777;font-size:16px;transition:color .2s,transform .2s}.nav-dropdown__menu a:hover{color:#000;transform:translateX(4px)}.header-actions{display:flex;justify-content:flex-end;align-items:center;gap:22px}.header-actions button,.header-actions>a{position:relative;display:grid;place-items:center;min-width:22px;height:28px;border:0;padding:0;background:none;color:#000;cursor:pointer}.header-actions svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.6}.count-icon b,.bag-action b{position:absolute;top:-7px;right:-10px;display:grid;place-items:center;min-width:18px;height:18px;border-radius:50%;background:#000;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:10px}.header-actions .bag-action{width:auto;min-width:48px}.bag-action span{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-size:14px;font-weight:600;letter-spacing:.1em}.menu-toggle{display:none}.mobile-menu{position:fixed;inset:67px 0 0;z-index:32;padding:18px 24px 50px;background:#fff;overflow:auto}.mobile-menu>a,.mobile-menu summary{display:block;padding:17px 0;border-bottom:1px solid #e6e6e6;font-size:24px;font-weight:300;list-style:none}.mobile-menu details a{display:block;padding:12px 18px;color:#666}.search-overlay{position:fixed;inset:0;z-index:70}.search-overlay__backdrop{position:absolute;inset:0;border:0;background:rgba(0,0,0,.35)}.search-overlay__panel{position:relative;width:min(780px,calc(100% - 30px));margin:100px auto;background:#fff;padding:28px}.search-overlay__panel header{display:flex;justify-content:space-between}.search-overlay__panel header p{margin:0;font-size:20px}.search-overlay__panel header button{border:0;background:none;font-size:26px}.search-overlay__panel form{display:grid;grid-template-columns:1fr auto;margin-top:24px;border-bottom:1px solid #000}.search-overlay__panel input,.search-overlay__panel form button{border:0;background:none;padding:14px 0}.search-overlay__panel form button{text-transform:uppercase;letter-spacing:.1em}@media(max-width:1050px){.site-header{position:static}.header-inner{grid-template-columns:1fr auto 1fr;height:67px}.desktop-nav{display:none}.menu-toggle{display:block;justify-self:start;width:28px;padding:0}.menu-toggle span{display:block;width:22px;height:1px;background:#000;margin:6px 0}.wordmark{justify-self:center;font-size:20px}.header-actions>a,.header-actions>button:not(.bag-action){display:none}.header-actions{gap:0}.header-actions .bag-action{display:grid}.bag-action span{font-size:13px}.page-width{width:min(calc(100% - 30px),1440px)}}{% endstylesheet %}
<style>.nav-dropdown>a>span,.nav-dropdown>a:before{display:none!important}</style>
