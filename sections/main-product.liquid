<section class="product page-width" data-product-section>
  <div class="product-gallery">{% for image in product.images %}{{ image | image_url: width: 1600 | image_tag: widths: '500,800,1100,1400,1600', loading: 'lazy', alt: image.alt }}{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endfor %}</div>
  <div class="product-info">
    <p class="eyebrow">{{ product.vendor | default: shop.name }}</p>
    <h1 class="display">{{ product.title }}</h1>
    <p class="product-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</p>
    {% form 'product', product, class: 'product-form' %}
      {% unless product.has_only_default_variant %}<div class="field"><label for="Variant-{{ section.id }}">Choose an option</label><select id="Variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — {{ 'product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select></div>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
      <div class="field"><label for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric"></div>
      <button class="button product-submit" type="submit" data-add-button {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}{{ 'product.add_to_bag' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>
      {% if product.selected_or_first_available_variant.available %}<div class="accelerated-checkout">{{ form | payment_button }}</div>{% endif %}
    {% endform %}
    <div class="product-promises"><span>Secure checkout</span><span>Delivery across India</span><span>Support before and after purchase</span></div>
    <div class="rte product-description">{{ product.description }}</div>
    <div class="product-details">
      <details><summary>{{ 'product.size_guide' | t }}<span>+</span></summary><div class="detail-content"><p>{{ 'product.size_guide_intro' | t }}</p><div class="size-table"><span>XS</span><span>S</span><span>M</span><span>L</span><span>XL</span></div><p>{{ 'product.size_help' | t }}</p></div></details>
      <details><summary>{{ 'product.delivery' | t }}<span>+</span></summary><div class="detail-content"><p>{{ section.settings.delivery_text }}</p></div></details>
      <details><summary>{{ 'product.returns' | t }}<span>+</span></summary><div class="detail-content"><p>{{ section.settings.returns_text }}</p></div></details>
      <details><summary>{{ 'product.care' | t }}<span>+</span></summary><div class="detail-content"><p>{{ section.settings.care_text }}</p></div></details>
    </div>
    {% if shop.enabled_payment_types.size > 0 %}<div class="payment-types"><p>{{ 'product.secure_payments' | t }}</p><div>{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div></div>{% endif %}
  </div>
</section>
{% stylesheet %}
  .product .eyebrow,.product .button,.product .rte{color:inherit}.product .field{display:grid;gap:.45rem}.product .field label{text-transform:uppercase;letter-spacing:.16em;font-size:.68rem}.product .field input,.product .field select{width:100%;border:0;border-bottom:1px solid var(--coffee);border-radius:0;background:transparent;padding:.8rem 0;color:var(--ink)}.product{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(2rem,6vw,7rem);padding-block:5rem}.product-gallery{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.product-gallery img,.product-gallery svg{width:100%;background:var(--lilac)}.product-info{position:sticky;top:8rem;align-self:start;padding-top:2rem}.product-info .display{font-size:clamp(3rem,5vw,5.5rem);margin:.3rem 0 1rem}.product-price{font-family:Georgia,serif;font-size:1.2rem;margin-bottom:2.5rem}.product-form{display:grid;gap:1.35rem}.product-submit{width:100%;margin-top:.5rem}.product-submit:disabled{cursor:not-allowed;opacity:.45}.accelerated-checkout{margin-top:-.55rem}.product-promises{display:grid;gap:.65rem;margin-top:2rem;padding:1.4rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);text-transform:uppercase;letter-spacing:.12em;font-size:.58rem}.product-description{margin-top:2rem}.shopify-payment-button__button{border-radius:0!important;min-height:48px!important}.shopify-payment-button__more-options{font-size:.7rem!important}
  .product-details{margin-top:2rem;border-top:1px solid var(--line)}.product-details details{border-bottom:1px solid var(--line)}.product-details summary{display:flex;justify-content:space-between;cursor:pointer;padding:1rem 0;text-transform:uppercase;letter-spacing:.14em;font-size:.64rem;list-style:none}.product-details summary::-webkit-details-marker{display:none}.product-details details[open] summary span{transform:rotate(45deg)}.product-details summary span{transition:transform .25s ease}.detail-content{padding:0 0 1.2rem;color:color-mix(in srgb,var(--ink) 72%,transparent);line-height:1.6}.size-table{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--line);margin:1rem 0}.size-table span{text-align:center;padding:.7rem .2rem;border-right:1px solid var(--line)}.size-table span:last-child{border:0}.payment-types{margin-top:1.5rem}.payment-types p{text-transform:uppercase;letter-spacing:.14em;font-size:.58rem}.payment-types svg{width:38px;height:auto;margin-right:.3rem}
  @media(max-width:767px){.product{grid-template-columns:1fr;padding-top:1rem}.product-gallery{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.product-gallery>*{min-width:88%;scroll-snap-align:start}.product-info{position:static;padding-top:0}}
{% endstylesheet %}
{% javascript %}
  document.querySelectorAll('[data-product-section]').forEach(section=>{const select=section.querySelector('[data-variant-select]');const price=section.querySelector('[data-product-price]');const button=section.querySelector('[data-add-button]');if(!select||!price||!button)return;select.addEventListener('change',()=>{const option=select.options[select.selectedIndex];price.textContent=option.dataset.price;const available=option.dataset.available==='true';button.disabled=!available;button.textContent=available?'Add to bag':'Sold out'})})
{% endjavascript %}
{% schema %}{"name":"Main product","settings":[{"type":"textarea","id":"delivery_text","label":"Delivery information","default":"Delivery timing and charges are calculated at checkout. Final timing depends on destination and product availability."},{"type":"textarea","id":"returns_text","label":"Returns information","default":"Return and exchange eligibility will follow the store policy shown at checkout. Contact us before sending an item back."},{"type":"textarea","id":"care_text","label":"Care information","default":"Follow the care label attached to your garment. Store clean and dry, away from direct sunlight."}]}{% endschema %}
