<nav class="breadcrumbs page-width" aria-label="{{ 'general.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a><span aria-hidden="true">/</span><span>{{ product.title }}</span></nav>
<section class="product page-width" data-product-section>
  <div class="product-gallery-wrap{% if product.media.size == 1 %} product-gallery-wrap--single{% endif %}">
    <div class="product-gallery{% if product.media.size == 1 %} product-gallery--single{% endif %}" data-product-gallery>{% for media in product.media %}<button type="button" class="product-media" data-product-media="{{ media.id }}" data-zoom-src="{{ media.preview_image | image_url: width: 2000 }}" aria-label="{{ 'product.zoom_image' | t }} {{ forloop.index }}">{{ media.preview_image | image_url: width: 1600 | image_tag: widths: '500,800,1100,1400,1600', loading: 'lazy', alt: media.alt }}</button>{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endfor %}</div>
    {% if product.media.size > 1 %}<p class="product-gallery-count" aria-live="polite"><span data-gallery-current>1</span> / {{ product.media.size }}</p><div class="product-gallery-progress" aria-hidden="true"><i data-gallery-progress style="--gallery-progress:{{ 1.0 | divided_by: product.media.size | times: 100 }}%"></i></div>{% endif %}
  </div>
  <div class="product-info" data-reveal>
    <h1 class="display">{{ product.title }}</h1>
    <p class="product-price" data-product-price>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>{% endif %} {{ product.selected_or_first_available_variant.price | money }}</p>
    <button class="product-wishlist" type="button" data-wishlist-toggle data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}" data-product-url="{{ product.url }}" data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 }}{% endif %}" data-product-price="{{ product.price | money | escape }}" aria-label="Save {{ product.title | escape }} to wishlist" aria-pressed="false"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.8 4.8a5.4 5.4 0 0 0-7.7 0L12 5.9l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.5a5.4 5.4 0 0 0 0-7.7Z"/></svg><span data-wishlist-label>Save to wishlist</span></button>
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% if current_variant.inventory_management and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.low_stock_threshold %}<p class="low-stock" data-low-stock>{{ 'product.low_stock' | t: count: current_variant.inventory_quantity }}</p>{% endif %}
    {% if product != blank %}{% form 'product', product, class: 'product-form' %}
      {% unless product.has_only_default_variant %}
        <div class="variant-picker" data-variant-picker>
          {% for option in product.options_with_values %}
            {% assign option_name = option.name | downcase %}
            <fieldset class="variant-option" data-option-position="{{ option.position }}">
              <legend{% if option_name contains 'size' %} class="variant-option__size-legend"{% endif %}>{% unless option_name contains 'size' %}{{ option.name }}: <span data-option-label>{{ option.selected_value }}</span>{% else %}<span class="visually-hidden">{{ option.name }}</span><a class="size-help-link" href="/pages/size-guide">Size guide</a>{% endunless %}</legend>
              <div class="variant-option__values">
                {% for value in option.values %}
                  <button type="button" class="variant-pill{% if option_name contains 'color' or option_name contains 'colour' %} variant-pill--swatch{% endif %}" data-option-value="{{ value | escape }}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">{% if option_name contains 'color' or option_name contains 'colour' %}<span class="variant-swatch" style="--swatch:{{ value | escape }}" aria-hidden="true"></span>{% endif %}<span>{{ value }}</span></button>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        </div>
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
      {% else %}<input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>{% endunless %}
      <div class="field quantity-field"><label for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label><div class="quantity-stepper"><button type="button" data-quantity-minus aria-label="Decrease quantity">&minus;</button><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric"><button type="button" data-quantity-plus aria-label="Increase quantity">+</button></div></div>
      <p class="product-error" data-product-error role="alert" hidden></p>
      <button class="button product-submit" type="submit" data-add-button {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{{ 'product.add_to_bag' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>
      {% if section.settings.show_dynamic_checkout and current_variant.available %}<div class="accelerated-checkout">{{ form | payment_button }}</div>{% endif %}
    {% endform %}{% endif %}
    <form class="delivery-estimator" data-delivery-estimator novalidate><label for="DeliveryPin-{{ section.id }}">Check delivery</label><div><input id="DeliveryPin-{{ section.id }}" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="6" pattern="[0-9]{6}" placeholder="Enter 6-digit PIN code" aria-describedby="DeliveryResult-{{ section.id }}" required><button type="submit">Check</button></div><p id="DeliveryResult-{{ section.id }}" data-delivery-result aria-live="polite"></p></form>
    {% unless product.available %}{% form 'customer', class: 'back-in-stock' %}<input type="hidden" name="contact[tags]" value="back-in-stock,{{ product.handle }}"><input type="hidden" name="contact[body]" value="Back in stock request for {{ product.title | escape }}"><label for="BackInStockEmail">{{ 'product.back_in_stock' | t }}</label><div><input id="BackInStockEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required><button type="submit">{{ 'product.notify_me' | t }}</button></div>{% if form.posted_successfully? %}<p>{{ 'product.notify_success' | t }}</p>{% endif %}{{ form.errors | default_errors }}{% endform %}{% endunless %}
    <div class="product-promises"><span><i aria-hidden="true">◇</i>{{ 'product.secure_checkout' | t }}</span><span><i aria-hidden="true">↗</i>{{ 'product.india_delivery' | t }}</span><span><i aria-hidden="true">◌</i>{{ 'product.client_support' | t }}</span><span><i aria-hidden="true">◇</i>10 days return and exchange available</span></div>
    <div class="rte product-description">{{ product.description }}</div>
    <div class="product-details"><details><summary>{{ 'product.size_guide' | t }}<span>+</span></summary><div class="detail-content"><p>{{ 'product.size_guide_intro' | t }}</p><div class="size-table"><span>XS</span><span>S</span><span>M</span><span>L</span><span>XL</span></div><a href="/pages/size-guide">{{ 'product.full_size_guide' | t }}</a></div></details><details><summary>{{ 'product.care' | t }}<span>+</span></summary><div class="detail-content"><p>{{ section.settings.care_text }}</p></div></details></div>
    {% if shop.enabled_payment_types.size > 0 %}<div class="payment-types"><p>{{ 'product.secure_payments' | t }}</p><div>{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div></div>{% endif %}
  </div>
</section>
<div class="sticky-purchase" data-sticky-purchase><span><strong>{{ product.title }}</strong><small data-sticky-price>{{ current_variant.price | money }}</small></span><button type="button" class="button" data-sticky-add {% unless current_variant.available %}disabled{% endunless %}>{{ 'product.add_to_bag' | t }}</button></div>
<dialog class="zoom-dialog" data-zoom-dialog><button type="button" data-zoom-close aria-label="{{ 'accessibility.close' | t }}">×</button>{% if product.featured_image %}{{ product.featured_image | image_url: width: 2000 | image_tag: width: 2000, height: 2000, alt: product.featured_image.alt }}{% endif %}</dialog>
{% stylesheet %}.breadcrumbs{display:flex;flex-wrap:wrap;gap:.55rem;padding-top:1.5rem;text-transform:uppercase;letter-spacing:.1em;font-size:.55rem}.product .eyebrow,.product .button,.product .rte{color:inherit}.product .field{display:grid;gap:.45rem}.product .field label{text-transform:uppercase;letter-spacing:.16em;font-size:.68rem}.product .field input,.product .field select{width:100%;border:0;border-bottom:1px solid var(--coffee);border-radius:0;background:transparent;padding:.8rem 0;color:var(--ink)}.product{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:clamp(2rem,6vw,7rem);padding-block:3rem 5rem}.product-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;align-items:start}.product-media{display:block;width:100%;aspect-ratio:3/4;border:0;padding:0;background:#d8cec2;cursor:zoom-in;overflow:hidden}.product-media img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top;transition:transform .7s var(--ease)}.product-media:hover img{transform:scale(1.015)}.product-info{position:sticky;top:8rem;align-self:start;padding-top:2rem}.product-info .display{font-size:clamp(3rem,5vw,5.5rem);margin:.3rem 0 1rem}.product-price{font-family:Georgia,serif;font-size:1.2rem;margin-bottom:1rem}.product-price s{opacity:.5;margin-right:.4rem}.low-stock{color:#8a5130;font-size:.66rem;text-transform:uppercase;letter-spacing:.1em}.product-form{display:grid;gap:1.35rem}.product-submit{width:100%;margin-top:.5rem}.product-submit:disabled{cursor:not-allowed;opacity:.45}.product-error{color:#8a2330;margin:0}.accelerated-checkout{margin-top:-.55rem}.back-in-stock{margin-top:1.5rem}.back-in-stock>label{display:block;margin-bottom:.6rem;text-transform:uppercase;letter-spacing:.13em;font-size:.62rem}.back-in-stock>div{display:grid;grid-template-columns:1fr auto;border-bottom:1px solid var(--coffee)}.back-in-stock input,.back-in-stock button{border:0;background:transparent;padding:.8rem 0}.product-promises{display:grid;gap:.65rem;margin-top:2rem;padding:1.4rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);text-transform:uppercase;letter-spacing:.12em;font-size:.58rem}.product-description{margin-top:2rem}.product-details{margin-top:2rem;border-top:1px solid var(--line)}.product-details details{border-bottom:1px solid var(--line)}.product-details summary{display:flex;justify-content:space-between;cursor:pointer;padding:1rem 0;text-transform:uppercase;letter-spacing:.14em;font-size:.64rem;list-style:none}.product-details summary::-webkit-details-marker{display:none}.product-details details[open] summary span{transform:rotate(45deg)}.product-details summary span{transition:transform .25s ease}.detail-content{padding:0 0 1.2rem;color:color-mix(in srgb,var(--ink) 72%,transparent);line-height:1.6}.detail-content a{text-decoration:underline}.size-table{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--line);margin:1rem 0}.size-table span{text-align:center;padding:.7rem .2rem;border-right:1px solid var(--line)}.size-table span:last-child{border:0}.payment-types{margin-top:1.5rem}.payment-types p{text-transform:uppercase;letter-spacing:.14em;font-size:.58rem}.payment-types svg{width:38px;height:auto;margin-right:.3rem}.shopify-payment-button__button{border-radius:0!important;min-height:48px!important}.shopify-payment-button__more-options{font-size:.7rem!important}.sticky-purchase{display:none}.zoom-dialog{width:min(1100px,94vw);height:92vh;border:0;padding:2.5rem;background:var(--ivory)}.zoom-dialog::backdrop{background:rgba(33,29,25,.75);backdrop-filter:blur(8px)}.zoom-dialog img{width:100%;height:100%;object-fit:contain}.zoom-dialog button{position:absolute;right:1rem;top:.5rem;border:0;background:transparent;font-size:2rem}
@media(max-width:767px){.breadcrumbs{padding-top:.9rem}.product{display:block;padding-block:.75rem 7rem}.product-gallery{display:flex;gap:.7rem;margin-inline:-16px;padding-inline:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.product-gallery::-webkit-scrollbar{display:none}.product-gallery>*{flex:0 0 86%;min-width:0;scroll-snap-align:center}.product-info{position:static;padding-top:1.8rem}.product-info .display{font-size:clamp(2.5rem,12vw,3.5rem);line-height:.92}.product-form{gap:1.1rem}.product-promises{margin-top:1.5rem}.product-description{margin-top:1.6rem}.sticky-purchase{position:fixed;display:flex;align-items:center;justify-content:space-between;gap:1rem;left:0;right:0;bottom:0;z-index:35;padding:.7rem 1rem max(.7rem,env(safe-area-inset-bottom));background:color-mix(in srgb,var(--ivory) 92%,transparent);border-top:1px solid var(--line);box-shadow:0 -12px 35px rgba(75,54,33,.08);backdrop-filter:blur(16px)}.sticky-purchase span{min-width:0}.sticky-purchase span strong,.sticky-purchase span small{display:block;max-width:48vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sticky-purchase span strong{font-size:.62rem;text-transform:uppercase;letter-spacing:.07em}.sticky-purchase span small{font-size:.65rem}.sticky-purchase .button{flex:0 0 auto;min-height:42px;padding:.6rem 1rem}.zoom-dialog{padding:2rem .5rem}}
.variant-picker{display:grid;gap:1.1rem}.variant-option{min-width:0;margin:0;padding:0;border:0}.variant-option legend{margin-bottom:.65rem;text-transform:uppercase;letter-spacing:.14em;font-size:.62rem}.variant-option legend span{font-weight:600}.variant-option__values{display:flex;flex-wrap:wrap;gap:.55rem}.variant-pill{position:relative;min-width:46px;min-height:42px;padding:.6rem .85rem;border:1px solid var(--line);background:transparent;color:var(--ink);cursor:pointer;transition:border-color .25s ease,background .25s ease,color .25s ease,transform .25s ease}.variant-pill:hover{border-color:var(--coffee)}.variant-pill[aria-pressed=true]{border-color:var(--coffee);background:var(--coffee);color:var(--ivory)}.variant-pill:disabled{opacity:.3;cursor:not-allowed;text-decoration:line-through}.variant-pill--swatch{display:inline-flex;align-items:center;gap:.5rem;padding-inline:.65rem .85rem}.variant-swatch{width:18px;height:18px;border:1px solid color-mix(in srgb,var(--ink) 20%,transparent);border-radius:50%;background:var(--swatch)}.variant-pill[aria-pressed=true] .variant-swatch{box-shadow:0 0 0 2px var(--coffee),0 0 0 3px var(--ivory)}
.product .button{color:var(--ivory)}.product .button:hover{color:var(--coffee)}
.quantity-stepper{display:grid;grid-template-columns:46px minmax(54px,72px) 46px;width:max-content;border:1px solid var(--line)}.product .field .quantity-stepper input{width:100%;padding:.65rem .25rem;border:0;text-align:center;appearance:textfield}.quantity-stepper input::-webkit-inner-spin-button,.quantity-stepper input::-webkit-outer-spin-button{margin:0;appearance:none}.quantity-stepper button{border:0;background:transparent;color:var(--ink);font-size:1.15rem;cursor:pointer;transition:background .2s,color .2s}.quantity-stepper button:hover,.quantity-stepper button:active{background:var(--coffee);color:var(--ivory)}
@media(max-width:767px){.product .button:active{background:transparent;color:var(--coffee);transform:scale(.985)}.sticky-purchase{padding-bottom:max(.7rem,env(safe-area-inset-bottom));-webkit-backdrop-filter:blur(18px) saturate(115%);backdrop-filter:blur(18px) saturate(115%)}.variant-option__values{gap:.45rem}.variant-pill{min-width:44px;min-height:40px;padding:.55rem .7rem}}
{% endstylesheet %}
<style>
  @media(min-width:768px){
    .product-gallery-wrap--single{position:sticky;top:8rem;align-self:start}
    .product-gallery--single{position:static;grid-template-columns:1fr;max-height:calc(100dvh - 10rem)}
    .product-gallery--single .product-media{aspect-ratio:auto;height:calc(100dvh - 10rem);min-height:620px;max-height:880px;background:#ded5cc}
    .product-gallery--single .product-media img{object-fit:contain;object-position:center top}
  }
  .product-details,.product-details details{display:block;width:100%}
  .product-details summary{width:100%}
  .product-details summary span{margin-left:auto}
  .product-gallery-wrap{position:relative;min-width:0}
  .product-info[data-reveal]{opacity:0;transform:translateY(16px);transition:opacity .62s var(--ease),transform .72s var(--ease)}.product-info[data-visible=true]{opacity:1;transform:none}
  .product-gallery-count{display:none}
  .product-gallery-progress{display:none}.product-gallery-progress i{display:block;width:var(--gallery-progress);height:100%;background:var(--coffee);transition:width .55s var(--ease)}
  .size-help-link{float:right;margin-left:1rem;color:inherit;text-decoration:underline;text-underline-offset:4px;font-size:.56rem;font-weight:400;letter-spacing:.1em}
  .variant-option__size-legend{width:100%;min-height:18px}.variant-option__size-legend .size-help-link{float:none;display:block;width:max-content;margin:0 0 0 auto}
  .delivery-estimator{margin-top:1.2rem}.delivery-estimator>label{display:block;margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.14em;font-size:.6rem}.delivery-estimator>div{display:grid;grid-template-columns:1fr auto;border:1px solid var(--line);background:color-mix(in srgb,var(--ivory) 70%,var(--lilac))}.delivery-estimator input,.delivery-estimator button{min-height:46px;border:0;background:transparent;color:var(--ink)}.delivery-estimator input{min-width:0;padding:.75rem 1rem}.delivery-estimator button{padding-inline:1rem;border-left:1px solid var(--line);text-transform:uppercase;letter-spacing:.12em;font-size:.58rem;cursor:pointer;transition:background .25s ease,color .25s ease}.delivery-estimator button:hover{background:var(--coffee);color:var(--ivory)}.delivery-estimator>p{min-height:1.3em;margin:.55rem 0 0;font-size:.66rem}.delivery-estimator[data-valid=false]>p{color:#8a2330}
  .product-promises span{display:flex;align-items:center;gap:.6rem}.product-promises i{display:grid;place-items:center;width:22px;height:22px;border:1px solid var(--line);border-radius:50%;font-style:normal;font-size:.7rem}
  .product-wishlist{display:inline-flex;align-items:center;gap:.6rem;margin:0 0 1.35rem;padding:.2rem 0;border:0;border-bottom:1px solid transparent;background:transparent;color:var(--ink);text-transform:uppercase;letter-spacing:.12em;font-size:.6rem;cursor:pointer;transition:border-color .25s ease}
  .product-wishlist:hover{border-bottom-color:currentColor}.product-wishlist svg{width:18px;height:18px;fill:transparent;stroke:currentColor;stroke-width:1.4}.product-wishlist[aria-pressed=true] svg{fill:currentColor}.product-wishlist[aria-pressed=true]{font-weight:600}.product-wishlist.is-celebrating svg{animation:product-heart-pop .52s var(--ease)}@keyframes product-heart-pop{45%{transform:scale(1.3) rotate(-7deg)}}
  @media(max-width:767px){
    .product-gallery--single{position:static;max-height:none}
    .product-gallery--single .product-media{height:auto;min-height:0;aspect-ratio:3/4}
    .product-gallery--single .product-media img{object-fit:cover}
    .product-gallery-count{position:absolute;right:.75rem;bottom:1.25rem;z-index:2;display:block;margin:0;padding:.45rem .65rem;background:color-mix(in srgb,var(--ivory) 84%,transparent);border:1px solid rgba(255,255,255,.55);font-size:.58rem;letter-spacing:.12em;font-variant-numeric:tabular-nums;backdrop-filter:blur(12px)}.product-gallery-progress{position:absolute;display:block;left:1rem;right:1rem;bottom:.35rem;height:2px;background:rgba(244,240,232,.55)}
    .sticky-purchase{opacity:0;transform:translateY(100%);pointer-events:none;transition:opacity .35s var(--ease),transform .45s var(--ease)}.sticky-purchase.is-visible{opacity:1;transform:none;pointer-events:auto}
  }
  @media(prefers-reduced-motion:reduce){.product-wishlist.is-celebrating svg{animation:none}.sticky-purchase{transition:none}}
</style>
{% javascript %}
document.querySelectorAll('[data-product-section]').forEach(section=>{
  const gallery=section.querySelector('[data-product-gallery]');
  const galleryCurrent=section.querySelector('[data-gallery-current]');
  const galleryProgress=section.querySelector('[data-gallery-progress]');
  if(gallery&&galleryCurrent){
    const media=[...gallery.querySelectorAll('[data-product-media]')];
    const updateGalleryCount=()=>{const center=gallery.scrollLeft+gallery.clientWidth/2;let closest=0;let distance=Infinity;media.forEach((item,index)=>{const itemCenter=item.offsetLeft+item.offsetWidth/2;const nextDistance=Math.abs(itemCenter-center);if(nextDistance<distance){distance=nextDistance;closest=index}});galleryCurrent.textContent=String(closest+1);galleryProgress?.style.setProperty('--gallery-progress',`${(closest+1)/media.length*100}%`)};
    gallery.addEventListener('scroll',updateGalleryCount,{passive:true});
    addEventListener('resize',updateGalleryCount,{passive:true});
  }
  const picker=section.querySelector('[data-variant-picker]');
  const variantInput=section.querySelector('[data-variant-id]');
  const variantsNode=section.querySelector('[data-variants-json]');
  const price=section.querySelector('[data-product-price]');
  const addButton=section.querySelector('[data-add-button]');
  const stickyButton=document.querySelector('[data-sticky-add]');
  const stickyPrice=document.querySelector('[data-sticky-price]');
  const currency=(window.Shopify&&Shopify.currency&&Shopify.currency.active)||'INR';
  const formatMoney=cents=>new Intl.NumberFormat(document.documentElement.lang||'en-IN',{style:'currency',currency}).format(cents/100);
  if(picker&&variantsNode){
    const variants=JSON.parse(variantsNode.textContent);
    const fields=[...picker.querySelectorAll('[data-option-position]')];
    const selections=()=>fields.map(field=>field.querySelector('[aria-pressed=true]')?.dataset.optionValue||'');
    const findVariant=options=>variants.find(variant=>variant.options.every((option,index)=>option===options[index]));
    const refresh=({scroll=true}={})=>{
      const selected=selections();
      fields.forEach((field,index)=>field.querySelectorAll('[data-option-value]').forEach(pill=>{
        const candidate=[...selected];candidate[index]=pill.dataset.optionValue;
        pill.disabled=!variants.some(variant=>variant.available&&variant.options.every((option,position)=>option===candidate[position]));
      }));
      const variant=findVariant(selected);
      if(!variant)return;
      variantInput.value=variant.id;
      const available=Boolean(variant.available);
      const currentPrice=formatMoney(variant.price);
      price.innerHTML=variant.compare_at_price>variant.price?`<s>${formatMoney(variant.compare_at_price)}</s> ${currentPrice}`:currentPrice;
      if(stickyPrice)stickyPrice.textContent=currentPrice;
      addButton.disabled=!available;if(stickyButton)stickyButton.disabled=!available;
      addButton.textContent=available?'Add to bag':'Sold out';
      const mediaId=variant.featured_media&&variant.featured_media.id;
      if(scroll&&mediaId)section.querySelector(`[data-product-media="${mediaId}"]`)?.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});
      history.replaceState({},'',`${location.pathname}?variant=${variant.id}`);
    };
    picker.addEventListener('click',event=>{const pill=event.target.closest('[data-option-value]');if(!pill||pill.disabled)return;const field=pill.closest('[data-option-position]');field.querySelectorAll('[data-option-value]').forEach(button=>button.setAttribute('aria-pressed','false'));pill.setAttribute('aria-pressed','true');const label=field.querySelector('[data-option-label]');if(label)label.textContent=pill.dataset.optionValue;refresh()});
    refresh({scroll:false});
  }
  stickyButton?.addEventListener('click',()=>addButton.click());
  const quantity=section.querySelector('input[name="quantity"]');section.querySelector('[data-quantity-minus]')?.addEventListener('click',()=>{quantity.value=Math.max(1,(Number(quantity.value)||1)-1)});section.querySelector('[data-quantity-plus]')?.addEventListener('click',()=>{quantity.value=(Number(quantity.value)||1)+1});
  const sticky=document.querySelector('[data-sticky-purchase]');
  if(sticky&&addButton&&'IntersectionObserver' in window){const stickyObserver=new IntersectionObserver(entries=>sticky.classList.toggle('is-visible',!entries[0].isIntersecting),{threshold:.15});stickyObserver.observe(addButton)}else sticky?.classList.add('is-visible');
  section.querySelector('[data-delivery-estimator]')?.addEventListener('submit',event=>{event.preventDefault();const form=event.currentTarget;const input=form.querySelector('input');const result=form.querySelector('[data-delivery-result]');const valid=/^[1-9][0-9]{5}$/.test(input.value.trim());form.dataset.valid=String(valid);result.textContent=valid?'Estimated delivery in 3–6 business days. Final timing is confirmed at checkout.':'Enter a valid 6-digit Indian PIN code.';if(!valid)input.focus()});
});
const dialog=document.querySelector('[data-zoom-dialog]');
document.querySelectorAll('[data-zoom-src]').forEach(button=>button.addEventListener('click',()=>{if(!dialog)return;dialog.querySelector('img').src=button.dataset.zoomSrc;dialog.showModal()}));
document.querySelector('[data-zoom-close]')?.addEventListener('click',()=>dialog.close());
dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});
{% endjavascript %}
