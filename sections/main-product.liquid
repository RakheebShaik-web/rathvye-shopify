<nav class="breadcrumbs page-width" aria-label="{{ 'general.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a><span aria-hidden="true">/</span><span>{{ product.title }}</span></nav>
<section class="product page-width" data-product-section>
  <div class="product-gallery" data-product-gallery>{% for media in product.media %}<button type="button" class="product-media" data-product-media="{{ media.id }}" data-zoom-src="{{ media.preview_image | image_url: width: 2000 }}" aria-label="{{ 'product.zoom_image' | t }} {{ forloop.index }}">{{ media.preview_image | image_url: width: 1600 | image_tag: widths: '500,800,1100,1400,1600', loading: 'lazy', alt: media.alt }}</button>{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endfor %}</div>
  <div class="product-info">
    <p class="eyebrow">{{ product.vendor | default: shop.name }}</p><h1 class="display">{{ product.title }}</h1>
    <p class="product-price" data-product-price>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>{% endif %} {{ product.selected_or_first_available_variant.price | money }}</p>
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% if current_variant.inventory_management and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.low_stock_threshold %}<p class="low-stock" data-low-stock>{{ 'product.low_stock' | t: count: current_variant.inventory_quantity }}</p>{% endif %}
    {% form 'product', product, class: 'product-form' %}
      {% unless product.has_only_default_variant %}<div class="field"><label for="Variant-{{ section.id }}">{{ 'product.choose_options' | t }}</label><select id="Variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}" data-inventory="{{ variant.inventory_quantity }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — {{ 'product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select></div>{% else %}<input type="hidden" name="id" value="{{ current_variant.id }}">{% endunless %}
      <div class="field"><label for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric"></div>
      <p class="product-error" data-product-error role="alert" hidden></p>
      <button class="button product-submit" type="submit" data-add-button {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{{ 'product.add_to_bag' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>
      {% if current_variant.available %}<div class="accelerated-checkout">{{ form | payment_button }}</div>{% endif %}
    {% endform %}
    {% unless product.available %}{% form 'customer', class: 'back-in-stock' %}<input type="hidden" name="contact[tags]" value="back-in-stock,{{ product.handle }}"><input type="hidden" name="contact[body]" value="Back in stock request for {{ product.title | escape }}"><label for="BackInStockEmail">{{ 'product.back_in_stock' | t }}</label><div><input id="BackInStockEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required><button type="submit">{{ 'product.notify_me' | t }}</button></div>{% if form.posted_successfully? %}<p>{{ 'product.notify_success' | t }}</p>{% endif %}{{ form.errors | default_errors }}{% endform %}{% endunless %}
    <div class="product-promises"><span>{{ 'product.secure_checkout' | t }}</span><span>{{ 'product.india_delivery' | t }}</span><span>{{ 'product.client_support' | t }}</span></div>
    <div class="rte product-description">{{ product.description }}</div>
    <div class="product-details"><details><summary>{{ 'product.size_guide' | t }}<span>+</span></summary><div class="detail-content"><p>{{ 'product.size_guide_intro' | t }}</p><div class="size-table"><span>XS</span><span>S</span><span>M</span><span>L</span><span>XL</span></div><a href="/pages/size-guide">{{ 'product.full_size_guide' | t }}</a></div></details><details><summary>{{ 'product.delivery' | t }}<span>+</span></summary><div class="detail-content"><p>{{ section.settings.delivery_text }}</p></div></details><details><summary>{{ 'product.returns' | t }}<span>+</span></summary><div class="detail-content"><p>{{ section.settings.returns_text }}</p></div></details><details><summary>{{ 'product.care' | t }}<span>+</span></summary><div class="detail-content"><p>{{ section.settings.care_text }}</p></div></details></div>
    {% if shop.enabled_payment_types.size > 0 %}<div class="payment-types"><p>{{ 'product.secure_payments' | t }}</p><div>{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div></div>{% endif %}
  </div>
</section>
<div class="sticky-purchase" data-sticky-purchase><span><strong>{{ product.title }}</strong><small data-sticky-price>{{ current_variant.price | money }}</small></span><button type="button" class="button" data-sticky-add {% unless current_variant.available %}disabled{% endunless %}>{{ 'product.add_to_bag' | t }}</button></div>
<dialog class="zoom-dialog" data-zoom-dialog><button type="button" data-zoom-close aria-label="{{ 'accessibility.close' | t }}">×</button>{% if product.featured_image %}{{ product.featured_image | image_url: width: 2000 | image_tag: width: 2000, height: 2000, alt: product.featured_image.alt }}{% endif %}</dialog>
{% stylesheet %}.breadcrumbs{display:flex;flex-wrap:wrap;gap:.55rem;padding-top:1.5rem;text-transform:uppercase;letter-spacing:.1em;font-size:.55rem}.product .eyebrow,.product .button,.product .rte{color:inherit}.product .field{display:grid;gap:.45rem}.product .field label{text-transform:uppercase;letter-spacing:.16em;font-size:.68rem}.product .field input,.product .field select{width:100%;border:0;border-bottom:1px solid var(--coffee);border-radius:0;background:transparent;padding:.8rem 0;color:var(--ink)}.product{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:clamp(2rem,6vw,7rem);padding-block:3rem 5rem}.product-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;align-items:start}.product-media{display:block;width:100%;aspect-ratio:3/4;border:0;padding:0;background:#d8cec2;cursor:zoom-in;overflow:hidden}.product-media img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top;transition:transform .7s var(--ease)}.product-media:hover img{transform:scale(1.015)}.product-info{position:sticky;top:8rem;align-self:start;padding-top:2rem}.product-info .display{font-size:clamp(3rem,5vw,5.5rem);margin:.3rem 0 1rem}.product-price{font-family:Georgia,serif;font-size:1.2rem;margin-bottom:1rem}.product-price s{opacity:.5;margin-right:.4rem}.low-stock{color:#8a5130;font-size:.66rem;text-transform:uppercase;letter-spacing:.1em}.product-form{display:grid;gap:1.35rem}.product-submit{width:100%;margin-top:.5rem}.product-submit:disabled{cursor:not-allowed;opacity:.45}.product-error{color:#8a2330;margin:0}.accelerated-checkout{margin-top:-.55rem}.back-in-stock{margin-top:1.5rem}.back-in-stock>label{display:block;margin-bottom:.6rem;text-transform:uppercase;letter-spacing:.13em;font-size:.62rem}.back-in-stock>div{display:grid;grid-template-columns:1fr auto;border-bottom:1px solid var(--coffee)}.back-in-stock input,.back-in-stock button{border:0;background:transparent;padding:.8rem 0}.product-promises{display:grid;gap:.65rem;margin-top:2rem;padding:1.4rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);text-transform:uppercase;letter-spacing:.12em;font-size:.58rem}.product-description{margin-top:2rem}.product-details{margin-top:2rem;border-top:1px solid var(--line)}.product-details details{border-bottom:1px solid var(--line)}.product-details summary{display:flex;justify-content:space-between;cursor:pointer;padding:1rem 0;text-transform:uppercase;letter-spacing:.14em;font-size:.64rem;list-style:none}.product-details summary::-webkit-details-marker{display:none}.product-details details[open] summary span{transform:rotate(45deg)}.product-details summary span{transition:transform .25s ease}.detail-content{padding:0 0 1.2rem;color:color-mix(in srgb,var(--ink) 72%,transparent);line-height:1.6}.detail-content a{text-decoration:underline}.size-table{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--line);margin:1rem 0}.size-table span{text-align:center;padding:.7rem .2rem;border-right:1px solid var(--line)}.size-table span:last-child{border:0}.payment-types{margin-top:1.5rem}.payment-types p{text-transform:uppercase;letter-spacing:.14em;font-size:.58rem}.payment-types svg{width:38px;height:auto;margin-right:.3rem}.shopify-payment-button__button{border-radius:0!important;min-height:48px!important}.shopify-payment-button__more-options{font-size:.7rem!important}.sticky-purchase{display:none}.zoom-dialog{width:min(1100px,94vw);height:92vh;border:0;padding:2.5rem;background:var(--ivory)}.zoom-dialog::backdrop{background:rgba(33,29,25,.75);backdrop-filter:blur(8px)}.zoom-dialog img{width:100%;height:100%;object-fit:contain}.zoom-dialog button{position:absolute;right:1rem;top:.5rem;border:0;background:transparent;font-size:2rem}
@media(max-width:767px){.breadcrumbs{padding-top:.9rem}.product{display:block;padding-block:.75rem 7rem}.product-gallery{display:flex;gap:.7rem;margin-inline:-16px;padding-inline:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.product-gallery::-webkit-scrollbar{display:none}.product-gallery>*{flex:0 0 86%;min-width:0;scroll-snap-align:center}.product-info{position:static;padding-top:1.8rem}.product-info .display{font-size:clamp(2.5rem,12vw,3.5rem);line-height:.92}.product-form{gap:1.1rem}.product-promises{margin-top:1.5rem}.product-description{margin-top:1.6rem}.sticky-purchase{position:fixed;display:flex;align-items:center;justify-content:space-between;gap:1rem;left:0;right:0;bottom:0;z-index:35;padding:.7rem 1rem max(.7rem,env(safe-area-inset-bottom));background:color-mix(in srgb,var(--ivory) 92%,transparent);border-top:1px solid var(--line);box-shadow:0 -12px 35px rgba(75,54,33,.08);backdrop-filter:blur(16px)}.sticky-purchase span{min-width:0}.sticky-purchase span strong,.sticky-purchase span small{display:block;max-width:48vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sticky-purchase span strong{font-size:.62rem;text-transform:uppercase;letter-spacing:.07em}.sticky-purchase span small{font-size:.65rem}.sticky-purchase .button{flex:0 0 auto;min-height:42px;padding:.6rem 1rem}.zoom-dialog{padding:2rem .5rem}}
.product .button{color:var(--ivory)}.product .button:hover{color:var(--coffee)}
@media(max-width:767px){.product .button:active{background:transparent;color:var(--coffee);transform:scale(.985)}}
{% endstylesheet %}
{% javascript %}document.querySelectorAll('[data-product-section]').forEach(section=>{const select=section.querySelector('[data-variant-select]');const price=section.querySelector('[data-product-price]');const button=section.querySelector('[data-add-button]');const stickyButton=document.querySelector('[data-sticky-add]');const stickyPrice=document.querySelector('[data-sticky-price]');if(select&&price&&button)select.addEventListener('change',()=>{const option=select.options[select.selectedIndex];price.innerHTML=option.dataset.comparePrice?`<s>${option.dataset.comparePrice}</s> ${option.dataset.price}`:option.dataset.price;if(stickyPrice)stickyPrice.textContent=option.dataset.price;const available=option.dataset.available==='true';button.disabled=!available;if(stickyButton)stickyButton.disabled=!available;button.textContent=available?'Add to bag':'Sold out';if(option.dataset.mediaId)section.querySelector(`[data-product-media="${option.dataset.mediaId}"]`)?.scrollIntoView({behavior:'smooth',block:'nearest'})});stickyButton?.addEventListener('click',()=>button.click())});const dialog=document.querySelector('[data-zoom-dialog]');document.querySelectorAll('[data-zoom-src]').forEach(button=>button.addEventListener('click',()=>{if(!dialog)return;dialog.querySelector('img').src=button.dataset.zoomSrc;dialog.showModal()}));document.querySelector('[data-zoom-close]')?.addEventListener('click',()=>dialog.close());dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()}){% endjavascript %}
{% schema %}{"name":"Main product","settings":[{"type":"range","id":"low_stock_threshold","label":"Low stock threshold","min":1,"max":20,"step":1,"default":5},{"type":"textarea","id":"delivery_text","label":"Delivery information","default":"Delivery timing and charges are calculated at checkout. Final timing depends on destination and product availability."},{"type":"textarea","id":"returns_text","label":"Returns information","default":"Return and exchange eligibility will follow the store policy shown at checkout. Contact us before sending an item back."},{"type":"textarea","id":"care_text","label":"Care information","default":"Follow the care label attached to your garment. Store clean and dry, away from direct sunlight."}]}{% endschema %}
