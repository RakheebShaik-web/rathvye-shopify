<section class="search-page page-width"><h1 class="display">{{ 'search.title' | t }}</h1><form action="{{ routes.search_url }}" method="get" class="search-form" role="search"><div><label for="SearchInput">{{ 'search.placeholder' | t }}</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}"><input type="hidden" name="type" value="product"></div><button class="button" type="submit">{{ 'search.submit' | t }}</button></form>{% if search.performed %}<p class="search-count">{{ 'search.result_count' | t: count: search.results_count, terms: search.terms }}</p>{% paginate search.results by 24 %}<div class="search-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% else %}<div class="search-empty"><p>{{ 'search.no_results' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</section>
{% stylesheet %}.search-page .button{color:inherit}.search-page{padding-block:6rem}.search-page>.display{font-size:clamp(4rem,10vw,8rem);margin:0 0 3rem}.search-form{display:grid;grid-template-columns:1fr auto;gap:1.5rem;align-items:end;max-width:720px;margin-bottom:2rem}.search-count{margin-bottom:3rem;text-transform:uppercase;letter-spacing:.12em;font-size:.6rem}.search-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2.5rem 1.25rem}.search-empty{grid-column:1/-1;padding:5rem 0}.search-empty a{text-decoration:underline}.pagination{text-align:center;margin-top:4rem}@media(max-width:899px){.search-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.search-form{grid-template-columns:1fr}.search-form .button{width:100%}}{% endstylesheet %}
{% schema %}{"name":"Main search","settings":[]}{% endschema %}
