<section class="search-page page-width"><h1 class="display">{{ 'search.title' | t }}</h1><form action="{{ routes.search_url }}" method="get" class="search-form"><div class="field"><label for="SearchInput">{{ 'search.placeholder' | t }}</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}"></div><button class="button" type="submit">{{ 'search.submit' | t }}</button></form>{% if search.performed %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}<article><a href="{{ item.url }}"><div class="product-card-media">{% if item.featured_image %}{{ item.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: item.featured_image.alt }}{% endif %}</div><div class="product-meta"><h2>{{ item.title }}</h2><span>{{ item.price | money }}</span></div></a></article>{% endif %}{% else %}<p>{{ 'search.no_results' | t }}</p>{% endfor %}</div>{% endif %}</section>
{% stylesheet %}.button{color:inherit}.search-page{padding-block:6rem}.search-page>.display{font-size:clamp(4rem,10vw,8rem);margin:0 0 3rem}.search-form{display:grid;grid-template-columns:1fr auto;gap:1.5rem;align-items:end;max-width:720px;margin-bottom:5rem}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}.product-card-media{aspect-ratio:3/4;background:var(--lilac);overflow:hidden}.product-card-media img{width:100%;height:100%;object-fit:cover}.product-meta{display:flex;justify-content:space-between;gap:1rem;padding-top:1rem}.product-meta h2{font-size:.78rem;font-weight:400;margin:0}@media(max-width:899px){.product-grid{grid-template-columns:repeat(2,1fr)}}{% endstylesheet %}
{% schema %}{"name":"Main search","settings":[]}{% endschema %}
