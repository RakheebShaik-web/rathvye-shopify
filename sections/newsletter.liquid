<section class="newsletter page-width" data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="display">{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="field"><label for="NewsletterEmail">{{ 'newsletter.email' | t }}</label><input id="NewsletterEmail" type="email" name="contact[email]" autocomplete="email" required></div><button class="button" type="submit">{{ 'newsletter.submit' | t }}</button>{% if form.posted_successfully? %}<p>{{ 'newsletter.success' | t }}</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</section>
{% stylesheet %}
  .newsletter{padding-block:clamp(6rem,12vw,11rem);text-align:center;opacity:0;transform:translateY(20px);transition:1s var(--ease)}.newsletter[data-visible=true]{opacity:1;transform:none}.newsletter .display{font-size:clamp(3rem,7vw,7rem);margin:.25rem auto 1.5rem;max-width:10ch}.newsletter>p:not(.eyebrow){max-width:48ch;margin:0 auto 2.5rem}.newsletter-form{max-width:650px;margin:auto;display:grid;grid-template-columns:1fr auto;gap:1.5rem;align-items:end}.newsletter-form>p,.newsletter-form>ul{grid-column:1/-1;text-align:left}
  @media(max-width:520px){.newsletter-form{grid-template-columns:1fr}.newsletter-form .button{width:100%}}
  .newsletter-form{max-width:720px;padding:1.25rem 1.25rem 1.25rem 1.6rem;border:1px solid color-mix(in srgb,var(--ivory) 70%,transparent);background:color-mix(in srgb,var(--ivory) 58%,transparent);box-shadow:inset 0 1px 0 rgba(255,255,255,.74),0 24px 70px rgba(75,54,33,.08);backdrop-filter:blur(18px) saturate(112%)}
{% endstylesheet %}
{% schema %}
{"name":"Newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Private list"},{"type":"textarea","id":"heading","label":"Heading","default":"First look, before everyone else."},{"type":"textarea","id":"text","label":"Text","default":"Receive private previews, collection notes and early access to limited pieces."}],"presets":[{"name":"Newsletter"}]}
{% endschema %}
