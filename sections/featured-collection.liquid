<section class="featured page-width" data-featured-runway>
  <div class="section-heading" data-reveal>
    <div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}<h2 class="display">{{ section.settings.heading }}</h2></div>
    {% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }} →</a>{% endif %}
  </div>
  <div class="product-grid" data-auto-runway tabindex="0" aria-label="Featured products">
    {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
      <article class="product-card" data-runway-card>
        <a href="{{ product.url }}"><div class="product-card-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: widths: '360,600,900,1000', loading: 'lazy', alt: product.featured_image.alt }}{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}<span class="product-card-action">View piece</span></div><div class="product-meta"><h3>{{ product.title }}</h3><span>{{ product.price | money }}</span></div></a>
      </article>
    {% else %}
      {% for i in (1..4) %}{% liquid
        case i
          when 1
            assign look_image = section.settings.look_1
            assign look_title = section.settings.look_1_title
          when 2
            assign look_image = section.settings.look_2
            assign look_title = section.settings.look_2_title
          when 3
            assign look_image = section.settings.look_3
            assign look_title = section.settings.look_3_title
          when 4
            assign look_image = section.settings.look_4
            assign look_title = section.settings.look_4_title
        endcase
      %}
        <article class="product-card" data-runway-card>
          <a href="{{ routes.all_products_collection_url }}"><div class="product-card-media">{% if look_image != blank %}{{ look_image | image_url: width: 1200 | image_tag: widths: '360,600,900,1200', sizes: '(min-width: 900px) 30vw, 68vw', loading: 'lazy', alt: look_title }}{% else %}{{ 'product-apparel-' | append: i | placeholder_svg_tag }}{% endif %}<span class="product-card-action">View the look</span></div><div class="product-meta"><h3>{{ look_title }}</h3><span>Coming soon</span></div></a>
        </article>
      {% endfor %}
    {% endfor %}
  </div>
  <div class="runway-progress" aria-hidden="true"><i data-runway-progress></i></div>
</section>

{% stylesheet %}
  .featured{width:100%;max-width:none;padding:clamp(5rem,9vw,9rem) 0 clamp(6rem,11vw,11rem);overflow:hidden}.featured .section-heading{width:min(calc(100% - 48px),var(--page));margin:0 auto 2.5rem;display:flex;align-items:end;justify-content:space-between}.featured .section-heading .display{margin:0;font-size:clamp(2.8rem,6vw,5.5rem)}.featured .text-link{font-size:.68rem;letter-spacing:.15em;text-transform:uppercase}
  .featured .product-grid{display:flex!important;align-items:center!important;gap:clamp(1rem,2.3vw,2.5rem)!important;overflow-x:auto;padding:clamp(1.5rem,3.5vw,3.5rem) max(8vw,calc((100vw - 1440px)/2));scroll-snap-type:x mandatory;scrollbar-width:none;perspective:1400px}.featured .product-grid::-webkit-scrollbar{display:none}
  .featured .product-grid[data-flowing=true]{scroll-snap-type:none}
  .featured .product-card{position:relative;flex:0 0 clamp(260px,29vw,440px);margin:0!important;scroll-snap-align:center;opacity:.38!important;filter:saturate(.65);transform:scale(.84) translateY(1.8rem)!important;transition:opacity .85s var(--ease),filter .85s var(--ease),transform 1s var(--ease)!important}.featured .product-card::after{content:"";position:absolute;inset:8% -5% -8%;z-index:-1;background:rgba(75,54,33,.18);filter:blur(38px);opacity:0;transform:translateY(2rem);transition:opacity .9s var(--ease),transform .9s var(--ease)}.featured .product-card.is-active,.featured .product-card:hover,.featured .product-card:focus-within{z-index:2;opacity:1!important;filter:saturate(1);transform:scale(1) translateY(0)!important}.featured .product-card.is-active::after,.featured .product-card:hover::after{opacity:.28;transform:none}
  .featured .product-card-media{position:relative;aspect-ratio:3/4!important;overflow:hidden;background:#d8cec2}.featured .product-card-media::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 58%,rgba(20,12,17,.2));opacity:0;transition:opacity .8s var(--ease)}.featured .product-card-media img,.featured .product-card-media svg{width:100%;height:100%;object-fit:cover;object-position:center top;transform:scale(1.08);transition:transform 4.5s cubic-bezier(.2,.65,.2,1)}.featured .product-card.is-active img,.featured .product-card:hover img{transform:scale(1.015)}.featured .product-card.is-active .product-card-media::after,.featured .product-card:hover .product-card-media::after{opacity:1}
  .product-card-action{position:absolute;left:1rem;right:1rem;bottom:1rem;z-index:1;padding:.95rem;text-align:center;background:rgba(244,240,232,.86);color:var(--coffee);text-transform:uppercase;letter-spacing:.17em;font-size:.58rem;opacity:0;transform:translateY(14px);transition:opacity .5s var(--ease) .12s,transform .6s var(--ease) .12s;backdrop-filter:blur(14px)}.product-card.is-active .product-card-action,.product-card:hover .product-card-action,.product-card:focus-within .product-card-action{opacity:1;transform:none}
  .featured .product-meta{display:flex;justify-content:space-between;gap:1rem;padding-top:1rem;opacity:0;transform:translateY(.75rem);transition:opacity .55s var(--ease) .16s,transform .65s var(--ease) .16s}.featured .product-card.is-active .product-meta,.featured .product-card:hover .product-meta,.featured .product-card:focus-within .product-meta{opacity:1;transform:none}.featured .product-meta h3,.featured .product-meta span{margin:0;font-size:.72rem;font-weight:400}.featured .product-meta h3{text-transform:uppercase;letter-spacing:.08em}
  .runway-progress{display:none}
  .featured .product-card{transition-duration:.65s,.65s,.76s!important}.featured .product-card::after{transition-duration:.68s,.68s}
  @media(min-width:900px){.featured .product-grid{width:100%;margin-inline:auto;padding:3.5rem clamp(2rem,7vw,8rem)!important;overflow:hidden;align-items:center!important;scroll-snap-type:none}.featured .product-card{flex:0 0 clamp(190px,16vw,270px)!important;min-width:0;opacity:.78!important;filter:saturate(.88);transform:translateY(12px) scale(.95)!important;transition:opacity .48s var(--ease),filter .48s var(--ease),transform .62s var(--ease)!important}.featured .product-card.is-active,.featured .product-card:hover,.featured .product-card:focus-within{opacity:1!important;filter:saturate(1);transform:translateY(-18px) scale(1.08)!important}.featured .product-card-media{height:clamp(400px,40vw,610px);aspect-ratio:auto!important}}
  @media(max-width:899px){.featured .section-heading{width:calc(100% - 28px);margin-bottom:1rem}.featured .product-grid{padding-inline:16vw!important;gap:1rem!important}.featured .product-card{flex-basis:68vw}.featured .product-meta{display:block}.featured .product-meta span{display:block;margin-top:.3rem}}
  @media(prefers-reduced-motion:reduce){.runway-progress{display:none}.featured .product-card{opacity:1!important;filter:none;transform:none!important}.featured .product-meta{opacity:1;transform:none}}
{% endstylesheet %}

<script>
(()=>{
  const section=[...document.querySelectorAll('[data-featured-runway]')].find(node=>!node.querySelector('[data-auto-runway]')?.dataset.ready);
  const runway=section?.querySelector('[data-auto-runway]');
  if(!runway||runway.dataset.ready)return;
  runway.dataset.ready='true';
  const originals=[...runway.querySelectorAll('[data-runway-card]')];
  if(originals.length<2)return;
  const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop=matchMedia('(min-width:900px)');
  if(!desktop.matches||reduced){originals[0].classList.add('is-active');return}
  originals.forEach(card=>{const clone=card.cloneNode(true);clone.dataset.runwayClone='true';clone.setAttribute('aria-hidden','true');clone.querySelectorAll('a,button,input').forEach(node=>node.tabIndex=-1);runway.append(clone)});
  const cards=[...runway.querySelectorAll('[data-runway-card]')];
  let active=Math.min(2,originals.length-1),timer,animating=false,loopWidth=0;
  const mark=index=>cards.forEach((card,i)=>card.classList.toggle('is-active',i===index));
  const centerOf=index=>cards[index].offsetLeft-(runway.clientWidth-cards[index].offsetWidth)/2;
  const animateTo=(target,duration=560)=>{const start=runway.scrollLeft,distance=target-start,startTime=performance.now();animating=true;const step=time=>{const progress=Math.min(1,(time-startTime)/duration);const eased=1-Math.pow(1-progress,4);runway.scrollLeft=start+distance*eased;if(progress<1)requestAnimationFrame(step);else animating=false};requestAnimationFrame(step)};
  const advance=()=>{if(animating)return;active+=1;mark(active);animateTo(centerOf(active));if(active===originals.length){setTimeout(()=>{runway.scrollLeft-=loopWidth;active=0;mark(active)},580)}};
  const pause=()=>clearInterval(timer);const play=()=>{pause();timer=setInterval(advance,1050)};
  runway.addEventListener('pointerenter',pause);runway.addEventListener('pointerleave',play);runway.addEventListener('focusin',pause);runway.addEventListener('focusout',play);document.addEventListener('visibilitychange',()=>document.hidden?pause():play());
  requestAnimationFrame(()=>{loopWidth=cards[originals.length].offsetLeft-cards[0].offsetLeft;mark(active);runway.scrollLeft=centerOf(active);play()});
})();
</script>

{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The current edit"},{"type":"text","id":"heading","label":"Heading","default":"New arrivals"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products","min":4,"max":8,"step":1,"default":4},{"type":"header","content":"Preview looks"},{"type":"image_picker","id":"look_1","label":"Look 1"},{"type":"text","id":"look_1_title","label":"Look 1 title","default":"Crimson monogram blouse"},{"type":"image_picker","id":"look_2","label":"Look 2"},{"type":"text","id":"look_2_title","label":"Look 2 title","default":"Lime crystal gown"},{"type":"image_picker","id":"look_3","label":"Look 3"},{"type":"text","id":"look_3_title","label":"Look 3 title","default":"Lilac bow co-ord"},{"type":"image_picker","id":"look_4","label":"Look 4"},{"type":"text","id":"look_4_title","label":"Look 4 title","default":"Corset shirt dress"}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
