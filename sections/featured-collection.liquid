<section class="featured page-width">
  <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="display">{{ section.settings.heading }}</h2></div>{% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }} →</a>{% endif %}</div>
  <div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.products_to_show %}<article class="product-card" data-reveal><a href="{{ product.url }}"><div class="product-card-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: widths: '360,600,900', loading: 'lazy', alt: product.featured_image.alt }}{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</div><div class="product-meta"><h3>{{ product.title }}</h3><span>{{ product.price | money }}</span></div></a></article>{% else %}{% for i in (1..2) %}{% liquid
    case i
      when 1
        assign look_image = section.settings.look_1
        assign look_title = section.settings.look_1_title
      when 2
        assign look_image = section.settings.look_2
        assign look_title = section.settings.look_2_title
      when 3
        assign look_image = section.settings.look_3
        assign look_title = section.settings.look_3_title
      when 4
        assign look_image = section.settings.look_4
        assign look_title = section.settings.look_4_title
    endcase
  %}<article class="product-card" data-reveal><a href="{{ routes.all_products_collection_url }}"><div class="product-card-media">{% if look_image != blank %}{{ look_image | image_url: width: 1200 | image_tag: widths: '360,600,900,1200', sizes: '(min-width: 900px) 55vw, 50vw', loading: 'lazy', alt: look_title }}{% else %}{{ 'product-apparel-' | append: i | placeholder_svg_tag }}{% endif %}<span class="product-card-action">View the look</span></div><div class="product-meta"><h3>{{ look_title }}</h3><span>Coming soon</span></div></a></article>{% endfor %}{% endfor %}</div>
</section>
{% stylesheet %}
  .eyebrow,.text-link{color:inherit}.product-card-action{position:absolute;left:1rem;right:1rem;bottom:1rem;padding:.9rem;text-align:center;background:rgba(244,240,232,.86);color:var(--coffee);text-transform:uppercase;letter-spacing:.15em;font-size:.58rem;opacity:0;transform:translateY(10px);transition:opacity .4s var(--ease),transform .4s var(--ease);backdrop-filter:blur(12px)}.product-card-media{position:relative}.product-card:hover .product-card-action{opacity:1;transform:none}
  .featured{padding-bottom:clamp(6rem,12vw,12rem)}.section-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:3rem}.section-heading .display{font-size:clamp(2.7rem,6vw,5.4rem);margin:0}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}.product-card{opacity:0;transform:translateY(20px);transition:.8s var(--ease)}.product-card[data-visible=true]{opacity:1;transform:none}.product-card-media{aspect-ratio:3/4;background:var(--lilac);overflow:hidden}.product-card-media img,.product-card-media svg{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease)}.product-card:hover img{transform:scale(1.025)}.product-meta{display:flex;justify-content:space-between;gap:1rem;padding-top:1rem}.product-meta h3,.product-meta span{font-size:.78rem;font-weight:400;margin:0}.product-meta h3{text-transform:uppercase;letter-spacing:.08em}
  @media(max-width:899px){.product-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.section-heading{align-items:start;gap:1rem;flex-direction:column}.product-grid{gap:1rem}.product-meta{display:block}.product-meta span{display:block;margin-top:.3rem}}
  @media(min-width:900px){.product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(1rem,2.2vw,2.5rem);align-items:start}.product-card:nth-child(n){grid-column:auto;margin-top:0}.product-card-media{aspect-ratio:4/5}.product-card-media img{object-position:center top}}
{% endstylesheet %}
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The current edit"},{"type":"text","id":"heading","label":"Heading","default":"New arrivals"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products","min":2,"max":8,"step":1,"default":4},{"type":"header","content":"Preview looks"},{"type":"image_picker","id":"look_1","label":"Look 1"},{"type":"text","id":"look_1_title","label":"Look 1 title","default":"Crimson monogram blouse"},{"type":"image_picker","id":"look_2","label":"Look 2"},{"type":"text","id":"look_2_title","label":"Look 2 title","default":"Lime crystal gown"},{"type":"image_picker","id":"look_3","label":"Look 3"},{"type":"text","id":"look_3_title","label":"Look 3 title","default":"Lilac bow co-ord"},{"type":"image_picker","id":"look_4","label":"Look 4"},{"type":"text","id":"look_4_title","label":"Look 4 title","default":"Corset shirt dress"}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
