<section class="cart page-width">
  <header class="cart-header"><p class="eyebrow">RATHVYE</p><h1 class="display">{{ 'cart.title' | t }}</h1><span>{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span></header>
  {% if cart.item_count == 0 %}<div class="cart-empty"><p>Your bag is waiting for something memorable.</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div>{% else %}
    {% form 'cart', cart, class: 'cart-form' %}
      <div class="cart-lines">{% for item in cart.items %}<article class="cart-line">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: item.image.alt }}</a>{% endif %}<div class="cart-line__info"><a href="{{ item.url }}">{{ item.product.title }}</a>{% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title }}</p>{% endunless %}<a class="cart-remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div><label class="cart-quantity"><span>{{ 'product.quantity' | t }}</span><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric"></label><span class="cart-line__price">{{ item.final_line_price | money }}</span></article>{% endfor %}</div>
      <div class="cart-bottom"><div class="field"><label for="CartNote">Order note</label><textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea></div><div class="cart-summary"><p><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></p><small>Taxes and delivery are calculated at checkout.</small><button class="button button--secondary" type="submit" name="update">Update bag</button><button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button><a href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div></div>
    {% endform %}
  {% endif %}
</section>
{% stylesheet %}
  .cart .eyebrow,.cart .button{color:inherit}.cart{padding-block:clamp(4rem,8vw,7rem)}.cart-header{display:flex;align-items:end;justify-content:space-between;margin-bottom:4rem}.cart-header .eyebrow{align-self:start}.cart-header .display{font-size:clamp(3.5rem,8vw,7rem);margin:0}.cart-header>span{text-transform:uppercase;letter-spacing:.14em;font-size:.62rem}.cart-line{display:grid;grid-template-columns:130px 1fr 110px auto;gap:2rem;align-items:center;padding:1.5rem 0;border-top:1px solid var(--line)}.cart-line img{width:130px;aspect-ratio:3/4;object-fit:cover}.cart-line__info>p,.cart-remove{font-size:.72rem}.cart-remove{text-decoration:underline;text-underline-offset:3px}.cart-quantity{display:grid;gap:.4rem;text-transform:uppercase;letter-spacing:.12em;font-size:.55rem}.cart-quantity input{width:74px;padding:.6rem;border:1px solid var(--line);background:transparent}.cart-line__price{font-family:Georgia,serif}.cart-bottom{display:grid;grid-template-columns:1fr 420px;gap:5rem;padding-top:3rem;border-top:1px solid var(--line)}.cart-bottom>.field{max-width:520px}.cart-summary{text-align:right}.cart-summary p{display:flex;justify-content:space-between;font-family:Georgia,serif;font-size:1.2rem}.cart-summary small{display:block;margin-bottom:1.5rem}.cart-summary .button{width:100%;margin-top:.7rem}.cart-summary .button--secondary{background:transparent;color:var(--coffee)}.cart-summary>a{display:inline-block;margin-top:1.2rem;text-decoration:underline;text-underline-offset:4px}.cart-empty{max-width:580px;margin:auto;padding:5rem 0;text-align:center}.cart-empty p{font-family:Georgia,serif;font-size:clamp(1.8rem,4vw,3rem)}
  @media(max-width:720px){.cart-header{align-items:start;flex-direction:column;gap:1rem}.cart-line{grid-template-columns:80px 1fr auto;gap:1rem}.cart-line img{width:80px}.cart-quantity{grid-column:2}.cart-line__price{grid-row:1;grid-column:3}.cart-bottom{grid-template-columns:1fr;gap:2rem}.cart-summary{text-align:left}}
{% endstylesheet %}
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
