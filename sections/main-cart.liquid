<section class="cart page-width">
  <header class="cart-header"><p class="eyebrow">RATHVYE</p><h1 class="display">{{ 'cart.title' | t }}</h1><span>{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span></header>
  {% if cart.item_count == 0 %}<div class="cart-empty"><p>Your bag is waiting for something memorable.</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div>{% else %}
    {% form 'cart', cart, class: 'cart-form' %}
      <div class="cart-lines">{% for item in cart.items %}<article class="cart-line">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: item.image.alt }}</a>{% endif %}<div class="cart-line__info"><a href="{{ item.url }}">{{ item.product.title }}</a>{% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title }}</p>{% endunless %}<a class="cart-remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div><label class="cart-quantity"><span>{{ 'product.quantity' | t }}</span><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric"></label><span class="cart-line__price">{{ item.final_line_price | money }}</span></article>{% endfor %}</div>
      <div class="cart-bottom"><div class="field"><label for="CartNote">Order note</label><textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea></div><div class="cart-summary"><p><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></p><small>Taxes and delivery are calculated at checkout.</small><button class="button button--secondary" type="submit" name="update">Update bag</button><button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button><a href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div></div>
    {% endform %}
  {% endif %}
</section>
{% stylesheet %}
  .cart .eyebrow,.cart .button{color:inherit}.cart{padding-block:clamp(4rem,8vw,7rem)}.cart-header{display:flex;align-items:end;justify-content:space-between;margin-bottom:4rem}.cart-header .eyebrow{align-self:start}.cart-header .display{font-size:clamp(3.5rem,8vw,7rem);margin:0}.cart-header>span{text-transform:uppercase;letter-spacing:.14em;font-size:.62rem}.cart-line{display:grid;grid-template-columns:130px minmax(0,1fr) 110px auto;gap:2rem;align-items:center;padding:1.5rem 0;border-top:1px solid var(--line)}.cart-line img{display:block;width:130px;aspect-ratio:3/4;object-fit:cover;object-position:center top}.cart-line__info>a:first-child{font-family:Georgia,serif;font-size:1.05rem}.cart-line__info>p,.cart-remove{font-size:.72rem}.cart-remove{text-decoration:underline;text-underline-offset:3px}.cart-quantity{display:grid;gap:.4rem;text-transform:uppercase;letter-spacing:.12em;font-size:.55rem}.cart-quantity input{width:74px;padding:.6rem;border:1px solid var(--line);background:transparent}.cart-line__price{font-family:Georgia,serif;font-variant-numeric:tabular-nums;white-space:nowrap}.cart-bottom{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,420px);grid-template-areas:"note summary";gap:clamp(3rem,7vw,7rem);align-items:start;padding-top:3rem;border-top:1px solid var(--line)}.cart-bottom>.field{grid-area:note;width:100%;max-width:520px}.cart-bottom>.field label{display:block;margin-bottom:.75rem;text-transform:uppercase;letter-spacing:.14em;font-size:.6rem}.cart-bottom textarea{width:100%;min-height:120px;border:0;border-bottom:1px solid var(--coffee);border-radius:0;background:transparent;resize:vertical}.cart-summary{grid-area:summary;width:100%;text-align:right}.cart-summary p{display:flex;justify-content:space-between;gap:2rem;margin-top:0;font-family:Georgia,serif;font-size:1.2rem}.cart-summary small{display:block;margin-bottom:1.5rem}.cart-summary .button{display:flex;align-items:center;justify-content:center;width:100%;margin-top:.7rem}.cart-summary .button--secondary{background:transparent;color:var(--coffee)}.cart-summary>a{display:inline-block;margin-top:1.2rem;text-decoration:underline;text-underline-offset:4px}.cart-empty{max-width:580px;margin:auto;padding:5rem 0;text-align:center}.cart-empty p{font-family:Georgia,serif;font-size:clamp(1.8rem,4vw,3rem)}
  @media(max-width:720px){.cart{padding-block:2.5rem 6rem}.cart-header{align-items:start;flex-direction:column;gap:.45rem;margin-bottom:2rem}.cart-header .eyebrow{margin-bottom:.5rem}.cart-header .display{font-size:clamp(3rem,16vw,4.5rem);line-height:.9}.cart-header>span{margin-top:.5rem}.cart-line{grid-template-columns:88px minmax(0,1fr) auto;gap:.8rem 1rem;align-items:start;padding:1.15rem 0}.cart-line>a{grid-row:1/3}.cart-line img{width:88px}.cart-line__info{min-width:0}.cart-line__info>a:first-child{display:block;font-size:.93rem;line-height:1.2}.cart-line__info>p{margin:.35rem 0}.cart-quantity{grid-column:2;display:flex;align-items:center;gap:.8rem}.cart-quantity input{width:62px;padding:.5rem}.cart-line__price{grid-row:1;grid-column:3;font-size:.84rem}.cart-bottom{grid-template-columns:1fr;grid-template-areas:"summary" "note";gap:2.5rem;padding-top:2rem}.cart-summary{text-align:left}.cart-summary p{font-size:1.1rem}.cart-summary>a{display:block;text-align:center}.cart-bottom>.field{max-width:none}.cart-summary .button{min-height:48px}}
  .cart .button{color:var(--ivory)}.cart-summary .button--secondary{color:var(--coffee)}.cart-summary .button--secondary:hover{background:var(--coffee);color:var(--ivory)}
  @media(max-width:720px){.cart .button:active{background:transparent;color:var(--coffee);transform:scale(.985)}.cart-summary .button--secondary:active{background:var(--coffee);color:var(--ivory)}}
  .cart .cart-line{display:grid;grid-template-columns:130px minmax(0,1fr) 110px auto;gap:2rem;align-items:center;padding:1.5rem 0;margin:0;border-top:1px solid var(--line);border-bottom:0}.cart .cart-line img{display:block;width:130px;height:auto;aspect-ratio:3/4;object-fit:cover;object-position:center top}.cart .cart-line__info{display:grid;justify-items:start;gap:.3rem;min-width:0}.cart .cart-line__info>a:first-child{display:block;font-family:Georgia,serif;font-size:1.05rem;line-height:1.3}.cart .cart-remove{display:inline-block;margin-top:.2rem}.cart .cart-summary{display:grid;grid-template-columns:minmax(0,1fr);gap:.85rem;align-content:start;width:100%;text-align:right}.cart .cart-summary p,.cart .cart-summary small,.cart .cart-summary .button,.cart .cart-summary>a{position:static;inset:auto;width:100%;margin:0}.cart .cart-summary p{display:flex;justify-content:space-between;gap:2rem}.cart .cart-summary small{display:block}.cart .cart-summary>a{display:block;text-align:right}
  @media(max-width:720px){.cart .cart-line{grid-template-columns:88px minmax(0,1fr) auto;gap:.8rem 1rem;align-items:start;padding:1.15rem 0}.cart .cart-line>a{grid-row:1/3}.cart .cart-line img{width:88px}.cart .cart-line__info>a:first-child{font-size:.93rem;line-height:1.2}.cart .cart-quantity{grid-column:2}.cart .cart-line__price{grid-row:1;grid-column:3;font-size:.84rem}.cart .cart-summary{text-align:left}.cart .cart-summary>a{text-align:center}}
  .cart .cart-summary{display:flex;flex-direction:column;align-items:stretch;gap:.85rem}.cart .cart-summary>*{flex:0 0 auto}.cart .cart-summary .button{display:flex;position:static;width:100%;height:auto;min-height:48px;max-height:none;padding:.85rem 1.25rem;margin:0}.cart .cart-summary>a{position:static;margin:.25rem 0 0;background:transparent}.cart .cart-summary p,.cart .cart-summary small{position:static;margin:0}.cart .cart-summary p{order:0}.cart .cart-summary small{order:1}.cart .cart-summary .button--secondary{order:2}.cart .cart-summary [name=checkout]{order:3}.cart .cart-summary>a{order:4}
  @media(max-width:720px){.cart-bottom{padding-bottom:1rem}.cart .cart-summary{width:100%;padding:1.25rem;background:var(--ivory);border:1px solid var(--line)}.cart .cart-summary .button{min-height:50px}.cart .cart-summary>a{padding:.4rem 0}.cart-drawer__panel{width:100%;background:var(--ivory)}}
{% endstylesheet %}
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
