<section class="category-edit page-width">
  <div class="category-edit__head"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="display">{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
  <div class="category-edit__grid">
    {% for block in section.blocks %}<a class="category-tile category-tile--{{ forloop.index }}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><div class="category-tile__media">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | image_tag: widths: '500,800,1100,1400', sizes: '(min-width: 768px) 50vw, 100vw', loading: 'lazy', alt: block.settings.title }}{% else %}{{ 'collection-apparel-' | append: forloop.index | placeholder_svg_tag }}{% endif %}</div><div class="category-tile__caption"><span>{{ block.settings.kicker }}</span><h3>{{ block.settings.title }}</h3><em>Explore the edit</em></div></a>{% endfor %}
  </div>
</section>
{% stylesheet %}
  .category-edit{padding-block:clamp(6rem,10vw,10rem)}.category-edit__head{display:grid;grid-template-columns:1fr 1.4fr .8fr;gap:3rem;align-items:end;margin-bottom:clamp(2.5rem,5vw,5rem)}.category-edit__head .eyebrow{align-self:start}.category-edit__head .display{margin:0;font-size:clamp(3.3rem,6vw,6rem);max-width:8ch}.category-edit__head>p:last-child{max-width:32ch;margin:0}
  .category-edit__grid{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(1rem,2.5vw,2.5rem);align-items:start}.category-tile{position:relative;display:block;overflow:hidden;background:#ded5cc}.category-tile--2{margin-top:clamp(3rem,9vw,9rem)}.category-tile__media{aspect-ratio:4/5;overflow:hidden}.category-tile__media img,.category-tile__media svg{width:100%;height:100%;object-fit:cover;object-position:center top;transition:transform .9s var(--ease)}.category-tile:hover img{transform:scale(1.025)}
  .category-tile__caption{position:absolute;inset:auto 1rem 1rem;padding:1.25rem 1.4rem;color:#fff;background:rgba(38,26,34,.38);border:1px solid rgba(255,255,255,.28);box-shadow:inset 0 1px 0 rgba(255,255,255,.25);backdrop-filter:blur(15px) saturate(110%)}.category-tile__caption span,.category-tile__caption em{font-family:Arial,sans-serif;text-transform:uppercase;letter-spacing:.15em;font-size:.56rem;font-style:normal}.category-tile__caption h3{margin:.2rem 0 .4rem;font-family:Georgia,serif;font-size:clamp(2rem,4vw,4.2rem);font-weight:400;line-height:1}
  @media(max-width:767px){.category-edit__head{grid-template-columns:1fr;gap:1.3rem}.category-edit__head .display{max-width:10ch}.category-edit__grid{grid-template-columns:1fr}.category-tile--2{margin-top:0}.category-tile__caption{inset:auto .75rem .75rem}}
{% endstylesheet %}
{% schema %}
{"name":"Collection categories","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by mood"},{"type":"textarea","id":"heading","label":"Heading","default":"A wardrobe with presence."},{"type":"textarea","id":"text","label":"Text","default":"Statement colour, defined lines and pieces designed to hold a room."}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"kicker","label":"Kicker","default":"The occasion edit"},{"type":"text","id":"title","label":"Title","default":"Evening"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":2,"presets":[{"name":"Collection categories","blocks":[{"type":"category"},{"type":"category"}]}]}
{% endschema %}
