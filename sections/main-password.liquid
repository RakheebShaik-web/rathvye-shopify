<section class="launch-page" style="--launch-text: {{ section.settings.text_color }}; --launch-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="launch-page__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '600,900,1200,1600,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {% endif %}
  </div>
  <div class="launch-page__veil"></div>

  <header class="launch-page__header">
    <a class="launch-page__wordmark" href="{{ routes.root_url }}" aria-label="RATHVYE home">
      <span>RATHVYE</span>
      <small>Defined by style</small>
    </a>
    <details class="launch-entry">
      <summary><span aria-hidden="true">&#9671;</span> {{ 'password.enter' | t }}</summary>
      {% form 'storefront_password' %}
        <label for="StorePassword">Password</label>
        <div class="launch-entry__row">
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" required>
          <button type="submit">Enter</button>
        </div>
        {{ form.errors | default_errors }}
      {% endform %}
    </details>
  </header>

  <main class="launch-page__content">
    <p class="launch-page__edition">RATHVYE &middot; 2026</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="launch-page__lead">{{ section.settings.text }}</p>
    <p class="launch-page__note">{{ section.settings.note }}</p>
    {% form 'customer', class: 'launch-newsletter' %}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.email' | t }}</label>
      <input id="PasswordEmail" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required>
      <button type="submit">{{ 'newsletter.submit' | t }}</button>
      {% if form.posted_successfully? %}<p>{{ 'newsletter.success' | t }}</p>{% endif %}
      {{ form.errors | default_errors }}
    {% endform %}
  </main>

  <footer class="launch-page__footer">
    <span>&copy; 2026 RATHVYE</span>
    <span>Defined by style</span>
  </footer>
</section>

{% stylesheet %}
  .launch-page .visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .launch-page{position:relative;isolation:isolate;min-height:100svh;overflow:hidden;background:#151316;color:var(--launch-text)}
  .launch-page__media,.launch-page__veil{position:absolute;inset:0}
  .launch-page__media{z-index:-2}
  .launch-page__media img,.launch-page__media svg{width:100%;height:100%;object-fit:cover;object-position:center 24%;filter:grayscale(.48) blur(3px);transform:scale(1.025)}
  .launch-page__veil{z-index:-1;background:linear-gradient(rgba(13,12,14,var(--launch-overlay)),rgba(13,12,14,var(--launch-overlay))),radial-gradient(circle at 50% 42%,rgba(103,73,113,.08),rgba(5,5,6,.48) 78%)}
  .launch-page__header{position:absolute;z-index:3;inset:0 0 auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:start;padding:clamp(1.35rem,3vw,2.8rem) clamp(1.25rem,4vw,4.75rem)}
  .launch-page__wordmark{grid-column:2;color:inherit;text-align:center;text-decoration:none;font-family:Georgia,serif;font-size:clamp(.9rem,1.15vw,1.1rem);letter-spacing:.42em}
  .launch-page__wordmark small{display:block;margin-top:.48rem;font-family:Arial,sans-serif;font-size:.42rem;text-transform:uppercase;letter-spacing:.3em;opacity:.72}
  .launch-entry{grid-column:3;justify-self:end;text-align:right}
  .launch-entry summary{cursor:pointer;list-style:none;text-transform:uppercase;letter-spacing:.14em;font:600 .64rem/1.3 Arial,sans-serif}
  .launch-entry summary::-webkit-details-marker{display:none}
  .launch-entry summary span{margin-right:.45rem;font-size:.75rem}
  .launch-entry form{position:absolute;top:4.65rem;right:clamp(1.25rem,4vw,4.75rem);width:min(360px,calc(100vw - 2.5rem));padding:1.15rem;text-align:left;border:1px solid rgba(255,255,255,.25);background:rgba(22,18,23,.82);backdrop-filter:blur(18px)}
  .launch-entry label{display:block;margin-bottom:.55rem;text-transform:uppercase;letter-spacing:.13em;font:600 .58rem Arial,sans-serif}
  .launch-entry__row{display:grid;grid-template-columns:1fr auto}
  .launch-entry input{min-width:0;height:48px;padding:0 .9rem;border:1px solid rgba(255,255,255,.48);border-right:0;border-radius:0;background:rgba(255,255,255,.96);color:#211a20}
  .launch-entry button{min-width:86px;border:1px solid #c8b4d9;border-radius:0;background:#c8b4d9;color:#302136;text-transform:uppercase;letter-spacing:.12em;font-size:.62rem}
  .launch-page__content{width:min(720px,calc(100% - 2.5rem));min-height:100svh;margin:auto;padding:8.5rem 0 7rem;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
  .launch-page__edition{margin:0 0 1.4rem;text-transform:uppercase;letter-spacing:.32em;font:500 .58rem Arial,sans-serif;opacity:.76}
  .launch-page h1{margin:0 0 1.6rem;font-family:Georgia,serif;font-size:clamp(4rem,7vw,7rem);font-weight:400;line-height:.92;letter-spacing:-.045em;text-wrap:balance}
  .launch-page__lead{max-width:34ch;margin:0;font-family:Georgia,serif;font-size:clamp(1.15rem,1.8vw,1.55rem);line-height:1.4}
  .launch-page__note{margin:1rem 0 2.2rem;font-family:Georgia,serif;font-size:.92rem;font-style:italic;line-height:1.5;opacity:.7}
  .launch-newsletter{width:min(560px,100%);display:grid;grid-template-columns:1fr auto}
  .launch-newsletter input{min-width:0;min-height:58px;padding:0 1.25rem;border:1px solid rgba(255,255,255,.68);border-radius:0;background:rgba(255,255,255,.94);color:#211a20;font-family:Georgia,serif}
  .launch-newsletter button{min-width:142px;border:1px solid #171318;border-radius:0;background:#171318;color:#fff;text-transform:uppercase;letter-spacing:.15em;font:600 .64rem Arial,sans-serif}
  .launch-newsletter>p,.launch-newsletter>ul{grid-column:1/-1}
  .launch-page__footer{position:absolute;inset:auto 0 0;display:flex;justify-content:space-between;padding:1.35rem clamp(1.25rem,4vw,4.75rem);text-transform:uppercase;letter-spacing:.16em;font:500 .54rem Arial,sans-serif;opacity:.65}
  @media(max-width:640px){
    .launch-page__media img,.launch-page__media svg{object-position:58% center;filter:grayscale(.42) blur(2px);transform:scale(1.035)}
    .launch-page__header{display:flex;justify-content:space-between;padding:1.2rem}
    .launch-page__wordmark{text-align:left;font-size:.78rem;letter-spacing:.32em}
    .launch-entry summary{font-size:.55rem}
    .launch-entry form{top:4.25rem;right:1rem}
    .launch-page__content{width:min(100% - 2rem,540px);padding:7.5rem 0 6.5rem}
    .launch-page__edition{margin-bottom:1.1rem}
    .launch-page h1{max-width:5.5ch;margin-bottom:1.5rem;font-size:clamp(3.8rem,18vw,5.2rem);line-height:.88}
    .launch-page__lead{font-size:1.08rem}
    .launch-page__note{max-width:27ch;margin-bottom:1.8rem}
    .launch-newsletter{grid-template-columns:1fr}
    .launch-newsletter input,.launch-newsletter button{min-height:54px}
    .launch-page__footer{padding:1.15rem;gap:1rem}
  }
{% endstylesheet %}

{% schema %}
{"name":"Password page","settings":[{"type":"image_picker","id":"image","label":"Background image"},{"type":"textarea","id":"heading","label":"Heading","default":"Opening soon"},{"type":"textarea","id":"text","label":"Text","default":"Be the first to know when the first RATHVYE collection arrives."},{"type":"text","id":"note","label":"Signup note","default":"Private previews, launch access and first selection."},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"range","id":"overlay_opacity","label":"Image darkness","min":20,"max":85,"step":5,"unit":"%","default":60}]}
{% endschema %}
