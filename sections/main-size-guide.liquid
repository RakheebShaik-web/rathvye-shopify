<section class="size-guide page-width"><header><p>{{ section.settings.eyebrow }}</p><h1 class="display">{{ section.settings.heading }}</h1><p>{{ section.settings.intro }}</p></header><div class="size-guide__table" role="region" tabindex="0" aria-label="{{ section.settings.heading }}"><table><thead><tr><th>{{ 'size.size' | t }}</th><th>{{ 'size.bust' | t }}</th><th>{{ 'size.waist' | t }}</th><th>{{ 'size.hip' | t }}</th></tr></thead><tbody>{% for block in section.blocks %}<tr {{ block.shopify_attributes }}><th>{{ block.settings.size }}</th><td>{{ block.settings.bust }}</td><td>{{ block.settings.waist }}</td><td>{{ block.settings.hip }}</td></tr>{% endfor %}</tbody></table></div><div class="size-guide__notes"><article><h2>{{ 'size.measure' | t }}</h2><p>{{ section.settings.measurement_text }}</p></article><article><h2>{{ 'size.help' | t }}</h2><p>{{ section.settings.help_text }}</p><a href="/pages/contact">{{ 'size.contact' | t }}</a></article></div></section>
{% stylesheet %}.size-guide{padding-block:clamp(4rem,9vw,9rem)}.size-guide header{max-width:850px}.size-guide header>p:first-child{text-transform:uppercase;letter-spacing:.18em;font-size:.62rem}.size-guide .display{font-size:clamp(4rem,9vw,8rem);margin:.5rem 0 1.5rem}.size-guide__table{overflow:auto;margin:clamp(3rem,7vw,6rem) 0}.size-guide table{width:100%;min-width:620px;border-collapse:collapse}.size-guide th,.size-guide td{padding:1.2rem;text-align:left;border-bottom:1px solid var(--line);font-weight:400}.size-guide thead th{text-transform:uppercase;letter-spacing:.14em;font-size:.62rem}.size-guide tbody th{font-family:Georgia,serif;font-size:1.3rem}.size-guide__notes{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line)}.size-guide__notes article{padding:2rem;background:var(--ivory)}.size-guide__notes h2{font-family:Georgia,serif;font-size:1.8rem;font-weight:400}.size-guide__notes a{text-decoration:underline}@media(max-width:600px){.size-guide__notes{grid-template-columns:1fr}}{% endstylesheet %}
{% schema %}{"name":"Size guide","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Fit notes"},{"type":"text","id":"heading","label":"Heading","default":"Find your proportion."},{"type":"textarea","id":"intro","label":"Introduction","default":"Measurements below are placeholders until the final garment specifications are approved."},{"type":"textarea","id":"measurement_text","label":"Measurement guidance","default":"Measure close to the body over light clothing. Keep the tape level and comfortably fitted."},{"type":"textarea","id":"help_text","label":"Sizing help","default":"Share your measurements and the piece you are considering for personal guidance."}],"blocks":[{"type":"size","name":"Size","settings":[{"type":"text","id":"size","label":"Size","default":"XS"},{"type":"text","id":"bust","label":"Bust","default":"To be confirmed"},{"type":"text","id":"waist","label":"Waist","default":"To be confirmed"},{"type":"text","id":"hip","label":"Hip","default":"To be confirmed"}]}],"max_blocks":8,"presets":[{"name":"Size guide","blocks":[{"type":"size"},{"type":"size"},{"type":"size"},{"type":"size"},{"type":"size"}]}]}{% endschema %}
