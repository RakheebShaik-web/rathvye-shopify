<section class="recommendations page-width" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related">{% if recommendations.performed and recommendations.products_count > 0 %}<header><p>{{ section.settings.eyebrow }}</p><h2 class="display">{{ section.settings.heading }}</h2></header><div class="recommendations__grid">{% for recommended_product in recommendations.products %}{% render 'product-card', product: recommended_product %}{% endfor %}</div>{% endif %}</section>
{% stylesheet %}.recommendations{padding-block:clamp(5rem,10vw,10rem)}.recommendations:empty{display:none}.recommendations header{margin-bottom:2.5rem}.recommendations header p{text-transform:uppercase;letter-spacing:.18em;font-size:.64rem}.recommendations .display{font-size:clamp(3rem,7vw,6rem);margin:0}.recommendations__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}@media(max-width:899px){.recommendations__grid{grid-template-columns:repeat(2,1fr)}}{% endstylesheet %}
{% javascript %}document.querySelectorAll('[data-recommendations]').forEach(async section=>{if(!section.dataset.url)return;const response=await fetch(section.dataset.url);if(!response.ok)return;const html=document.createElement('div');html.innerHTML=await response.text();const fresh=html.querySelector('[data-recommendations]');if(fresh&&fresh.innerHTML.trim())section.innerHTML=fresh.innerHTML}){% endjavascript %}
{% schema %}{"name":"Product recommendations","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Complete the story"},{"type":"text","id":"heading","label":"Heading","default":"You may also like"},{"type":"range","id":"products_to_show","label":"Products","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Product recommendations"}]}{% endschema %}
