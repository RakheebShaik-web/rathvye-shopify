{% assign featured = collections[section.settings.collection] %}
<section class="sanro-hero" data-sanro-slider>
  {% for block in section.blocks %}{% if block.type == 'slide' %}{% assign model_index = forloop.index0 %}{% assign model_product = featured.products[model_index] %}{% assign model_image = model_product.featured_image %}<article class="sanro-slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }} style="{% if block.settings.image != blank %}--slide-image:url('{{ block.settings.image | image_url: width: 2000 }}');{% elsif model_image != blank %}--slide-image:url('{{ model_image | image_url: width: 2000 }}');{% endif %}{% if block.settings.mobile_image != blank %}--mobile-image:url('{{ block.settings.mobile_image | image_url: width: 900 }}');{% elsif model_image != blank %}--mobile-image:url('{{ model_image | image_url: width: 900 }}');{% endif %}"><div class="sanro-slide__copy"><h1>{{ block.settings.heading | newline_to_br }}</h1>{% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}<a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button }}</a></div></article>{% endif %}{% endfor %}
  <div class="sanro-dots">{% for block in section.blocks %}{% if block.type == 'slide' %}<button data-slide-dot="{{ forloop.index0 }}"{% if forloop.first %} class="is-active"{% endif %} aria-label="Slide {{ forloop.index }}"></button>{% endif %}{% endfor %}</div>
</section>
<section class="sanro-genders page-width">
  <a href="{{ section.settings.womens_link }}" style="--tile:url('{% if section.settings.dresses_image != blank %}{{ section.settings.dresses_image | image_url: width: 1200 }}{% elsif featured.products[1].featured_image != blank %}{{ featured.products[1].featured_image | image_url: width: 1200 }}{% endif %}')"><span><strong>Dresses</strong><u>Shop Now</u></span></a>
  <a href="/collections/co-ord-sets" style="--tile:url('{% if section.settings.womens_image != blank %}{{ section.settings.womens_image | image_url: width: 1200 }}{% elsif featured.products[2].featured_image != blank %}{{ featured.products[2].featured_image | image_url: width: 1200 }}{% else %}{{ featured.products.first.featured_image | image_url: width: 1200 }}{% endif %}')"><span><strong>Co-ords</strong><u>Shop Now</u></span></a>
</section>
{% if featured != blank %}<div class="look-heading-control" data-look-control><span class="look-counter"><b data-look-current>1</b><i></i><b>2</b></span><span class="look-label">SHOP THE LOOK</span><span class="look-arrows"><button type="button" data-look-prev aria-label="Previous look"><svg viewBox="0 0 28 18"><path d="M9 1 1 9l8 8M1 9h26"/></svg></button><button type="button" data-look-next aria-label="Next look"><svg viewBox="0 0 28 18"><path d="m19 1 8 8-8 8M27 9H1"/></svg></button></span></div>{% endif %}
{% if featured != blank %}{% assign look_product = featured.products.first %}<section class="sanro-products"><h2>SHOP THE LOOK</h2><div class="look-scene" style="--look-image:url('{% if section.settings.look_image != blank %}{{ section.settings.look_image | image_url: width: 2000 }}{% else %}{{ look_product.featured_image | image_url: width: 2000 }}{% endif %}')">{% for hotspot_product in featured.products limit: 3 %}<button class="look-hotspot look-hotspot--{{ forloop.index }}" type="button" aria-expanded="false" aria-label="Show {{ hotspot_product.title | escape }}">+</button><article class="look-popover look-popover--{{ forloop.index }}"><a href="{{ hotspot_product.url }}">{% if hotspot_product.featured_image %}{{ hotspot_product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: hotspot_product.title }}{% endif %}<div class="look-popover__meta"><h3>{{ hotspot_product.title }}</h3><p>{{ hotspot_product.price | money }}</p></div><span class="look-tools"><i>▢</i><i>♡</i><i>⇅</i><i>◉</i></span></a></article>{% endfor %}</div><div class="sanro-product-grid page-width">{% for product in featured.products limit: 4 %}{% render 'product-card', product: product %}{% endfor %}</div></section>{% endif %}
<button class="back-to-top" type="button" data-back-to-top aria-label="Back to top" onclick="window.scrollTo({top:0,left:0,behavior:'smooth'});return false"><svg viewBox="0 0 24 24"><path d="m5 11 7-7 7 7M12 4v16"/></svg></button>
{% stylesheet %}
