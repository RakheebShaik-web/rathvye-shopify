<section class="sanro-hero" data-sanro-slider>
  {% for block in section.blocks %}{% if block.type == 'slide' %}<article class="sanro-slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }} style="--slide-image:url('{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 2000 }}{% else %}{{ block.settings.remote_image }}{% endif %}');--mobile-image:url('{% if block.settings.mobile_image != blank %}{{ block.settings.mobile_image | image_url: width: 800 }}{% elsif block.settings.remote_mobile_image != blank %}{{ block.settings.remote_mobile_image }}{% else %}{{ block.settings.remote_image }}{% endif %}')"><div class="sanro-slide__copy"><h1>{{ block.settings.heading | newline_to_br }}</h1>{% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}<a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button }}</a></div></article>{% endif %}{% endfor %}
  <div class="sanro-dots">{% for block in section.blocks %}{% if block.type == 'slide' %}<button data-slide-dot="{{ forloop.index0 }}"{% if forloop.first %} class="is-active"{% endif %} aria-label="Slide {{ forloop.index }}"></button>{% endif %}{% endfor %}</div>
</section>
<section class="sanro-genders page-width">
  <a href="{{ section.settings.womens_link }}" style="--tile:url('{% if section.settings.mens_image != blank %}{{ section.settings.mens_image | image_url: width: 1000 }}{% else %}https://regal-sanro.myshopify.com/cdn/shop/files/slider1_39e9478a-2da5-424b-b6e4-54f6333883e2.webp?v=1729776097{% endif %}')"><span><strong>Dresses</strong><u>Shop Now</u></span></a>
  <a href="{{ section.settings.womens_link }}" style="--tile:url('{% if section.settings.womens_image != blank %}{{ section.settings.womens_image | image_url: width: 1000 }}{% else %}https://regal-sanro.myshopify.com/cdn/shop/files/slider2_f0fa6461-c4a4-46bd-ab1d-f31817fd2633.jpg?v=1729588368{% endif %}')"><span><strong>Woman's</strong><u>Shop Now</u></span></a>
</section>
{% assign featured = collections[section.settings.collection] %}{% if featured != blank %}{% assign look_product = featured.products.first %}<section class="sanro-products"><h2>SHOP THE LOOK</h2><div class="look-scene" style="--look-image:url('{% if section.settings.look_image != blank %}{{ section.settings.look_image | image_url: width: 2000 }}{% else %}https://regal-sanro.myshopify.com/cdn/shop/files/Main_2_6eae6bc5-4e8e-4f2f-bdfb-6865f58cf182_1728x.jpg?v=1729589950{% endif %}')"><button class="look-hotspot" type="button" aria-expanded="false" aria-label="Show featured product">+</button>{% if look_product %}<article class="look-popover"><a href="{{ look_product.url }}">{% if look_product.featured_image %}{{ look_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: look_product.title }}{% endif %}<h3>{{ look_product.title }}</h3><p>{{ look_product.price | money }}</p><span class="look-tools"><i>▢</i><i>♡</i><i>⇅</i><i>◉</i></span></a></article>{% endif %}</div><div class="sanro-product-grid page-width">{% for product in featured.products limit: 4 %}{% render 'product-card', product: product %}{% endfor %}</div></section>{% endif %}
<section class="sanro-banners page-width"><a href="/collections/womens"><strong>Casual Fits</strong><span>Effortlessly Cool, Every Day</span><u>Shop now</u></a><a href="/collections/womens"><strong>Denim</strong><span>Denim for Every Day, Every Way</span><u>Shop now</u></a><a href="/collections/all"><strong>Go Formal</strong><span>Suit Up for Success</span><u>Shop now</u></a></section>
{% stylesheet %}
.sanro-hero{position:relative;height:calc(100vh - 76px);min-height:620px;max-height:850px;background:#ddd;overflow:hidden}.sanro-slide{position:absolute;inset:0;background-image:linear-gradient(90deg,rgba(0,0,0,.16),transparent 58%),var(--slide-image);background-size:cover;background-position:center;opacity:0;visibility:hidden;transition:opacity .7s}.sanro-slide.is-active{opacity:1;visibility:visible}.sanro-slide__copy{position:absolute;left:max(30px,calc((100vw - 1440px)/2 + 24px));top:50%;transform:translateY(-43%);color:#fff}.sanro-slide h1{max-width:650px;margin:0 0 54px;font-size:clamp(48px,4.8vw,70px);line-height:1.08;font-weight:300;letter-spacing:0}.sanro-slide p{margin:-35px 0 40px}.sanro-slide a{display:inline-flex;height:42px;align-items:center;padding:0 40px;background:#000;color:#fff;font-size:16px;transition:background .25s,color .25s}.sanro-slide a:hover{background:#fff;color:#000}.sanro-dots{position:absolute;left:50%;bottom:40px;display:flex;gap:19px;transform:translateX(-50%)}.sanro-dots button{width:10px;height:10px;padding:0;border:1px solid #fff;border-radius:50%;background:transparent}.sanro-dots button.is-active{background:#fff}.sanro-genders{display:grid;grid-template-columns:1fr 1fr;gap:28px;padding-block:25px}.sanro-genders>a{position:relative;aspect-ratio:592/477;background:var(--tile) center/cover no-repeat;overflow:hidden}.sanro-genders>a:after{content:"";position:absolute;inset:0;background:#000;opacity:0;transition:opacity .35s}.sanro-genders>a:hover:after{opacity:.08}.sanro-genders span{position:absolute;left:18px;bottom:58px;z-index:1;display:grid;gap:12px}.sanro-genders strong{font-size:34px;font-weight:300}.sanro-genders u,.sanro-banners u{text-decoration:none;width:max-content;border-bottom:1px solid;padding-bottom:4px}.sanro-products{padding-block:72px}.sanro-products h2{text-align:center;font-size:16px;font-weight:500;letter-spacing:.12em}.sanro-product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:35px}.sanro-banners{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding-block:40px 80px}.sanro-banners a{display:flex;min-height:340px;flex-direction:column;justify-content:flex-end;padding:30px;background:#f2f2f2}.sanro-banners strong{font-size:31px;font-weight:300}.sanro-banners span{margin:8px 0 18px;color:#777}
@media(max-width:767px){.sanro-hero{height:805px;min-height:0;max-height:none;background:#fff}.sanro-slide{background-image:var(--mobile-image);background-size:100% 564px;background-position:center top;background-repeat:no-repeat;background-color:#fff}.sanro-slide__copy{left:18px;right:18px;top:594px;bottom:auto;transform:none;text-align:center;color:#000}.sanro-slide h1{max-width:330px;margin:0 auto 24px;font-size:30px;line-height:35px}.sanro-slide p{margin:0 0 22px}.sanro-slide a{height:40px;padding-inline:34px}.sanro-dots{bottom:18px}.sanro-dots button{border-color:#000}.sanro-dots button.is-active{background:#000}.sanro-genders{grid-template-columns:1fr;gap:15px;padding-block:15px}.sanro-genders span{bottom:28px}.sanro-genders strong{font-size:30px}.sanro-product-grid{grid-template-columns:repeat(2,1fr);gap:28px 12px}.sanro-banners{grid-template-columns:1fr}.sanro-products{padding-block:45px}}
{% endstylesheet %}
<style>
.look-scene{position:relative;min-height:clamp(520px,58vw,820px);margin:34px 0 70px;background:var(--look-image) center/cover no-repeat}.look-hotspot{position:absolute;left:65%;top:58%;z-index:4;display:grid;place-items:center;width:38px;height:38px;padding:0;border:0;border-radius:50%;background:#000;color:#fff;font-size:29px;font-weight:200;line-height:1;cursor:pointer;transition:transform .25s}.look-hotspot:hover{transform:scale(1.12)}.look-popover{position:absolute;left:50%;top:16%;z-index:3;width:310px;padding:14px 14px 26px;background:#fff;box-shadow:0 14px 40px rgba(0,0,0,.12);opacity:0;visibility:hidden;transform:translateY(12px);transition:opacity .3s,transform .35s,visibility .3s}.look-popover:after{content:"";position:absolute;right:0;bottom:-14px;border-width:14px 0 0 14px;border-style:solid;border-color:transparent transparent transparent #fff}.look-scene:hover .look-popover,.look-scene:focus-within .look-popover,.look-hotspot[aria-expanded=true]+.look-popover{opacity:1;visibility:visible;transform:none}.look-popover img{width:100%;aspect-ratio:4/5;object-fit:cover}.look-popover h3{margin:28px 0 5px;font-size:19px;font-weight:400}.look-popover p{margin:0;font-size:18px}.look-tools{position:absolute;left:50%;top:42%;display:flex;gap:8px;transform:translateX(-50%)}.look-tools i{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:#fff;color:#000;font-size:22px;font-style:normal;box-shadow:0 6px 18px rgba(0,0,0,.08)}
@media(max-width:767px){.look-scene{min-height:540px;margin-bottom:35px}.look-hotspot{left:72%;top:58%}.look-popover{left:15px;right:15px;top:45px;width:auto}.look-popover img{max-height:310px}.look-tools{top:250px}}
.look-scene:hover .look-popover,.look-scene:focus-within .look-popover{opacity:0;visibility:hidden;transform:translateY(12px)}.look-scene .look-hotspot[aria-expanded=true]+.look-popover{opacity:1;visibility:visible;transform:none}
</style>
<style>.sanro-genders>a{background-color:#f3f3f3;background-image:var(--tile);background-position:center;background-size:contain;background-repeat:no-repeat}.sanro-genders>a:hover:after{opacity:.05}.sanro-genders span{left:0;right:0;bottom:0;gap:8px;padding:17px 20px 19px;background:rgba(255,255,255,.92);backdrop-filter:blur(8px)}.sanro-genders strong{font-size:30px}@media(max-width:767px){.sanro-genders span{bottom:0;padding:14px 16px 16px}.sanro-genders strong{font-size:27px}}</style>
{% javascript %}
document.querySelectorAll('[data-sanro-slider]').forEach(slider=>{const slides=[...slider.querySelectorAll('[data-slide]')],dots=[...slider.querySelectorAll('[data-slide-dot]')];let current=0,timer;const show=i=>{current=(i+slides.length)%slides.length;slides.forEach((s,n)=>s.classList.toggle('is-active',n===current));dots.forEach((d,n)=>d.classList.toggle('is-active',n===current))};dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);clearInterval(timer);timer=setInterval(()=>show(current+1),6500)}));timer=setInterval(()=>show(current+1),6500)})
document.querySelectorAll('.look-hotspot').forEach(button=>button.addEventListener('click',event=>{event.stopPropagation();const open=button.getAttribute('aria-expanded')==='true';document.querySelectorAll('.look-hotspot[aria-expanded=true]').forEach(item=>item.setAttribute('aria-expanded','false'));button.setAttribute('aria-expanded',String(!open))}));document.addEventListener('click',()=>document.querySelectorAll('.look-hotspot[aria-expanded=true]').forEach(item=>item.setAttribute('aria-expanded','false')));document.addEventListener('keydown',event=>{if(event.key==='Escape')document.querySelectorAll('.look-hotspot[aria-expanded=true]').forEach(item=>item.setAttribute('aria-expanded','false'))})
{% endjavascript %}
{% schema %}{"name":"RATHVYE home","settings":[{"type":"collection","id":"collection","label":"Shop the look collection"},{"type":"image_picker","id":"look_image","label":"Shop the look background"},{"type":"image_picker","id":"mens_image","label":"Dresses image"},{"type":"image_picker","id":"womens_image","label":"Women's image"},{"type":"url","id":"womens_link","label":"Women's link"}],"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"text","id":"remote_image","label":"Approved desktop image URL"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"remote_mobile_image","label":"Approved mobile image URL"},{"type":"textarea","id":"heading","label":"Heading","default":"Smiley collection\nout now"},{"type":"text","id":"text","label":"Text"},{"type":"text","id":"button","label":"Button","default":"Shop now"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":3,"presets":[{"name":"RATHVYE home","blocks":[{"type":"slide"},{"type":"slide"},{"type":"slide"}]}]}{% endschema %}
