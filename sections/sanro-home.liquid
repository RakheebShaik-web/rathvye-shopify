{% javascript %}
document.querySelectorAll('[data-sanro-slider]').forEach(slider=>{const slides=[...slider.querySelectorAll('[data-slide]')],dots=[...slider.querySelectorAll('[data-slide-dot]')];let current=0,timer;const show=i=>{current=(i+slides.length)%slides.length;slides.forEach((s,n)=>s.classList.toggle('is-active',n===current));dots.forEach((d,n)=>d.classList.toggle('is-active',n===current))};dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);clearInterval(timer);timer=setInterval(()=>show(current+1),6500)}));timer=setInterval(()=>show(current+1),6500)})
document.querySelectorAll('.look-hotspot').forEach(button=>button.addEventListener('click',event=>{event.stopPropagation();const open=button.getAttribute('aria-expanded')==='true';document.querySelectorAll('.look-hotspot[aria-expanded=true]').forEach(item=>item.setAttribute('aria-expanded','false'));button.setAttribute('aria-expanded',String(!open))}));document.addEventListener('click',()=>document.querySelectorAll('.look-hotspot[aria-expanded=true]').forEach(item=>item.setAttribute('aria-expanded','false')));document.addEventListener('keydown',event=>{if(event.key==='Escape')document.querySelectorAll('.look-hotspot[aria-expanded=true]').forEach(item=>item.setAttribute('aria-expanded','false'))})
document.querySelectorAll('[data-look-control]').forEach(control=>{let page=1;const scene=control.nextElementSibling?.querySelector('.look-scene');const hotspots=[...(scene?.querySelectorAll('.look-hotspot')||[])];const update=next=>{page=next;control.querySelector('[data-look-current]').textContent=page;hotspots.forEach((hotspot,index)=>hotspot.setAttribute('aria-expanded',String(index===page-1)));scene?.scrollIntoView({behavior:'smooth',block:'center'})};control.querySelector('[data-look-prev]')?.addEventListener('click',()=>update(page===1?Math.min(2,hotspots.length):page-1));control.querySelector('[data-look-next]')?.addEventListener('click',()=>update(page>=Math.min(2,hotspots.length)?1:page+1))});
const syncBackToTop=()=>document.querySelectorAll('[data-back-to-top]').forEach(button=>button.classList.toggle('is-visible',window.scrollY>480));window.addEventListener('scroll',syncBackToTop,{passive:true});syncBackToTop();
const revealItems=document.querySelectorAll('.sanro-genders>a,.look-heading-control,.look-scene,.sanro-product-grid>.catalog-card');if('IntersectionObserver'in window&&!window.matchMedia('(prefers-reduced-motion: reduce)').matches){const revealObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-revealed');revealObserver.unobserve(entry.target)}}),{rootMargin:'0px 0px -8% 0px',threshold:.08});revealItems.forEach(item=>revealObserver.observe(item))}else{revealItems.forEach(item=>item.classList.add('is-revealed'))}
{% endjavascript %}
{% schema %}{"name":"RATHVYE home","settings":[{"type":"collection","id":"collection","label":"Shop the look collection"},{"type":"image_picker","id":"look_image","label":"Shop the look background (women only)"},{"type":"image_picker","id":"dresses_image","label":"Dresses image (women only)"},{"type":"image_picker","id":"womens_image","label":"Co-ords image"},{"type":"url","id":"womens_link","label":"Dresses link"}],"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"image_picker","id":"image","label":"Desktop image (women only)"},{"type":"image_picker","id":"mobile_image","label":"Mobile image (women only)"},{"type":"textarea","id":"heading","label":"Heading","default":"Smiley collection\nout now"},{"type":"text","id":"text","label":"Text"},{"type":"text","id":"button","label":"Button","default":"Shop now"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":3,"presets":[{"name":"RATHVYE home","blocks":[{"type":"slide"},{"type":"slide"},{"type":"slide"}]}]}{% endschema %}
