<section class="recently-viewed page-width" data-recent-section hidden>
  <header><p class="eyebrow">Your recent edit</p><h2 class="display">Recently viewed</h2></header>
  <div class="saved-products recently-viewed__grid" data-recent-grid data-current-handle="{{ product.handle }}"></div>
</section>
{% stylesheet %}
  .recently-viewed{padding-block:clamp(4rem,8vw,8rem);border-top:1px solid var(--line)}.recently-viewed header{margin-bottom:2.5rem}.recently-viewed .display{margin:0;font-size:clamp(3rem,7vw,6rem)}.recently-viewed__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2.75rem 1.25rem}.recently-viewed .saved-product{min-width:0}.recently-viewed .saved-product__media{aspect-ratio:3/4;overflow:hidden;background:var(--lilac)}.recently-viewed .saved-product__media img{width:100%;height:100%;object-fit:cover;object-position:center top;transition:transform .7s var(--ease)}.recently-viewed .saved-product:hover img{transform:scale(1.02)}.recently-viewed .saved-product__meta{padding-top:.8rem}.recently-viewed .saved-product__meta h3,.recently-viewed .saved-product__meta p{margin:0;font-size:.72rem;font-weight:400}.recently-viewed .saved-product__meta h3{text-transform:uppercase;letter-spacing:.07em}.recently-viewed .saved-product__meta p{margin-top:.25rem;font-variant-numeric:tabular-nums}@media(max-width:899px){.recently-viewed__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:2.25rem .75rem}}
{% endstylesheet %}
{% schema %}{"name":"Recently viewed","settings":[],"presets":[{"name":"Recently viewed"}]}{% endschema %}
