<section class="manifesto page-width" data-reveal>
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <div class="manifesto-grid"><h2 class="display">{{ section.settings.heading }}</h2><div><div class="manifesto-copy">{{ section.settings.text }}</div>{% if section.settings.link_label != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }} →</a>{% endif %}</div></div>
</section>
{% stylesheet %}
  .eyebrow{color:inherit}
  .manifesto{padding-block:clamp(6rem,12vw,12rem);opacity:0;transform:translateY(30px);transition:1s var(--ease)}.manifesto[data-visible=true]{opacity:1;transform:none}.manifesto-grid{display:grid;grid-template-columns:1.45fr .55fr;gap:8vw;align-items:end}.manifesto .display{font-size:clamp(3rem,7.5vw,8rem);margin:0;max-width:10ch}.manifesto-copy{font-family:Georgia,serif;font-size:clamp(1.15rem,2vw,1.65rem);line-height:1.45}.text-link{display:inline-block;margin-top:2rem;text-transform:uppercase;letter-spacing:.16em;font-size:.68rem;border-bottom:1px solid}
  @media(max-width:767px){.manifesto-grid{grid-template-columns:1fr;gap:2.5rem}}
{% endstylesheet %}
{% schema %}
{"name":"Brand manifesto","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The RATHVYE point of view"},{"type":"textarea","id":"heading","label":"Heading","default":"Clothes with presence, made for your own rhythm."},{"type":"richtext","id":"text","label":"Text","default":"<p>RATHVYE explores femininity through clean structure, expressive colour and refined detail. Each piece is designed to feel distinct without trying too hard.</p>"},{"type":"text","id":"link_label","label":"Link label","default":"Discover our story"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Brand manifesto"}]}
{% endschema %}
