<aside class="cart-drawer" data-cart-drawer aria-hidden="true" aria-labelledby="CartDrawerTitle">
  <button class="cart-drawer__overlay" type="button" data-cart-close aria-label="{{ 'accessibility.close' | t }}"></button>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true"><header><p id="CartDrawerTitle">{{ 'cart.title' | t }}</p><button type="button" data-cart-close aria-label="{{ 'accessibility.close' | t }}">×</button></header><div class="cart-drawer__items" data-cart-items></div><div class="cart-drawer__empty" data-cart-empty hidden><p>{{ 'cart.empty' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div><footer data-cart-footer><div><span>{{ 'cart.subtotal' | t }}</span><strong data-cart-total>{{ cart.total_price | money }}</strong></div><a class="button" href="{{ routes.cart_url }}">{{ 'cart.view_bag' | t }}</a><a class="button button--light" href="/checkout">{{ 'cart.checkout' | t }}</a><small>{{ 'cart.taxes_shipping' | t }}</small></footer></div>
</aside>
{% stylesheet %}.cart-drawer{position:fixed;inset:0;z-index:60;pointer-events:none;visibility:hidden}.cart-drawer[aria-hidden=false]{pointer-events:auto;visibility:visible}.cart-drawer__overlay{position:absolute;inset:0;width:100%;border:0;background:rgba(33,29,25,.38);opacity:0;transition:opacity .45s var(--ease);backdrop-filter:blur(3px)}.cart-drawer[aria-hidden=false] .cart-drawer__overlay{opacity:1}.cart-drawer__panel{position:absolute;right:0;top:0;bottom:0;width:min(440px,100%);display:grid;grid-template-rows:auto 1fr auto;background:var(--ivory);transform:translateX(100%);transition:transform .55s var(--ease);box-shadow:-24px 0 60px rgba(75,54,33,.15)}.cart-drawer[aria-hidden=false] .cart-drawer__panel{transform:none}.cart-drawer__panel>header{display:flex;justify-content:space-between;align-items:center;padding:1.4rem;border-bottom:1px solid var(--line);text-transform:uppercase;letter-spacing:.15em;font-size:.68rem}.cart-drawer__panel>header p{margin:0}.cart-drawer__panel>header button{border:0;background:transparent;font-size:1.5rem}.cart-drawer__items{overflow:auto;padding:1.4rem}.cart-line{display:grid;grid-template-columns:82px 1fr auto;gap:1rem;padding:0 0 1.3rem;margin-bottom:1.3rem;border-bottom:1px solid var(--line)}.cart-line img{width:82px;height:105px;object-fit:cover}.cart-line h3,.cart-line p{margin:0;font-size:.68rem;font-weight:400}.cart-line h3{text-transform:uppercase;letter-spacing:.07em}.cart-line small{display:block;margin:.3rem 0;color:color-mix(in srgb,var(--ink) 62%,transparent)}.cart-line__qty{display:flex;align-items:center;margin-top:.7rem}.cart-line__qty button{width:30px;height:30px;border:1px solid var(--line);background:transparent}.cart-line__qty span{min-width:34px;text-align:center;font-variant-numeric:tabular-nums}.cart-line__remove{border:0;background:transparent;align-self:start;text-decoration:underline;font-size:.62rem}.cart-drawer__empty{padding:3rem 1.4rem}.cart-drawer__empty a{text-decoration:underline}.cart-drawer__panel>footer{padding:1.4rem;border-top:1px solid var(--line)}.cart-drawer__panel>footer>div{display:flex;justify-content:space-between;margin-bottom:1rem}.cart-drawer__panel>footer .button{width:100%;margin-top:.55rem}.cart-drawer__panel>footer small{display:block;margin-top:.8rem;text-align:center;font-size:.58rem}.cart-loading{opacity:.5;pointer-events:none}{% endstylesheet %}
{% schema %}{"name":"Cart drawer","settings":[]}{% endschema %}
