{% assign shipping_threshold = section.settings.free_shipping_threshold | times: 100 %}
<aside class="cart-drawer" data-cart-drawer aria-hidden="true" aria-labelledby="CartDrawerTitle">
  <button class="cart-drawer__overlay" type="button" data-cart-close aria-label="{{ 'accessibility.close' | t }}"></button>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true">
    <header><p id="CartDrawerTitle">{{ 'cart.title' | t }}</p><button type="button" data-cart-close aria-label="{{ 'accessibility.close' | t }}">×</button></header>
    <div class="shipping-progress" data-shipping-progress data-threshold="{{ shipping_threshold }}" role="status" aria-live="polite">
      <div class="shipping-progress__copy"><span data-shipping-message>{% if cart.total_price >= shipping_threshold %}You've unlocked Complimentary Express Delivery{% else %}{{ shipping_threshold | minus: cart.total_price | money }} away from complimentary delivery{% endif %}</span><span data-shipping-value>{% if shipping_threshold > 0 %}{{ cart.total_price | times: 100 | divided_by: shipping_threshold | at_most: 100 }}%{% endif %}</span></div>
      <div class="shipping-progress__track" aria-hidden="true"><span data-shipping-bar style="width:{% if shipping_threshold > 0 %}{{ cart.total_price | times: 100 | divided_by: shipping_threshold | at_most: 100 }}{% else %}100{% endif %}%"></span></div>
    </div>
    <div class="cart-drawer__items" data-cart-items></div>
    <div class="cart-drawer__empty" data-cart-empty hidden><p>{{ 'cart.empty' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div>
    <footer data-cart-footer><div><span>{{ 'cart.subtotal' | t }}</span><strong data-cart-total>{{ cart.total_price | money }}</strong></div><a class="button" href="{{ routes.cart_url }}">{{ 'cart.view_bag' | t }}</a><a class="button button--light" href="/checkout">{{ 'cart.checkout' | t }}</a><small>{{ 'cart.taxes_shipping' | t }}</small></footer>
  </div>
</aside>
{% stylesheet %}
.cart-drawer{position:fixed;inset:0;z-index:60;pointer-events:none;visibility:hidden}.cart-drawer[aria-hidden=false]{pointer-events:auto;visibility:visible}.cart-drawer__overlay{position:absolute;inset:0;width:100%;border:0;background:rgba(33,29,25,.38);opacity:0;transition:opacity .45s var(--ease);backdrop-filter:blur(3px)}.cart-drawer[aria-hidden=false] .cart-drawer__overlay{opacity:1}.cart-drawer__panel{position:absolute;right:0;top:0;bottom:0;width:min(440px,100%);display:grid;grid-template-rows:auto auto 1fr auto;background:var(--ivory);transform:translateX(100%);transition:transform .55s var(--ease);box-shadow:-24px 0 60px rgba(75,54,33,.15)}.cart-drawer[aria-hidden=false] .cart-drawer__panel{transform:none}.cart-drawer__panel>header{display:flex;justify-content:space-between;align-items:center;padding:1.4rem;border-bottom:1px solid var(--line);text-transform:uppercase;letter-spacing:.15em;font-size:.68rem}.cart-drawer__panel>header p{margin:0}.cart-drawer__panel>header button{border:0;background:transparent;font-size:1.5rem;cursor:pointer}.shipping-progress{padding:1rem 1.4rem;border-bottom:1px solid var(--line)}.shipping-progress__copy{display:flex;justify-content:space-between;gap:1rem;margin-bottom:.65rem;font-size:.58rem;text-transform:uppercase;letter-spacing:.08em}.shipping-progress__copy span:first-child{max-width:31ch}.shipping-progress__track{height:3px;overflow:hidden;background:color-mix(in srgb,var(--coffee) 12%,transparent)}.shipping-progress__track span{display:block;height:100%;background:var(--coffee);transition:width .65s var(--ease)}.shipping-progress[data-complete=true] .shipping-progress__copy span:first-child{font-weight:600}.cart-drawer__items{overflow:auto;padding:1.4rem}.cart-line{display:grid;grid-template-columns:82px 1fr auto;gap:1rem;padding:0 0 1.3rem;margin-bottom:1.3rem;border-bottom:1px solid var(--line)}.cart-line img{width:82px;height:105px;object-fit:cover}.cart-line h3,.cart-line p{margin:0;font-size:.68rem;font-weight:400}.cart-line h3{text-transform:uppercase;letter-spacing:.07em}.cart-line small{display:block;margin:.3rem 0;color:color-mix(in srgb,var(--ink) 62%,transparent)}.cart-line__qty{display:flex;align-items:center;margin-top:.7rem}.cart-line__qty button{width:30px;height:30px;border:1px solid var(--line);background:transparent}.cart-line__qty span{min-width:34px;text-align:center;font-variant-numeric:tabular-nums}.cart-line__remove{border:0;background:transparent;align-self:start;text-decoration:underline;font-size:.62rem}.cart-drawer__empty{padding:3rem 1.4rem}.cart-drawer__empty a{text-decoration:underline}.cart-drawer__panel>footer{padding:1.4rem;border-top:1px solid var(--line)}.cart-drawer__panel>footer>div{display:flex;justify-content:space-between;margin-bottom:1rem}.cart-drawer__panel>footer .button{width:100%;margin-top:.55rem}.cart-drawer__panel>footer small{display:block;margin-top:.8rem;text-align:center;font-size:.58rem}.cart-loading{opacity:.5;pointer-events:none}@media(max-width:480px){.shipping-progress{padding:.9rem 1rem}.cart-line{grid-template-columns:72px 1fr}.cart-line img{width:72px;height:92px}.cart-line__remove{grid-column:2;justify-self:start}}
{% endstylesheet %}
<style>.cart-drawer__overlay{background:rgba(33,29,25,.3);backdrop-filter:blur(12px) saturate(108%)}.cart-drawer__panel{background:color-mix(in srgb,var(--ivory) 94%,transparent);border-left:1px solid rgba(255,255,255,.55);backdrop-filter:blur(22px) saturate(112%)}</style>
{% schema %}{"name":"Cart drawer","settings":[{"type":"range","id":"free_shipping_threshold","label":"Complimentary shipping threshold","min":500,"max":9900,"step":100,"unit":"₹","default":2000}]}{% endschema %}
