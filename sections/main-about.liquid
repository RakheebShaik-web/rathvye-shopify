<section class="about page-width"><header><p>{{ section.settings.eyebrow }}</p><h1 class="display">{{ section.settings.heading }}</h1></header><div class="about-copy"><p class="about-lead">{{ section.settings.lead }}</p><div>{{ section.settings.body }}</div></div>{% if section.settings.image != blank %}<div class="about-image">{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '600,900,1200,1800', loading: 'lazy', alt: section.settings.image.alt }}</div>{% endif %}<div class="about-values">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span>0{{ forloop.index }}</span><h2>{{ block.settings.heading }}</h2><p>{{ block.settings.text }}</p></article>{% endfor %}</div></section>
{% stylesheet %}.about{padding-block:clamp(4rem,9vw,9rem)}.about>header{display:grid;grid-template-columns:.35fr 1fr;gap:2rem;align-items:start}.about>header>p{text-transform:uppercase;letter-spacing:.18em;font-size:.62rem}.about .display{max-width:10ch;font-size:clamp(4rem,10vw,9rem);line-height:.85;margin:0}.about-copy{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,8vw,8rem);margin:clamp(4rem,8vw,8rem) 0}.about-lead{font-family:Georgia,serif;font-size:clamp(1.6rem,3vw,2.8rem);line-height:1.2;margin:0}.about-image{height:min(70vw,850px);overflow:hidden}.about-image img{width:100%;height:100%;object-fit:cover}.about-values{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);margin-top:clamp(4rem,8vw,7rem)}.about-values article{background:var(--ivory);padding:2rem}.about-values span{font-family:Georgia,serif;font-size:2rem}.about-values h2{margin:3rem 0 1rem;font-family:Georgia,serif;font-size:1.8rem;font-weight:400}.about-values p{max-width:35ch}@media(max-width:767px){.about>header,.about-copy{grid-template-columns:1fr}.about-values{grid-template-columns:1fr}.about-values h2{margin-top:1.5rem}}{% endstylesheet %}
{% schema %}{"name":"About RATHVYE","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The house"},{"type":"text","id":"heading","label":"Heading","default":"Made to be remembered."},{"type":"textarea","id":"lead","label":"Lead","default":"RATHVYE creates considered silhouettes for people who dress with intention."},{"type":"richtext","id":"body","label":"Story","default":"<p>Each collection begins with proportion, movement and detail. Add the founder's approved story here when it is ready.</p>"},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"value","name":"Value","settings":[{"type":"text","id":"heading","label":"Heading","default":"Considered form"},{"type":"textarea","id":"text","label":"Text","default":"Pieces shaped around proportion, presence and ease."}]}],"max_blocks":3,"presets":[{"name":"About RATHVYE","blocks":[{"type":"value"},{"type":"value"},{"type":"value"}]}]}{% endschema %}
