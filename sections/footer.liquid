<footer class="footer"><div class="footer-grid page-width"><div><h2>CONTACT US</h2>{% if section.settings.address != blank %}<p>{{ section.settings.address }}</p>{% endif %}{% if section.settings.phone != blank %}<p>Tel: {{ section.settings.phone }}</p>{% endif %}{% if section.settings.email != blank %}<p>Email: {{ section.settings.email }}</p>{% endif %}</div><div><h2>CATEGORIES</h2><a href="/collections/new-arrivals">The New Edit</a><a href="/collections/dresses">Dresses</a><a href="/collections/occasionwear">Occasion Edit</a><a href="/collections/co-ord-sets">Co-ord Sets</a></div><div><h2>SERVICES</h2><a href="/collections/occasionwear">After Dark</a><a href="/pages/faq">Quick Ship</a><a href="/pages/size-guide">Size Guide</a><a href="/pages/contact">Contact</a></div><div><h2>JOIN US</h2>{% form 'customer',class:'footer-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="FooterEmail" class="visually-hidden">Email address</label><input id="FooterEmail" type="email" name="contact[email]" placeholder="Your email" required><button aria-label="Subscribe">&rarr;</button>{% endform %}<p>New subscribers receive 10% off their first purchase</p><div class="footer-social">{% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}">Facebook</a>{% endif %}<a class="instagram-button" href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/_rathvye_?igsh=MWh5Z2l5eWdtandwbw%3D%3D&igsi=MWh5Z2l5eWdtandwbw%3D%3D' }}" target="_blank" rel="noopener" aria-label="Follow RATHVYE on Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg><span>Instagram</span></a></div></div></div><div class="footer-bottom page-width">&copy;{{ 'now' | date:'%Y' }} {{ shop.name }}</div></footer>
{% stylesheet %}.footer{padding:70px 0 22px;background:#f7f7f7;color:#555}.footer-grid{display:grid;grid-template-columns:1.2fr .8fr .9fr 1.2fr;gap:60px}.footer h2{margin:0 0 22px;color:#000;font-size:16px;font-weight:600;letter-spacing:.05em}.footer p{margin:7px 0;font-size:14px}.footer a{display:block;margin:9px 0;font-size:14px;transition:color .2s}.footer a:hover{color:#000}.footer-form{display:grid;grid-template-columns:1fr auto;border-bottom:1px solid #999}.footer-form input,.footer-form button{border:0;background:none;padding:10px 0}.footer-form button{font-size:20px}.footer-social{display:flex;align-items:center;gap:18px}.footer-social a{font-size:12px;text-transform:uppercase;letter-spacing:.08em}.footer-social .instagram-button{display:inline-flex;align-items:center;gap:8px;width:max-content;padding:9px 14px;border:1px solid #bbb;border-radius:999px;transition:background .25s,color .25s,border-color .25s,transform .25s}.instagram-button svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.6}.footer-social .instagram-button:hover{border-color:#000;background:#000;color:#fff;transform:translateY(-2px)}.footer-bottom{margin-top:55px;padding-top:20px;border-top:1px solid #ddd;font-size:13px}@media(max-width:767px){.footer{padding-top:48px}.footer-grid{grid-template-columns:1fr 1fr;gap:38px 20px}.footer-grid>div:first-child,.footer-grid>div:last-child{grid-column:1/-1}.footer-social .instagram-button{min-height:44px;padding-inline:16px}}{% endstylesheet %}
{% schema %}{"name":"Footer","settings":[{"type":"text","id":"address","label":"Address"},{"type":"text","id":"phone","label":"Phone"},{"type":"text","id":"email","label":"Email"},{"type":"url","id":"facebook_url","label":"Facebook URL"},{"type":"url","id":"instagram_url","label":"Instagram URL"}]}{% endschema %}


