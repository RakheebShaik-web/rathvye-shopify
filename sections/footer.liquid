<footer class="footer">
  <div class="footer-grid page-width">
    <div><p class="footer-mark">RATHVYE</p><p class="footer-tag">{{ section.settings.tagline }}</p></div>
    {% for block in section.blocks %}<div {{ block.shopify_attributes }}><p class="footer-title">{{ block.settings.heading }}</p>{% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div>{% endfor %}
    <div class="footer-services"><p class="footer-title">{{ 'footer.client_services' | t }}</p><a href="/pages/about">{{ 'footer.about' | t }}</a><a href="/pages/size-guide">{{ 'footer.size_guide' | t }}</a><a href="/pages/faq">{{ 'footer.faq' | t }}</a><a href="/pages/contact">{{ 'footer.contact' | t }}</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{{ 'footer.orders' | t }}</a>{% endif %}</div>
    <div><p class="footer-title">{{ section.settings.newsletter_heading }}</p>{% form 'customer', class: 'footer-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="FooterEmail">{{ 'newsletter.email' | t }}</label><input id="FooterEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required><button type="submit" aria-label="{{ 'newsletter.submit' | t }}">→</button>{% if form.posted_successfully? %}<p>{{ 'newsletter.success' | t }}</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</div>
  </div>
  <div class="footer-policies page-width">
    {% if shop.privacy_policy %}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{% endif %}
    {% if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{% endif %}
    {% if shop.shipping_policy %}<a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{% endif %}
    {% if shop.terms_of_service %}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>{% endif %}
  </div>
  <div class="footer-bottom page-width"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span><span>{{ section.settings.location }}</span></div>
</footer>
{% stylesheet %}
  .visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .footer{background:var(--coffee);color:var(--ivory);padding:5rem 0 1.5rem}.footer-grid{display:grid;grid-template-columns:1.5fr repeat(3,1fr);gap:4rem}.footer-mark{font-family:Georgia,serif;font-size:2rem;letter-spacing:.34em;margin:0}.footer-tag{max-width:22ch;color:color-mix(in srgb,var(--ivory) 70%,transparent)}.footer-title{text-transform:uppercase;letter-spacing:.17em;font-size:.68rem;margin:0 0 1.25rem}.footer-grid a{display:block;margin:.55rem 0;color:color-mix(in srgb,var(--ivory) 75%,transparent)}.footer-form{display:grid;grid-template-columns:1fr auto;border-bottom:1px solid color-mix(in srgb,var(--ivory) 45%,transparent)}.footer-form input{border:0;background:transparent;color:var(--ivory);padding:.75rem 0;min-width:0}.footer-form input::placeholder{color:color-mix(in srgb,var(--ivory) 55%,transparent)}.footer-form button{border:0;background:transparent;color:var(--ivory);font-size:1.2rem}.footer-form p,.footer-form ul{grid-column:1/-1}.footer-policies{display:flex;flex-wrap:wrap;gap:.75rem 1.5rem;margin-top:4rem}.footer-policies:empty{display:none}.footer-policies a{text-transform:uppercase;letter-spacing:.12em;font-size:.58rem;color:color-mix(in srgb,var(--ivory) 68%,transparent)}.footer-bottom{display:flex;justify-content:space-between;border-top:1px solid color-mix(in srgb,var(--ivory) 18%,transparent);margin-top:1.5rem;padding-top:1.5rem;text-transform:uppercase;letter-spacing:.13em;font-size:.58rem}
  @media(max-width:767px){.footer-grid{grid-template-columns:1fr 1fr;gap:3rem 1.5rem}.footer-grid>div:first-child,.footer-grid>div:last-child{grid-column:1/-1}.footer-bottom{gap:1rem;flex-direction:column}}
{% endstylesheet %}
{% schema %}
{"name":"Footer","settings":[{"type":"text","id":"tagline","label":"Tagline","default":"Thoughtful silhouettes for memorable entrances."},{"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"Private list"},{"type":"text","id":"location","label":"Location","default":"Designed in India"}],"blocks":[{"type":"menu","name":"Menu","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore"},{"type":"link_list","id":"menu","label":"Menu"}]}],"max_blocks":2}
{% endschema %}
