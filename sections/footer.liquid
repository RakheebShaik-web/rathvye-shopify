<footer class="footer"><div class="footer-grid page-width"><div><h2>CONTACT US</h2><p>{{ section.settings.address }}</p><p>Tell : {{ section.settings.phone }}</p><p>Email : {{ section.settings.email }}</p></div><div><h2>CATEGORIES</h2><a href="/collections/new-arrivals">New Designs</a><a href="/collections/mens">Men's</a><a href="/collections/on-sale">On Sale</a><a href="/collections/womens">Women's</a></div><div><h2>SERVICES</h2><a href="/collections/on-sale">Sale</a><a href="/pages/faq">Quick Ship</a><a href="/pages/size-guide">Size Guide</a><a href="/pages/contact">Contact</a></div><div><h2>JOIN US</h2>{% form 'customer',class:'footer-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="Your email" required><button aria-label="Subscribe">→</button>{% endform %}<p>New subscribers receive 10% off their first purchase</p><div class="footer-social"><a href="#">Facebook</a><a href="#">Instagram</a></div></div></div><div class="footer-bottom page-width">©{{ 'now' | date:'%Y' }} {{ shop.name }}</div></footer>
{% stylesheet %}.footer{padding:70px 0 22px;background:#f7f7f7;color:#555}.footer-grid{display:grid;grid-template-columns:1.2fr .8fr .9fr 1.2fr;gap:60px}.footer h2{margin:0 0 22px;color:#000;font-size:16px;font-weight:600;letter-spacing:.05em}.footer p{margin:7px 0;font-size:14px}.footer a{display:block;margin:9px 0;font-size:14px;transition:color .2s}.footer a:hover{color:#000}.footer-form{display:grid;grid-template-columns:1fr auto;border-bottom:1px solid #999}.footer-form input,.footer-form button{border:0;background:none;padding:10px 0}.footer-form button{font-size:20px}.footer-social{display:flex;gap:18px}.footer-social a{font-size:12px;text-transform:uppercase;letter-spacing:.08em}.footer-bottom{margin-top:55px;padding-top:20px;border-top:1px solid #ddd;font-size:13px}@media(max-width:767px){.footer{padding-top:48px}.footer-grid{grid-template-columns:1fr 1fr;gap:38px 20px}.footer-grid>div:first-child,.footer-grid>div:last-child{grid-column:1/-1}}{% endstylesheet %}
{% schema %}{"name":"Footer","settings":[{"type":"text","id":"address","label":"Address","default":"4 Copley Place, 7th Floor, Boston, MA"},{"type":"text","id":"phone","label":"Phone","default":"866.453.4748"},{"type":"text","id":"email","label":"Email","default":"sales@example.com"}]}{% endschema %}
